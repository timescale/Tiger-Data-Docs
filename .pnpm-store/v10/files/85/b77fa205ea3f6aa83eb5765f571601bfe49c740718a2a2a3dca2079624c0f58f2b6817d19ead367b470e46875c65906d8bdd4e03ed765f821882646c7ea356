---
import config from 'virtual:starlight/user-config';

import { HEADER_LAYOUT } from 'virtual:stl-docs-virtual-module';
import DefaultHeader from './headers/DefaultHeader.astro';
import StackedHeader from './headers/StackedHeader.astro';

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch = !!(
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro'
);
---

{
  HEADER_LAYOUT === 'stacked' ? (
    <StackedHeader shouldRenderSearch={shouldRenderSearch} />
  ) : (
    <DefaultHeader shouldRenderSearch={shouldRenderSearch} />
  )
}

<style is:global>
  @layer starlight.core {
    header,
    header.header {
      border-color: var(--stl-color-border-faint);
    }

    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
      width: 100%;
    }
    .title-wrapper {
      /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
      overflow: clip;
      /* Avoid clipping focus ring around link inside title wrapper. */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      /* Max height should match button height */
      max-height: 32px;
    }

    .default-tabs-container {
      justify-content: flex-end;
    }

    .split-tabs-container {
      display: flex;
      max-width: 480px;
      flex: 1;

      button {
        max-width: unset;
        width: 100%;
        flex: 1;
      }
    }

    .left-group {
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      flex-shrink: 0;
    }

    .right-group,
    .social-icons {
      gap: var(--sl-nav-gap);
      align-items: center;
    }

    .right-group > div {
      gap: var(--sl-nav-gap);
    }

    @media (min-width: 50rem) {
      .default-tabs-container {
        min-width: 540px;
      }
    }
  }
</style>
