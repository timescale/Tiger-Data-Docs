---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import HeaderLinks from './HeaderLinks.astro';
import { TABS } from 'virtual:stl-docs-virtual-module';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import SecondaryNavTabs from '../nav-tabs/SecondaryNavTabs.astro';
import SplashMobileMenuToggle from './SplashMobileMenuToggle.astro';

interface Props {
  shouldRenderSearch?: boolean;
}

const { shouldRenderSearch } = Astro.props;
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="header my-header">
  <div class="left-group">
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>
  </div>

  <div class="stl-top-container">
    {shouldRenderSearch && <Search />}
    {!hasSidebar && <SplashMobileMenuToggle />}
  </div>

  <div class={`sl-hidden md:sl-flex print:hidden right-group`}>
    <ThemeSelect />
    <HeaderLinks />
    <LanguageSelect />
  </div>
</div>

<SecondaryNavTabs />

<style is:inline>
  .stl-top-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: end;
    gap: 0.5rem;
    width: 100%;
  }
  @media (min-width: 50rem) {
    :root {
      --sl-nav-height: 88px;
    }

    header.header {
      display: flex;
      flex-direction: column;
      gap: 0.29rem;
      padding-bottom: 0;
    }

    .stl-top-container {
      justify-content: center;
    }
  }
</style>

{
  TABS.length === 0 && (
    <style
      is:inline
      set:text={`
        @media (min-width: 50rem) {
          :root {
            --sl-nav-height: 56px;
          }
        }
      `}
    />
  )
}
