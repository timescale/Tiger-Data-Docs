---
import { Button } from '@stainless-api/ui-primitives';
import { buildNavLinks } from './buildNavLinks';
import clsx from 'clsx';

const navLinks = buildNavLinks(Astro.locals.starlightRoute);
---

<div class="stl-secondary-nav-tabs">
  <ul>
    {
      navLinks.map((item) => (
        <li class:list={[item.active && 'active']}>
          <Button
            href={item.link}
            variant="ghost"
            className={clsx(item.active && 'stl-active-secondary-link')}
          >
            <Button.Label>{item.label}</Button.Label>
          </Button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .stl-secondary-nav-tabs {
    display: none;
    width: 100%;

    ul {
      display: flex;
      align-items: center;
      padding: 0;
      list-style: none;
      margin-bottom: -1px;
    }

    li {
      padding-bottom: 1px;
      border-bottom: 2px solid transparent;

      &.active {
        border-color: var(--stl-color-accent-border-strong);
      }

      .stl-ui-button {
        /* match sidebar. TODO: hoist sidebar variables to use those instead of hardcoding? */
        border-width: 0;
        padding: 8px 12px;
        margin-inline: -12px;
      }
      /* cover for button’s negative margin */
      &:not(:first-child) {
        margin-inline-start: 12px;
      }
      &:not(:last-child) {
        margin-inline-end: 12px;
      }
    }
  }

  @media (min-width: 50rem) {
    .stl-secondary-nav-tabs {
      display: block;
    }
  }
</style>
