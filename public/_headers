# Cache headers for self-hosted deploys (Stainless recommendation)
# Used by Netlify and Cloudflare Pages. See also vercel.json for Vercel.
#
# _astro assets are versioned (content-hashed), so they can be cached long-term.
# HTML and other root files use a shorter TTL so content updates propagate.

/_astro/*
  Cache-Control: public, max-age=604800, immutable

/*
  Cache-Control: public, max-age=3600
