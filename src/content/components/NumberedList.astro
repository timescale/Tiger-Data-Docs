---
/**
 * NumberedList – a numbered list where each item has a bold title and optional body.
 *
 * Renders an <ol>; each child should be a <NumberedItem title="...">...</NumberedItem>.
 * Use for step-by-step or checklist-style content with a short bold label per step.
 *
 * Usage:
 *   <NumberedList>
 *     <NumberedItem title="Start your AI assistant">(e.g. `claude`). It will start...</NumberedItem>
 *     <NumberedItem title="Confirm MCP is active">Ask: *"Is the Tiger Data MCP server active?"* ...</NumberedItem>
 *   </NumberedList>
 */
---

<ol class="numbered-list">
  <slot />
</ol>

<style>
  .numbered-list {
    list-style: none;
    padding-left: 0;
    margin: 1.25rem 0;
    counter-reset: step;
  }

  .numbered-list__item {
    counter-increment: step;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    background: light-dark(#f8fafc, #1e293b);
    border: 1px solid light-dark(#e2e8f0, #334155);
  }

  .numbered-list__item:last-child {
    margin-bottom: 0;
  }

  .numbered-list__item::before {
    content: counter(step);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: light-dark(#6446fb, #a78bfa);
    color: light-dark(#ffffff, #1e1b4b);
    font-weight: 700;
    font-size: 0.875rem;
    line-height: 1;
  }

  .numbered-list__item-content {
    flex: 1;
    min-width: 0;
  }

  .numbered-list__item-title {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    color: light-dark(#111827, #f9fafb);
    margin-bottom: 0.25rem;
  }

  .numbered-list__item-body {
    font-weight: normal;
    font-size: 0.9375rem;
    color: light-dark(#475569, #cbd5e1);
  }

  .numbered-list__item-body :global(p:first-child) {
    display: inline;
    margin: 0;
  }

  .numbered-list__item-body :global(p:first-child::after) {
    content: " ";
  }

  .numbered-list__item-body :global(p) {
    margin: 0.25rem 0 0 0;
  }

  .numbered-list__item-body :global(p + p) {
    margin-top: 0.25rem;
  }
</style>
