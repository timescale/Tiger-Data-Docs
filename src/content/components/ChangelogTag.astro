---
/**
 * ChangelogTag Component
 * 
 * A visual tag/badge to categorize changelog entries by type.
 * 
 * Usage:
 * <ChangelogTag type="new-feature" />
 * <ChangelogTag type="improvement" />
 * 
 * Available types:
 * - new-feature: Brand new capabilities
 * - improvement: Quality of life improvements  
 * - performance: Speed/efficiency improvements
 * - security: Security-related updates
 * - integration: Third-party integrations, connectors
 * - region: New regions, platforms, availability
 * - deprecation: Sunset notices, deprecations
 * - bug-fix: Fixes to existing functionality
 * - breaking-change: Changes requiring user action
 * - beta: Beta/preview releases
 * - ga: General availability releases
 */

interface Props {
  type: 
    | 'new-feature'
    | 'improvement' 
    | 'performance'
    | 'security'
    | 'integration'
    | 'region'
    | 'deprecation'
    | 'bug-fix'
    | 'breaking-change'
    | 'beta'
    | 'ga';
}

const { type } = Astro.props;

const tagConfig: Record<string, { label: string; icon: string; className: string }> = {
  'new-feature': {
    label: 'New Feature',
    icon: '✨',
    className: 'changelog-tag--new-feature',
  },
  'improvement': {
    label: 'Improvement',
    icon: '💡',
    className: 'changelog-tag--improvement',
  },
  'performance': {
    label: 'Performance',
    icon: '🏎️',
    className: 'changelog-tag--performance',
  },
  'security': {
    label: 'Security',
    icon: '🔐',
    className: 'changelog-tag--security',
  },
  'integration': {
    label: 'Integration',
    icon: '🔌',
    className: 'changelog-tag--integration',
  },
  'region': {
    label: 'Availability',
    icon: '🌍',
    className: 'changelog-tag--region',
  },
  'deprecation': {
    label: 'Deprecation',
    icon: '⚠️',
    className: 'changelog-tag--deprecation',
  },
  'bug-fix': {
    label: 'Bug Fix',
    icon: '🐛',
    className: 'changelog-tag--bug-fix',
  },
  'breaking-change': {
    label: 'Breaking Change',
    icon: '🚨',
    className: 'changelog-tag--breaking-change',
  },
  'beta': {
    label: 'Beta',
    icon: '🧪',
    className: 'changelog-tag--beta',
  },
  'ga': {
    label: 'GA',
    icon: '🎉',
    className: 'changelog-tag--ga',
  },
};

const config = tagConfig[type] || tagConfig['new-feature'];
---

<span class={`changelog-tag ${config.className}`}>
  <span class="changelog-tag__icon" aria-hidden="true">{config.icon}</span>
  <span class="changelog-tag__label">{config.label}</span>
</span>

<style>
  .changelog-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    height: 1.75rem;
    box-sizing: border-box;
    padding: 0 0.6em;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
    vertical-align: middle;
    margin-right: 0.5em;
  }

  .changelog-tag__icon {
    font-size: 0.9em;
    line-height: 1;
  }

  .changelog-tag__label {
    line-height: 1;
  }

  /* New Feature - Purple/Violet */
  .changelog-tag--new-feature {
    background-color: light-dark(#f3e8ff, #3b0764);
    color: light-dark(#7c3aed, #c4b5fd);
    border: 1px solid light-dark(#ddd6fe, #581c87);
  }

  /* Improvement - Blue */
  .changelog-tag--improvement {
    background-color: light-dark(#dbeafe, #1e3a5f);
    color: light-dark(#2563eb, #93c5fd);
    border: 1px solid light-dark(#bfdbfe, #1e40af);
  }

  /* Performance - Yellow/Amber */
  .changelog-tag--performance {
    background-color: light-dark(#fef3c7, #451a03);
    color: light-dark(#d97706, #fcd34d);
    border: 1px solid light-dark(#fde68a, #92400e);
  }

  /* Security - Green */
  .changelog-tag--security {
    background-color: light-dark(#dcfce7, #14532d);
    color: light-dark(#16a34a, #86efac);
    border: 1px solid light-dark(#bbf7d0, #166534);
  }

  /* Integration - Cyan/Teal */
  .changelog-tag--integration {
    background-color: light-dark(#cffafe, #164e63);
    color: light-dark(#0891b2, #67e8f9);
    border: 1px solid light-dark(#a5f3fc, #0e7490);
  }

  /* Region/Availability - Indigo */
  .changelog-tag--region {
    background-color: light-dark(#e0e7ff, #312e81);
    color: light-dark(#4f46e5, #a5b4fc);
    border: 1px solid light-dark(#c7d2fe, #3730a3);
  }

  /* Deprecation - Orange */
  .changelog-tag--deprecation {
    background-color: light-dark(#ffedd5, #431407);
    color: light-dark(#ea580c, #fdba74);
    border: 1px solid light-dark(#fed7aa, #9a3412);
  }

  /* Bug Fix - Pink */
  .changelog-tag--bug-fix {
    background-color: light-dark(#fce7f3, #500724);
    color: light-dark(#db2777, #f9a8d4);
    border: 1px solid light-dark(#fbcfe8, #9d174d);
  }

  /* Breaking Change - Red */
  .changelog-tag--breaking-change {
    background-color: light-dark(#fee2e2, #450a0a);
    color: light-dark(#dc2626, #fca5a5);
    border: 1px solid light-dark(#fecaca, #991b1b);
  }

  /* Beta - Slate/Gray */
  .changelog-tag--beta {
    background-color: light-dark(#f1f5f9, #1e293b);
    color: light-dark(#475569, #cbd5e1);
    border: 1px solid light-dark(#e2e8f0, #334155);
  }

  /* GA - Tiger brand colors */
  .changelog-tag--ga {
    background-color: light-dark(#fefce8, #365314);
    color: light-dark(#65a30d, #bef264);
    border: 1px solid light-dark(#d9f99d, #4d7c0f);
  }
</style>
