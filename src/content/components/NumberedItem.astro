---
/**
 * NumberedItem – one entry in a NumberedList.
 *
 * Use inside <NumberedList>: each item shows a bold title followed by optional body (slot).
 * Body can be plain text or MDX (italic, code, links, etc.).
 *
 * Usage:
 *   <NumberedItem title="Start your AI assistant">
 *     (e.g. `claude`). It will start the Tiger MCP server and connect to Tiger Cloud.
 *   </NumberedItem>
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<li class="numbered-list__item">
  <strong class="numbered-list__item-title">{title}</strong>
  <span class="numbered-list__item-body">
    <slot />
  </span>
</li>
