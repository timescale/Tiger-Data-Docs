---
/**
 * Header search bar matching Figma: Docs Navigation (node 3377:9674).
 * Visual: gray rounded container, search icon left, "Search" placeholder, ⌘K badge right.
 * Wraps the Starlight Search component so the bar is the trigger for doc search.
 */
import Search from "virtual:starlight/components/Search";
---

<div class="header-search-bar">
  <div class="header-search-bar__input-wrap">
    <svg
      class="header-search-bar__icon"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden
    >
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.35-4.35" />
    </svg>
    <span class="header-search-bar__placeholder" aria-hidden>Search</span>
    <kbd class="header-search-bar__kbd">⌘K</kbd>
    <!-- Starlight Search: typically renders a button that opens the search modal. We overlay it so the whole bar is clickable. -->
    <div class="header-search-bar__trigger">
      <Search />
    </div>
  </div>
</div>

<style>
  .header-search-bar {
    flex: 1 0 0;
    min-width: 0;
    max-width: 280px;
  }

  /* Figma 3377:9674 – 38px height, 4px radius, 12px horizontal padding */
  .header-search-bar__input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 12px;
    gap: 10px;
    background: var(--header-search-bg, #f8f8f8);
    border: 1px solid var(--header-search-border, #ebebeb);
    border-radius: 4px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .header-search-bar__input-wrap:hover {
    border-color: light-dark(var(--tiger-grey-300), var(--tiger-grey-600));
  }

  .header-search-bar__input-wrap:focus-within {
    border-color: var(--stl-color-accent);
    box-shadow: 0 0 0 3px light-dark(
      color-mix(in srgb, var(--tiger-vivid-purple) 20%, transparent),
      color-mix(in srgb, var(--tiger-electric-yellow) 20%, transparent)
    );
  }

  .header-search-bar__icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    color: var(--tiger-fg-muted);
  }

  .header-search-bar__placeholder {
    flex: 1;
    min-width: 0;
    font-family: var(--tiger-font-sans, "Geist", system-ui, sans-serif);
    font-size: 14px;
    line-height: 21px;
    color: var(--tiger-fg-muted);
    pointer-events: none;
  }

  /* Figma 3377:9681 – distinct bordered pill so ⌘K reads as a shortcut hint */
  .header-search-bar__kbd {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 24px;
    min-width: 28px;
    padding: 0 6px;
    font-family: var(--tiger-font-mono, "Geist Mono", ui-monospace, monospace);
    font-size: 12px;
    line-height: 18px;
    color: var(--tiger-fg-muted);
    background: var(--header-search-kbd-bg, #ffffff);
    border: 1px solid var(--header-search-kbd-border, #ebebeb);
    border-radius: 4px;
  }

  /* Overlay the Starlight Search trigger so clicking anywhere on the bar opens search */
  .header-search-bar__trigger {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  /*
   * Only the header open control (Starlight + Algolia both use data-open-modal on that control).
   * Do not match other buttons inside <Search /> (popover filters, dialog actions): they share
   * the same ancestor .header-search-bar__trigger and would otherwise fill the whole modal.
   */
  .header-search-bar__trigger :global(button[data-open-modal]),
  .header-search-bar__trigger :global(a[data-open-modal]) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }
</style>
