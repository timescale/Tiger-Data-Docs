<script is:inline>
  /**
   * Right-rail "On this page" scroll-spy.
   *
   * Starlight ships its own scroll-spy in `<starlight-toc>`, but it captures its
   * link list (and the initial `aria-current` link) once at init. On this site
   * `PartialTocSync` rebuilds the TOC `<ul>` at runtime to surface partial-injected
   * headings, which replaces those `<a>` elements — so Starlight's observer ends up
   * driving `aria-current` on detached nodes and the visible TOC never highlights
   * the current section.
   *
   * This spy sidesteps that entirely: it reads the *live* links every frame and
   * sets `aria-current` on the entry whose heading is currently at the top of the
   * viewport. It also re-asserts shortly after load to override the one stray
   * removal Starlight's observer performs before it starts working on stale nodes.
   *
   * It also intercepts TOC clicks so the page always scrolls the clicked heading to
   * the top — native anchor clicks do nothing when the hash already matches the URL.
   */
  (function () {
    function headerOffset() {
      var header = document.querySelector("header");
      var h = header ? header.getBoundingClientRect().height : 0;
      // Activate a heading once it sits a little below the sticky header.
      return h + 24;
    }

    /** The nearest scrollable ancestor of a TOC link (the rail column). */
    function scrollContainerOf(el) {
      var node = el.parentElement;
      while (node) {
        var oy = getComputedStyle(node).overflowY;
        if ((oy === "auto" || oy === "scroll") && node.scrollHeight > node.clientHeight + 1)
          return node;
        node = node.parentElement;
      }
      return null;
    }

    /**
     * Keep the active TOC link visible by scrolling ONLY the rail's own scroll
     * container — never the window (so following the highlight can't move the
     * page). No-ops when the TOC fits without scrolling.
     */
    function keepActiveVisible(link) {
      var c = scrollContainerOf(link);
      if (!c) return;
      var cr = c.getBoundingClientRect();
      var lr = link.getBoundingClientRect();
      var margin = 16;
      if (lr.top < cr.top + margin) {
        c.scrollTop -= cr.top + margin - lr.top;
      } else if (lr.bottom > cr.bottom - margin) {
        c.scrollTop += lr.bottom - (cr.bottom - margin);
      }
    }

    /** Resolve the heading element a TOC hash points at. */
    function headingFor(hash) {
      var id = decodeURIComponent(hash.slice(1));
      return id === "_top"
        ? document.getElementById("_top") || document.querySelector("main h1")
        : document.getElementById(id);
    }

    /** Live [{ link, heading }] pairs in document order, rebuilt each update. */
    function collect() {
      var toc = document.querySelector("starlight-toc");
      if (!toc) return [];
      var links = Array.prototype.slice.call(toc.querySelectorAll("a[href^='#']"));
      var out = [];
      for (var i = 0; i < links.length; i++) {
        var heading = headingFor(links[i].hash);
        if (heading) out.push({ link: links[i], heading: heading });
      }
      return out;
    }

    var lastActive = null;
    function update() {
      var entries = collect();
      if (!entries.length) return;
      var offset = headerOffset();
      // Activate the last heading sitting at or above the offset line. `ensureBottomRoom`
      // reserves enough scroll space that even the final short sections reach it, so no
      // special bottom-of-page handling is needed here.
      var active = entries[0].link;
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].heading.getBoundingClientRect().top - offset <= 1) active = entries[i].link;
        else break;
      }
      for (var j = 0; j < entries.length; j++) {
        var link = entries[j].link;
        if (link === active) {
          if (link.getAttribute("aria-current") !== "true")
            link.setAttribute("aria-current", "true");
        } else if (link.getAttribute("aria-current") === "true") {
          link.removeAttribute("aria-current");
        }
      }
      // When the active section changes, scroll the rail so its highlight stays
      // visible even once it passes the bottom of the TOC's own scroll area.
      if (active !== lastActive) {
        lastActive = active;
        keepActiveVisible(active);
      }
    }

    /**
     * Reserve enough scroll room at the page bottom that even the last heading can
     * be scrolled up to the offset line. Without this, trailing sections whose
     * content (plus footer) is shorter than a viewport can never reach the top, so
     * clicking them in the TOC lands short. The spacer grows only by the deficit,
     * so pages with a long tail are unaffected (its height stays 0).
     */
    function ensureBottomRoom() {
      var main = document.querySelector("main");
      if (!main) return;
      var spacer = document.getElementById("toc-scroll-spacer");
      if (!spacer) {
        spacer = document.createElement("div");
        spacer.id = "toc-scroll-spacer";
        spacer.setAttribute("aria-hidden", "true");
      }
      // Keep it the very last element so it only ever adds room below everything.
      if (main.lastElementChild !== spacer) main.appendChild(spacer);
      spacer.style.height = "0px";
      var entries = collect();
      if (!entries.length) return;
      var last = entries[entries.length - 1].heading;
      var lastTop = last.getBoundingClientRect().top + window.scrollY;
      var needed =
        lastTop - headerOffset() + window.innerHeight - document.documentElement.scrollHeight;
      spacer.style.height = (needed > 0 ? Math.ceil(needed) : 0) + "px";
    }

    /**
     * Always scroll the clicked TOC entry to just below the sticky header — even
     * when its hash already matches the URL (a native anchor click is a no-op in
     * that case, so the page wouldn't move otherwise).
     */
    function onClick(e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)
        return;
      var a = e.target.closest ? e.target.closest("a[href^='#']") : null;
      if (!a) return;
      var toc = document.querySelector("starlight-toc");
      if (!toc || !toc.contains(a)) return;
      var heading = headingFor(a.hash);
      if (!heading) return;
      e.preventDefault();
      // Make sure the page can scroll far enough to land this heading at the top.
      ensureBottomRoom();
      var doc = document.documentElement;
      var maxScroll = Math.max(0, doc.scrollHeight - window.innerHeight);
      var top = heading.getBoundingClientRect().top + window.scrollY - headerOffset();
      top = Math.max(0, Math.min(top, maxScroll));
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: top, behavior: reduce ? "auto" : "smooth" });
      if (history.pushState) history.pushState(null, "", a.hash);
      update();
    }

    // Re-measure the bottom room (viewport- and layout-dependent) then re-highlight.
    function refresh() {
      ensureBottomRoom();
      update();
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        update();
      });
    }

    var resizeTimer;
    function onResize() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(refresh, 150);
    }

    function start() {
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onResize, { passive: true });
      // Capture phase so we own the click before the native anchor jump.
      document.addEventListener("click", onClick, true);
      // Run now and again shortly after, to land after PartialTocSync's rebuild
      // and to override Starlight's one stray aria-current removal.
      refresh();
      setTimeout(refresh, 200);
      setTimeout(refresh, 600);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
    document.addEventListener("astro:page-load", refresh);
  })();
</script>