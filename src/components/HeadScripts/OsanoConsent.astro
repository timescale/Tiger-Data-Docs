<script is:inline>
  // Osano itself is loaded directly in astro.config.ts's head[] array, not here — this
  // only reacts to window.Osano.cm however it got there.
  (function () {
    var listeners = [];
    var lastState = null;
    var boundCm = null;

    function notify() {
      var cm = window.Osano && window.Osano.cm;
      if (!cm) return;
      lastState = {
        analytics: Boolean(cm.analytics),
        marketing: Boolean(cm.marketing),
        personalization: Boolean(cm.personalization),
      };
      listeners.forEach(function (fn) {
        fn(lastState);
      });
    }

    // window.Osano.cm gets replaced with a new object partway through init (confirmed
    // empirically, despite Osano's docs saying not to expect this) — keep rechecking the
    // reference rather than binding once.
    function ensureBound() {
      var cm = window.Osano && window.Osano.cm;
      if (!cm || cm === boundCm) return;
      if (boundCm) {
        boundCm.removeEventListener("osano-cm-initialized", notify);
        boundCm.removeEventListener("osano-cm-consent-saved", notify);
      }
      cm.addEventListener("osano-cm-initialized", notify);
      cm.addEventListener("osano-cm-consent-saved", notify);
      boundCm = cm;
      notify();
    }

    ensureBound();
    setInterval(ensureBound, 250);

    // Calls back immediately with a deny-by-default state if Osano hasn't resolved yet
    // (matching Osano's own default-deny Consent Mode state) rather than leaving
    // subscribers with no call at all until it does — PostHog in particular must not
    // sit in its own default (full) capture mode during that window.
    // Consumed by PostHogAnalytics.astro and TwitterPixel.astro.
    window.__onOsanoConsent = function (callback) {
      callback(lastState || { analytics: false, marketing: false, personalization: false });
      listeners.push(callback);
    };

    window.__onOsanoConsent(function (state) {
      if (typeof window.gtag !== "function") return;
      window.gtag("consent", "update", {
        analytics_storage: state.analytics ? "granted" : "denied",
        ad_storage: state.marketing ? "granted" : "denied",
        ad_user_data: state.marketing ? "granted" : "denied",
        ad_personalization: state.marketing ? "granted" : "denied",
        functionality_storage: state.personalization ? "granted" : "denied",
        personalization_storage: state.personalization ? "granted" : "denied",
        security_storage: "granted",
      });
    });
  })();
</script>
