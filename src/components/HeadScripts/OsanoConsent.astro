---
/**
 * Plumbing that lets other non-essential third-party scripts react to the visitor's
 * Osano consent choice. Osano itself is loaded directly in astro.config.ts's head[]
 * array (not by this file, and not by GTM — the GTM "Osano Consent Manager" tag is
 * disabled in favor of this), positioned before GTM per Osano's install docs so its
 * automatic script/cookie/iframe blocking can intercept everything that loads after it.
 *
 *  - Exposes `window.__onOsanoConsent(callback)`: calls `callback({analytics, marketing,
 *    personalization})` once Osano resolves, and again every time the visitor changes
 *    their choice. PostHogAnalytics.astro and TwitterPixel.astro subscribe to this
 *    instead of each re-implementing Osano's async init/polling. If Osano never loads
 *    (env vars unset, script blocked, etc.) the callback simply never fires — fails
 *    safe toward less tracking, not more.
 *  - Mirrors consent into Google Consent Mode v2 (`gtag('consent', 'update', ...)`) so
 *    GTM-managed tags respect the same choice. Osano's own docs don't prescribe a Consent
 *    Mode integration; this mirror is ours. The *default* (deny-all) consent state is set
 *    in astro.config.ts, before Osano's and GTM's own script tags, so neither fires
 *    anything before a default exists — this script only updates that state once Osano
 *    has an answer.
 */
---

<script is:inline>
  (function () {
    var listeners = [];
    var lastState = null;
    var boundCm = null;

    function notify() {
      var cm = window.Osano && window.Osano.cm;
      if (!cm) return;
      lastState = {
        analytics: Boolean(cm.analytics),
        marketing: Boolean(cm.marketing),
        personalization: Boolean(cm.personalization),
      };
      listeners.forEach(function (fn) {
        fn(lastState);
      });
    }

    // Osano's own docs say window.Osano.cm is available immediately once its script tag
    // runs and that there's no need to wait — but empirically (tested against this
    // site's actual Osano account, loaded via GTM's tag rather than directly) the object
    // got replaced with a new instance partway through init, which would silently orphan
    // listeners bound once and left in place. Keep checking for a new reference
    // indefinitely as a defensive measure; the check itself is a cheap object-identity
    // comparison, re-binding only runs on an actual swap.
    function ensureBound() {
      var cm = window.Osano && window.Osano.cm;
      if (!cm || cm === boundCm) return;
      if (boundCm) {
        boundCm.removeEventListener("osano-cm-initialized", notify);
        boundCm.removeEventListener("osano-cm-consent-saved", notify);
      }
      cm.addEventListener("osano-cm-initialized", notify);
      cm.addEventListener("osano-cm-consent-saved", notify);
      boundCm = cm;
      notify();
    }

    ensureBound();
    setInterval(ensureBound, 250);

    window.__onOsanoConsent = function (callback) {
      if (lastState) callback(lastState);
      listeners.push(callback);
    };

    window.__onOsanoConsent(function (state) {
      if (typeof window.gtag !== "function") return;
      window.gtag("consent", "update", {
        analytics_storage: state.analytics ? "granted" : "denied",
        ad_storage: state.marketing ? "granted" : "denied",
        ad_user_data: state.marketing ? "granted" : "denied",
        ad_personalization: state.marketing ? "granted" : "denied",
        functionality_storage: state.personalization ? "granted" : "denied",
        personalization_storage: state.personalization ? "granted" : "denied",
        security_storage: "granted",
      });
    });
  })();
</script>
