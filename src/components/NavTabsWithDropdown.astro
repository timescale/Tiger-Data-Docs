---
/**
 * Tab hover dropdowns: one panel, top-level sidebar sections only (no nested page links).
 * Each section row uses sectionIndexHref so the heading goes to that area’s hub when defined.
 */
import { Button } from "@stainless-api/ui-primitives";
import { TABS } from "virtual:stl-docs-virtual-module";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import type { NavTreeNode } from "./nav-dropdown-tree-types";
import NavDropdownTree from "./NavDropdownTree.astro";

/**
 * Tab shape from `stainlessDocs({ tabs: [...] })` in `astro.config.ts`.
 * `virtual:stl-docs-virtual-module` only declares `label`, `link`, and `hidden`; sidebar config is added at runtime.
 */
type NavTabConfig = {
  label: string;
  link: string;
  hidden?: boolean;
  sidebar?: unknown[];
};

type NavTabWithActive = NavTabConfig & { active: boolean };

const tabsFromConfig = TABS as readonly NavTabConfig[];

const routeData = Astro.locals.starlightRoute as StarlightRouteData & {
  _stlDocs?: { activeTabIndex?: number };
};
const activeTabIndex = routeData?._stlDocs?.activeTabIndex ?? -1;

const tabList: NavTabWithActive[] = tabsFromConfig
  .map(
    (item, index): NavTabWithActive => ({
      ...item,
      active: index === activeTabIndex,
    })
  )
  .filter((item) => !item.hidden);

const navItems: NavTabWithActive[] = [...tabList].sort((a, b) => {
  if (a.label === "Reference" && b.label === "Deploy") return 1;
  if (a.label === "Deploy" && b.label === "Reference") return -1;
  return 0;
});

interface SidebarEntryLike {
  label: string;
  link?: string;
  autogenerate?: { directory: string };
  items?: unknown[];
  dropdownDescription?: string;
}

/**
 * Dropdown-only landing-page overrides, keyed by sidebar section label.
 *
 * The header dropdown derives each section heading's link from the sidebar tree
 * (`sectionIndexHref`). When a section's first entry is a subgroup, that heuristic
 * falls through to the first *flat* link instead, which can be the wrong landing page
 * (e.g. "Tiger Cloud on AWS" resolved to "Monitor your services"). These overrides fix
 * the heading link without touching the left sidebar, which is generated from the same
 * config but can't carry custom keys (Starlight's sidebar schema is strict).
 */
const SECTION_DROPDOWN_HREF: Record<string, string> = {
  "Get hands on": "/build/how-to/your-first-hypertable",
  "Migrate to Tiger Cloud": "/migrate/livesync-replication",
  "Tiger Cloud on AWS": "/deploy/tiger-cloud/tiger-cloud-aws/configuration/about-configuration",
  "Tiger Cloud on Azure": "/deploy/tiger-cloud/tiger-cloud-azure/configuration/about-configuration",
  "Tiger Cloud REST API": "/reference/tiger-cloud-rest",
};

/**
 * Dropdown-only: sidebar sections whose children are promoted to individual
 * dropdown entries instead of a single section link. Used for the Reference
 * "Tiger Cloud" group so the dropdown lists Tiger CLI, Tiger MCP, and the REST API
 * as separate entries (not one "Tiger Cloud" overview link), without changing the
 * left sidebar. The "Overview" and "Data tiering" children are dropped.
 */
const SECTION_DROPDOWN_EXPAND: Record<string, Set<string>> = {
  Reference: new Set<string>(["Tiger Cloud"]),
};

const BASE_PREFIX = import.meta.env.BASE_URL.replace(/\/$/, "");

/**
 * Strip the Astro base path (e.g. `/docs` in production) from a root-relative href.
 * Tab links from the TABS virtual module arrive already base-prefixed, while sidebar
 * entry links do not until `prefixNavTreeHrefs` runs. Normalizing both to a base-free
 * form lets `filterOverviewDuplicate` compare them correctly regardless of base path.
 */
function stripBasePrefix(p: string): string {
  if (!BASE_PREFIX) return p;
  if (p === BASE_PREFIX) return "/";
  if (p.startsWith(BASE_PREFIX + "/")) return p.slice(BASE_PREFIX.length);
  return p;
}

function normalizePath(h: string): string {
  return stripBasePrefix(h.split("#")[0]).replace(/\/$/, "") || "/";
}

/**
 * First page URL in sidebar order (depth-first). Used when a section has nested groups
 * but no single configured hub (header dropdown still needs a real link).
 */
function firstDescendantLeafLink(items: unknown[] | undefined): string | undefined {
  if (!Array.isArray(items)) return undefined;
  for (const raw of items) {
    if (typeof raw === "string") continue;
    const c = raw as SidebarEntryLike;
    if (!c || typeof c !== "object" || typeof c.label !== "string") continue;
    const childItems = Array.isArray(c.items) ? c.items : [];
    if (typeof c.link === "string" && childItems.length === 0) {
      return c.link;
    }
    if (childItems.length > 0) {
      const nested = firstDescendantLeafLink(childItems);
      if (nested) return nested;
    }
    if (c.autogenerate?.directory && childItems.length === 0) {
      const dir = c.autogenerate.directory.replace(/\/$/, "");
      return `/${dir}`;
    }
  }
  return undefined;
}

/**
 * Best URL for the "top" of a sidebar section: explicit link, generated directory index,
 * Overview page, first matching link in the sidebar config, or first descendant page.
 */
function sectionIndexHref(e: SidebarEntryLike): string | undefined {
  const override = SECTION_DROPDOWN_HREF[e.label?.trim()];
  if (override) return override;
  if (typeof e.link === "string") return e.link;

  const items = Array.isArray(e.items) ? e.items : [];
  if (e.autogenerate?.directory && items.length === 0) {
    const dir = e.autogenerate.directory.replace(/\/$/, "");
    return `/${dir}`;
  }

  for (const raw of items) {
    if (typeof raw === "string") continue;
    const c = raw as SidebarEntryLike;
    if (!c?.label) continue;
    if (/^overview$/i.test(c.label.trim()) && typeof c.link === "string") return c.link;
  }

  for (const raw of items) {
    if (typeof raw === "string") continue;
    const c = raw as SidebarEntryLike;
    if (typeof c.link === "string") return c.link;
    const cItems = Array.isArray(c.items) ? c.items : [];
    if (c.autogenerate?.directory && cItems.length === 0) {
      const dir = c.autogenerate.directory.replace(/\/$/, "");
      return `/${dir}`;
    }
  }

  const subgroups = items.filter((raw) => {
    if (typeof raw === "string") return false;
    const c = raw as SidebarEntryLike;
    return Array.isArray(c.items) && c.items.length > 0;
  }) as SidebarEntryLike[];

  const hasDirectLink = items.some((raw) => {
    if (typeof raw === "string") return false;
    const c = raw as SidebarEntryLike;
    return typeof c.link === "string";
  });

  if (!hasDirectLink && subgroups.length >= 2) {
    return firstDescendantLeafLink(items);
  }

  if (!hasDirectLink && subgroups.length === 1) {
    return sectionIndexHref(subgroups[0]);
  }

  return firstDescendantLeafLink(items);
}

/**
 * Only the tab sidebar’s **root** entries appear in the dropdown (same as top-level sidebar groups).
 * Nested pages are omitted; use the section heading link (sectionIndexHref) or the left sidebar for drill-down.
 */
function buildNavTree(entries: unknown[] | undefined, tabLabel: string): NavTreeNode[] {
  const out: NavTreeNode[] = [];
  if (!Array.isArray(entries)) return out;

  for (const raw of entries) {
    if (typeof raw === "string") continue;
    const e = raw as SidebarEntryLike;
    if (!e || typeof e !== "object" || typeof e.label !== "string") continue;

    const items = Array.isArray(e.items) ? e.items : [];
    const hasItems = items.length > 0;

    if (hasItems && SECTION_DROPDOWN_EXPAND[tabLabel]?.has(e.label.trim())) {
      const childNodes = buildNavTree(items, tabLabel).filter(
        (n) => !/^(overview|data tiering)$/i.test(n.label.trim())
      );
      out.push(...childNodes);
      continue;
    }

    if (hasItems) {
      const href = sectionIndexHref(e);
      out.push({
        kind: "group",
        label: e.label,
        description: "",
        href,
        children: [],
      });
      continue;
    }

    if (typeof e.link === "string") {
      out.push({
        kind: "link",
        label: e.label,
        href: e.link,
        description: e.dropdownDescription ?? "",
      });
    } else if (e.autogenerate?.directory && !hasItems) {
      const dir = e.autogenerate.directory.replace(/\/$/, "");
      out.push({
        kind: "link",
        label: e.label,
        href: `/${dir}`,
        description: e.dropdownDescription ?? "",
      });
    }
  }
  return out;
}

function filterOverviewDuplicate(nodes: NavTreeNode[], tabLink: string): NavTreeNode[] {
  const tabPath = normalizePath(tabLink);
  return nodes.filter((n) => {
    // Drop any root entry — a plain link or a section group (e.g. Learn's "Overview"
    // group whose href resolves to its first child) — labelled "Overview" that points at
    // the tab's own index page. The dropdown header already links there.
    if (typeof n.href !== "string") return true;
    return !(normalizePath(n.href) === tabPath && /^overview$/i.test(n.label.trim()));
  });
}

/** Clear descriptions so dropdowns stay title-only (SEO copy stays in page frontmatter). */
function clearTreeDescriptions(nodes: NavTreeNode[]): void {
  for (const n of nodes) {
    if (n.kind === "link") {
      n.description = "";
    } else {
      n.description = "";
      clearTreeDescriptions(n.children);
    }
  }
}

/** Recursively prefix every href in the nav tree with the Astro base path. */
function prefixNavTreeHrefs(nodes: NavTreeNode[]): void {
  for (const n of nodes) {
    if (n.href && n.href !== "#" && n.href.startsWith("/") && !n.href.startsWith(BASE_PREFIX + "/") && n.href !== BASE_PREFIX) {
      n.href = BASE_PREFIX + n.href;
    }
    if (n.kind === "group") prefixNavTreeHrefs(n.children);
  }
}

function getNavTreeForSidebar(sidebar: unknown, tabLink: string, tabLabel: string): NavTreeNode[] {
  const tree = buildNavTree(sidebar as unknown[], tabLabel);
  const filtered = filterOverviewDuplicate(tree, tabLink);
  clearTreeDescriptions(filtered);
  prefixNavTreeHrefs(filtered);
  return filtered;
}

const dropdownTreeByTab = new Map<string, NavTreeNode[]>();
for (const item of navItems) {
  const sidebar = item.sidebar;
  if (Array.isArray(sidebar) && sidebar.length > 0) {
    dropdownTreeByTab.set(item.label, getNavTreeForSidebar(sidebar, item.link, item.label));
  }
}
---

<div class="stl-secondary-nav-tabs stl-nav-tabs-with-dropdown">
  <ul>
    {
      navItems.map((item) => {
        const tree = dropdownTreeByTab.get(item.label) ?? [];
        const hasDropdown = tree.length > 0;

        return (
          <li class:list={[item.active && "active"]}>
            {hasDropdown ? (
              <div class="nav-dropdown-wrapper">
                <Button
                  href={item.link}
                  variant="ghost"
                  className={["nav-trigger", item.active && "stl-active-secondary-link"].filter(Boolean).join(" ")}
                >
                  <Button.Label>
                    {item.label}
                    <span class="nav-chevron" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </Button.Label>
                </Button>
                <div class="nav-dropdown nav-dropdown--tree" role="menu">
                  <a href={item.link} class="nav-dropdown-item nav-dropdown-item--overview" role="menuitem">
                    <span class="nav-dropdown-item-title">{item.label}</span>
                  </a>
                  <div class="nav-dropdown-tree-root">
                    <NavDropdownTree nodes={tree} />
                  </div>
                </div>
              </div>
            ) : (
              <Button href={item.link} variant="ghost" className={item.active ? "stl-active-secondary-link" : undefined}>
                <Button.Label>{item.label}</Button.Label>
              </Button>
            )}
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .stl-secondary-nav-tabs.stl-nav-tabs-with-dropdown {
    display: none;
    width: 100%;
  }

  .stl-nav-tabs-with-dropdown ul {
    display: flex;
    align-items: center;
    min-height: 38px;
    padding: 0;
    list-style: none;
    margin-bottom: -1px;
    box-sizing: border-box;
  }

  .stl-nav-tabs-with-dropdown li {
    padding-bottom: 1px;
    border-bottom: 2px solid transparent;
  }

  .stl-nav-tabs-with-dropdown li.active {
    border-color: var(--stl-color-accent-border-strong);
  }

  .stl-nav-tabs-with-dropdown .stl-ui-button {
    border-width: 0;
    padding: 8px 12px;
    margin-inline: -12px;
  }

  .stl-nav-tabs-with-dropdown li:not(:first-child) {
    margin-inline-start: 12px;
  }

  .stl-nav-tabs-with-dropdown li:not(:last-child) {
    margin-inline-end: 12px;
  }

  .nav-chevron {
    display: inline-flex;
    margin-left: 4px;
    opacity: 0.8;
  }

  .nav-dropdown-wrapper {
    position: relative;
    /* Match HeaderSearchBar control height (38px) so the row and dropdown anchor line up with search */
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    box-sizing: border-box;
  }

  .nav-dropdown-wrapper .nav-trigger {
    display: inline-flex;
    align-items: center;
  }

  .nav-dropdown {
    position: absolute;
    /* Drop from the same baseline as the search bar: anchor to bottom of 38px row */
    top: 100%;
    left: 0;
    margin-top: 0;
    min-width: min(320px, calc(100vw - 2rem));
    max-width: min(420px, calc(100vw - 2rem));
    overflow: visible;
    padding: 8px 0;
    background: light-dark(var(--tiger-white), var(--tiger-grey-900));
    border: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    /* Same radius as `.header-search-bar__input-wrap` (4px) so the panel lines up with the search bar */
    border-radius: 4px;
    box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      visibility 0.15s ease,
      transform 0.15s ease;
    /* Above in-page overlays (e.g. integrate filter panels at z-index 100); header uses z-index: 100 in theme.css */
    z-index: 200;
  }

  .nav-dropdown-tree-root {
    max-height: min(70vh, 560px);
    overflow-x: hidden;
    overflow-y: auto;
    padding-bottom: 4px;
  }

  .nav-dropdown-wrapper:hover .nav-dropdown,
  .nav-dropdown-wrapper .nav-dropdown:focus-within {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-wrapper:hover .nav-trigger {
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-800));
    border-radius: var(--tiger-radius-sm, 6px);
  }

  .nav-dropdown-item--overview {
    display: block;
    padding: 10px 16px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    margin-bottom: 4px;
    transition: background 0.1s ease;
  }

  .nav-dropdown-item--overview:hover {
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-800));
  }

  .nav-dropdown-item-title {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (min-width: 50rem) {
    .stl-nav-tabs-with-dropdown.stl-secondary-nav-tabs {
      display: block;
    }
  }
</style>
