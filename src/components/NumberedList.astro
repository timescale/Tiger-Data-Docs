---
/**
 * NumberedList – steps component per Figma 3387-359: optional heading, 32px dark circles with white numbers, vertical connector line, 16px/36px spacing.
 *
 * Renders an optional heading and <ol>; each child is <NumberedItem title="...">...</NumberedItem>.
 * Styles live in theme.css (numbered list section).
 *
 * Usage:
 *   <NumberedList heading="Optional section title">
 *     <NumberedItem title="Step one">Body text.</NumberedItem>
 *     <NumberedItem title="Step two">More text.</NumberedItem>
 *   </NumberedList>
 */
export interface Props {
  /** Optional heading above the steps (Figma: Heading 18 Strong) */
  heading?: string;
}

const { heading } = Astro.props;
---

<div class="numbered-list-wrapper">
  {heading && (
    <h2 class="numbered-list__heading">{heading}</h2>
  )}
  <ol class="numbered-list">
    <slot />
  </ol>
</div>
