---
/**
 * Custom Callout that implements Figma designs for variant="tip" (lightbulb) and
 * variant="note" (information circle): light purple box, 24px padding, full border,
 * icon + title + body. Other variants delegate to Stainless ui-primitives Callout.
 */
import { Callout as StainlessCallout, type CalloutVariant } from "@stainless-api/ui-primitives";

export interface Props {
  variant?: CalloutVariant;
  /** Optional title; defaults are "Tips" / "Note" for tip/note. */
  title?: string;
  children?: astroHTML.JSX.Children;
}

const { variant = "note", title, children } = Astro.props;

const isTip = variant === "tip";
const isNote = variant === "note";
const isCustomVariant = isTip || isNote;
const displayTitle = title ?? (isTip ? "Tips" : isNote ? "Note" : undefined);
---

{isCustomVariant ? (
  <div class="stl-callout" data-variant={variant}>
    <div class="stl-callout__header" data-callout-header>
      <span class="stl-callout__icon" aria-hidden="true">
        {isTip ? (
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
          >
            <path
              d="M12 2a7 7 0 0 1 4.9 12.1l-.9 2.8a1 1 0 0 1-.95.7H9.95a1 1 0 0 1-.95-.7l-.9-2.8A7 7 0 0 1 12 2z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M10 22h4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        ) : (
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
          >
            <circle
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
            />
            <path
              d="M12 11v4M12 8h.01"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )}
      </span>
      <span class="stl-callout__title">{displayTitle}</span>
    </div>
    <div class="stl-callout__body" data-callout-body>
      <slot />
    </div>
  </div>
) : (
  <StainlessCallout variant={variant}>
    <slot />
  </StainlessCallout>
)}
