---
// import LastUpdated from "virtual:starlight/components/LastUpdated";
import Pagination from "virtual:starlight/components/Pagination";

// "Suggest an edit" link to the page's Markdown source on GitHub. `editUrl` is
// derived from the `editLink.baseUrl` set in astro.config.ts plus the page's
// source path; it is undefined for auto-generated pages (the REST reference),
// which correctly renders no link.
const editUrl = Astro.locals.starlightRoute?.editUrl;
---

<footer class="stl-footer">
  <div class="stl-footer-row meta">
    {
      editUrl && (
        <a
          class="stl-edit-link print:hidden"
          href={editUrl.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          Suggest an edit to this page
        </a>
      )
    }
    <!-- <LastUpdated /> -->
  </div>

  <Pagination />

  <div class="stl-footer-row stl-footer-bottom">
    <a
      href="#"
      class="stl-footer-privacy"
      onclick="if(window.Osano && window.Osano.cm){window.Osano.cm.showDrawer('osano-cm-dom-info-dialog-open');return false;}"
    >
      Privacy Preferences
    </a>
  </div>
</footer>

<style is:global>
  .stl-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-block-start: 4rem;
    padding-block-start: 1rem;
    padding-block-end: 4rem;

    .stl-footer-row {
      display: flex;
      gap: 1rem;
      justify-content: space-between;

      &:empty,
      &:not(:has(> *)) {
        display: none;
      }
    }

    .pagination-links {
      margin-inline: calc(-0.25 * var(--stl-ui-pagination-border-radius-outer));
    }
  }

  .stl-footer-bottom {
    align-items: center;
  }

  .stl-edit-link {
    font-size: var(--stl-typography-scale-sm);
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: opacity 0.15s ease;

    &:hover {
      opacity: 0.8;
    }
  }

  .stl-footer-privacy {
    font-size: var(--stl-typography-scale-sm);
    color: var(--stl-color-foreground-reduced);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.15s ease;
    cursor: pointer;

    &:hover {
      opacity: 1;
    }
  }

  .stl-footer-credits {
    display: flex;
    flex-direction: row;
    align-items: center;
    text-decoration: none;
    margin-inline-start: auto;
    margin-block-start: 1rem;
    font-size: var(--stl-typography-scale-sm);

    opacity: 0.75;
    color: rgb(
      from var(--stl-color-foreground-reduced) r g b / calc(alpha * 0.9)
    );
    transition:
      opacity 0.15s ease,
      color 0.15s ease;
    &:hover {
      opacity: 1;
      color: var(--stl-color-foreground-reduced);
    }

    svg {
      height: 1.4em;
      width: auto;
      display: inline-block;
      margin-inline-start: 0.5ch;
      image {
        transform: translateX(0.15ch);
      }
    }
  }
</style>
