---
/**
 * ImageZoom — adds click-to-enlarge to all content images using medium-zoom.
 * Drop this component into the page layout so it runs on every page.
 */
---

<script>
  import mediumZoom from "medium-zoom";

  function initZoom() {
    mediumZoom(".sl-markdown-content img:not(.medium-zoom-image)", {
      margin: 24,
      background: "rgba(0, 0, 0, 0.85)",
    });
  }

  // Run on initial load
  initZoom();

  // Re-run after Astro client-side navigation
  document.addEventListener("astro:after-swap", initZoom);
</script>