---
/**
 * Secondary button – Figma 3245-9636 (default white), 3245-9637 (subtle gray).
 * Icon + label; 8px/5px padding, 4px radius, 12px Geist Medium, dark border.
 * Use as <button> or <a> via href. Supports optional icon slot; defaults to Copy icon.
 */
export interface Props {
  /** Visual variant: "default" (white bg) or "subtle" (light gray bg). */
  variant?: "default" | "subtle";
  /** Button label (e.g. "Copy", "Button"). */
  label: string;
  /** If set, render as <a href="...">; otherwise <button>. */
  href?: string;
  /** Optional type for <button> (e.g. "button", "submit"). */
  type?: "button" | "submit" | "reset";
  /** Accessible name; defaults to label. */
  "aria-label"?: string;
}

const { variant = "default", label, href, type = "button", "aria-label": ariaLabel } = Astro.props;
const isLink = href != null;
const className = `stl-ui-button--secondary stl-ui-button--${variant}`;
---

{isLink ? (
  <a class={className} href={href} aria-label={ariaLabel ?? label}>
    <span class="stl-ui-button__icon" aria-hidden="true">
      <slot name="icon">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M8 4.5V8.5C8 8.78 7.78 9 7.5 9H3.5C3.22 9 3 8.78 3 8.5V4.5C3 4.22 3.22 4 3.5 4H7.5C7.78 4 8 4.22 8 4.5Z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          <path d="M9 3V7.5C9 7.78 8.78 8 8.5 8H4.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
      </slot>
    </span>
    <span class="stl-ui-button__label">{label}</span>
  </a>
) : (
  <button class={className} type={type} aria-label={ariaLabel ?? label}>
    <span class="stl-ui-button__icon" aria-hidden="true">
      <slot name="icon">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M8 4.5V8.5C8 8.78 7.78 9 7.5 9H3.5C3.22 9 3 8.78 3 8.5V4.5C3 4.22 3.22 4 3.5 4H7.5C7.78 4 8 4.22 8 4.5Z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          <path d="M9 3V7.5C9 7.78 8.78 8 8.5 8H4.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
      </slot>
    </span>
    <span class="stl-ui-button__label">{label}</span>
  </button>
)}
