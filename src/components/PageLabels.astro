---
/**
 * Page labels – pill tags at the top of the page from frontmatter `pageLabels` (Figma 3387-1829, 1817, 1833, 1845, 1850).
 * Variants: neutral (Toolkit, Community), highlight (Popular feature, Optional), experimental (Experimental).
 */
const labels = (Astro.locals.starlightRoute?.entry?.data?.pageLabels as string[] | undefined) ?? [];

function getVariant(label: string): "neutral" | "highlight" | "experimental" {
  if (label === "Experimental") return "experimental";
  if (label === "Popular feature" || label === "Optional") return "highlight";
  return "neutral";
}
---

{labels.length > 0 && (
  <div class="page-labels" data-pagefind-ignore>
    {labels.map((label) => (
      <span class={`page-label page-label--${getVariant(label)}`}>{label}</span>
    ))}
  </div>
)}
