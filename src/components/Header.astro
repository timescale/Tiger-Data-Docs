---
/**
 * Custom Header that uses NavTabsWithDropdown for hover dropdowns in the
 * tab bar. This replaces the default Stainless StackedHeader when
 * experimental.starlightCompat.components.Header is set to this file.
 *
 * Layout and behavior match the default stacked header; only the secondary
 * nav (tabs) is swapped for the dropdown version.
 */
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import { HEADER_LINKS, TABS } from "virtual:stl-docs-virtual-module";
import { Button } from "@stainless-api/ui-primitives";
import NavTabsWithDropdown from "./NavTabsWithDropdown.astro";
import SplashMobileMenuToggle from "./SplashMobileMenuToggle.astro";
import HeaderSearchBar from "./HeaderSearchBar.astro";

interface Props {
  /** When false, hides the search bar. Defaults to true so search shows on all pages. */
  shouldRenderSearch?: boolean;
}

const { shouldRenderSearch = true } = Astro.props;
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="header my-header header-single-row">
  <div class="left-group">
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>
  </div>

  <div class="header-nav-tabs-wrap">
    <NavTabsWithDropdown />
  </div>

  <div class="stl-top-container header-spacer">
    {/* Search bar: visible on mobile only; desktop shows it in right-group below */}
    {shouldRenderSearch && (
      <div class="header-search-bar-mobile sl-flex md:sl-hidden">
        <HeaderSearchBar />
      </div>
    )}
    {!hasSidebar && <SplashMobileMenuToggle />}
  </div>

  <div class={`sl-hidden md:sl-flex print:hidden right-group header-right-utilities`}>
    {shouldRenderSearch && (
      <div class="header-search-bar-desktop">
        <HeaderSearchBar />
      </div>
    )}
    <div class="header-theme-toggle">
      <ThemeSelect />
    </div>
    <div class="header-links">
      {
        HEADER_LINKS.map((link, index) => (
          <Button
            href={link.link}
            variant={link.variant || (index === HEADER_LINKS.length - 1 ? "accent" : "outline")}
            {...(link.attrs || {})}
          >
            <Button.Label>{link.label}</Button.Label>
          </Button>
        ))
      }
    </div>
    <LanguageSelect />
  </div>
</div>

<!-- Global header layout: same as default Stainless Header.astro so alignment is preserved -->
<style is:global>
  @layer starlight.core {
    header,
    header.header {
      border-color: var(--stl-color-border-faint);
    }
    /* More horizontal padding on smaller screens so header content isn’t tight to edges */
    @media (max-width: 90rem) {
      header.header {
        padding-inline-start: 1.25rem;
        padding-inline-end: 1.25rem;
      }
    }

    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
      width: 100%;
    }
    .title-wrapper {
      overflow: clip;
      min-width: 0;
      display: flex;
      align-items: center;
      /* Match right-side elements’ vertical alignment (e.g. 38px search bar) */
      min-height: 38px;
    }
    .title-wrapper a,
    .title-wrapper :global(a) {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0;
    }

    .default-tabs-container {
      justify-content: flex-end;
    }

    .split-tabs-container {
      display: flex;
      max-width: 480px;
      flex: 1;
    }
    .split-tabs-container button {
      max-width: unset;
      width: 100%;
      flex: 1;
    }

    .left-group {
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      flex-shrink: 0;
      min-height: 38px;
    }

    .right-group,
    .social-icons {
      gap: var(--sl-nav-gap);
      align-items: center;
    }

    .right-group > div {
      gap: var(--sl-nav-gap);
    }

    /* Figma 3377:9673 – clear spacing between search, theme, and CTA */
    .right-group.header-right-utilities {
      gap: 0;
      padding-inline-end: 8px;
    }
    .header-right-utilities > .header-search-bar-desktop {
      margin-inline-end: 24px;
    }
    .header-right-utilities > .header-theme-toggle {
      margin-inline-end: 24px;
    }
    .header-right-utilities > .header-links {
      gap: var(--sl-nav-gap);
      margin-inline-end: 0;
    }
    /* Extra breathing room on smaller desktop */
    @media (min-width: 50rem) and (max-width: 90rem) {
      .right-group.header-right-utilities {
        padding-inline-end: 12px;
      }
      .header-right-utilities > .header-search-bar-desktop {
        margin-inline-end: 28px;
      }
      .header-right-utilities > .header-theme-toggle {
        margin-inline-end: 28px;
      }
    }
    /* Figma 3377:9683 – theme button 32×32, 4px radius */
    .header-theme-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      flex-shrink: 0;
      border-radius: 4px;
    }
    .header-theme-toggle :global(button),
    .header-theme-toggle :global(a) {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
    }

    @media (min-width: 50rem) {
      .default-tabs-container {
        min-width: 540px;
      }
    }
  }
</style>

<style is:inline>
  .stl-top-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: end;
    gap: 0.5rem;
    width: 100%;
  }
  .header-links {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
  }
  @media (min-width: 50rem) {
    :root {
      /* Single row: logo + nav tabs + search/utilities (Figma) */
      --sl-nav-height: 56px;
    }

    header.header {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding-bottom: 0;
    }

    .header-single-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--sl-nav-gap);
      width: 100%;
      min-height: 38px;
    }

    .header-nav-tabs-wrap {
      flex-shrink: 0;
      margin-inline: var(--sl-nav-gap);
    }

    .header-nav-tabs-wrap :global(.stl-secondary-nav-tabs) {
      display: block;
    }

    .header-spacer {
      flex: 1;
      min-width: 0;
      justify-content: flex-end;
    }

    .stl-top-container {
      justify-content: center;
    }

    /* Slightly narrower search bar on smaller desktop to reduce crowding */
    @media (min-width: 50rem) and (max-width: 90rem) {
      .header-search-bar-desktop :global(.header-search-bar) {
        max-width: 220px;
      }
    }
  }

  /* Mobile / small screens: more spacing so it doesn’t feel tight */
  @media (max-width: 49.999rem) {
    .header-single-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
    }

    .header-nav-tabs-wrap {
      display: none;
    }

    .stl-top-container {
      gap: 1rem;
    }

    .header-search-bar-mobile {
      margin-inline-end: 0.25rem;
    }
  }
</style>

{
  TABS.length === 0 && (
    <style
      is:inline
      set:text={`
        @media (min-width: 50rem) {
          :root {
            --sl-nav-height: 56px;
          }
        }
      `}
    />
  )
}
