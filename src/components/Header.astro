---
/**
 * Custom Header that uses NavTabsWithDropdown for hover dropdowns in the
 * tab bar. This replaces the default Stainless StackedHeader when
 * experimental.starlightCompat.components.Header is set to this file.
 *
 * Layout and behavior match the default stacked header; only the secondary
 * nav (tabs) is swapped for the dropdown version.
 *
 * Search (`HeaderSearchBar`) must render at most once: Starlight/Stainless
 * Search uses a fixed `#stldocs-search` popover id; duplicate instances
 * break desktop `popovertarget` behavior.
 */
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import { HEADER_LINKS, TABS } from "virtual:stl-docs-virtual-module";
import { Button } from "@stainless-api/ui-primitives";
import MobileNavTabLinks from "./MobileNavTabLinks.astro";
import NavTabsWithDropdown from "./NavTabsWithDropdown.astro";
import SplashMobileMenuToggle from "./SplashMobileMenuToggle.astro";
import HeaderSearchBar from "./HeaderSearchBar.astro";

interface Props {
  /** When false, hides the search bar. Defaults to true so search shows on all pages. */
  shouldRenderSearch?: boolean;
}

const { shouldRenderSearch = true } = Astro.props;
const { hasSidebar } = Astro.locals.starlightRoute || { hasSidebar: false };

const showMobileTabStrip = TABS.length > 0;
---

<div
  class:list={[
    "header",
    "my-header",
    "header-single-row",
    showMobileTabStrip && "header--mobile-secondary-nav",
    hasSidebar && "header-single-row--has-sidebar",
    !hasSidebar && "header-single-row--splash-menu",
    !shouldRenderSearch && "header-single-row--no-search"
  ]}
>
  <div class="header-primary-row">
    <div class="left-group header-grid__logo">
      <div class="title-wrapper sl-flex">
        <SiteTitle />
      </div>
    </div>

    <div class="header-nav-tabs-wrap header-grid__tabs">
      <NavTabsWithDropdown />
    </div>

    <div class="header-grid__spacer" aria-hidden="true"></div>

    {
      shouldRenderSearch && (
        <div class="header-grid__search">
          <HeaderSearchBar />
        </div>
      )
    }

    {
      hasSidebar && (
        <div class="header-grid__mobile-menu header-grid__mobile-menu--docs">
          <MobileMenuToggle />
        </div>
      )
    }

    {
      !hasSidebar && (
        <div class="header-grid__mobile-menu">
          <SplashMobileMenuToggle />
        </div>
      )
    }

    <div
      class={`sl-hidden md:sl-flex print:hidden right-group header-right-utilities header-grid__utilities`}
    >
      <div class="header-theme-toggle">
        <ThemeSelect />
      </div>
      <div class="header-links">
        {
          HEADER_LINKS.map((link, index) => (
            <Button
              href={link.link}
              variant={
                link.variant ||
                (index === HEADER_LINKS.length - 1 ? "accent" : "outline")
              }
              {...(link.attrs || {})}
            >
              <Button.Label>{link.label}</Button.Label>
            </Button>
          ))
        }
      </div>
      <LanguageSelect />
    </div>
  </div>

  {
    showMobileTabStrip && (
      <div class="header-mobile-tab-strip">
        <MobileNavTabLinks />
      </div>
    )
  }
</div>

<!-- Global header layout: same as default Stainless Header.astro so alignment is preserved -->
<style is:global>
  @layer starlight.core {
    header,
    header.header {
      border-color: var(--stl-color-border-faint);
    }
    /* More horizontal padding on smaller screens so header content isn’t tight to edges */
    /* Horizontal padding/centering is in theme.css (Figma 3513:11064) so header and main align */

    .header {
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
      width: 100%;
    }
    .title-wrapper {
      overflow: clip;
      min-width: 0;
      display: flex;
      align-items: center;
      /* Match right-side elements’ vertical alignment (e.g. 38px search bar) */
      min-height: 38px;
    }
    .title-wrapper a,
    .title-wrapper :global(a) {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0;
    }

    .default-tabs-container {
      justify-content: flex-end;
    }

    .split-tabs-container {
      display: flex;
      max-width: 480px;
      flex: 1;
    }
    .split-tabs-container button {
      max-width: unset;
      width: 100%;
      flex: 1;
    }

    .left-group {
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      flex-shrink: 0;
      min-height: 38px;
    }

    .right-group,
    .social-icons {
      gap: var(--sl-nav-gap);
      align-items: center;
    }

    .right-group > div {
      gap: var(--sl-nav-gap);
    }

    /* Figma 3377:9673 – clear spacing between search, theme, and CTA */
    .right-group.header-right-utilities {
      gap: 0;
      padding-inline-end: 8px;
    }
    .header-grid__search {
      margin-inline-end: 24px;
    }
    .header-right-utilities > .header-theme-toggle {
      margin-inline-end: 24px;
    }
    .header-right-utilities > .header-links {
      gap: var(--sl-nav-gap);
      margin-inline-end: 0;
    }
    /* Extra breathing room on smaller desktop */
    @media (min-width: 50rem) and (max-width: 90rem) {
      .right-group.header-right-utilities {
        padding-inline-end: 12px;
      }
      .header-grid__search {
        margin-inline-end: 28px;
      }
      .header-right-utilities > .header-theme-toggle {
        margin-inline-end: 28px;
      }
    }
    /* Figma 3377:9683 – theme button 32×32, 4px radius */
    .header-theme-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      flex-shrink: 0;
      border-radius: 4px;
    }
    .header-theme-toggle :global(button),
    .header-theme-toggle :global(a) {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
    }

    @media (min-width: 50rem) {
      .default-tabs-container {
        min-width: 540px;
      }
    }
  }

  /*
   * Logo: min-content width so the SVG isn’t crushed; bounded box keeps the wordmark balanced with
   * nav ghost buttons (tabs use ~32px hit area; logo sits slightly under that visually).
   * Align: grid row uses align-items:center; logo column uses flex center + no vertical anchor padding.
   */
  .header-grid__logo.left-group {
    min-height: 0;
    min-width: min-content;
  }
  .header-grid__logo {
    flex-shrink: 0;
    max-width: none;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    align-self: center;
  }
  .header-grid__logo .title-wrapper {
    min-width: min-content;
    min-height: 28px;
    overflow: visible;
    max-width: none;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  .header-grid__logo :global(.site-title) {
    min-width: min-content;
    flex-shrink: 0;
    max-width: none;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: flex-start;
    padding: 0 !important;
    margin: 0;
    line-height: 0;
  }
  .header-grid__logo .site-title img {
    /* No `display` here: Starlight toggles the off-theme logo with
       `display:none` (.light:sl-hidden / .dark:sl-hidden). Setting display
       would out-specify that and show both logos at once. */
    box-sizing: border-box;
    height: auto !important;
    max-height: 28px !important;
    /* Fixed wordmark size so it never scales when the header is tight
       (logo aspect ~4.5:1 -> 126px at 28px tall). flex-shrink:0 on the column
       above keeps the column from squeezing it. */
    width: 126px !important;
    min-width: 126px !important;
    max-width: 126px !important;
    object-fit: contain;
    object-position: left center;
  }

  /* Tab column: grid row already uses align-items:center; this avoids stretch quirks in some engines. */
  .header-nav-tabs-wrap.header-grid__tabs {
    align-self: center;
  }
</style>

<style is:inline>
  .header-links {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
  }

  /* Single search instance: CSS Grid places one `.header-grid__search` on mobile and desktop */
  .header.header-single-row {
    display: grid;
    align-items: center;
    width: 100%;
    min-height: 38px;
  }

  @media (max-width: 49.999rem) {
    /*
      Global `.header { justify-content: space-between }` is for desktop rows.
      In a column layout it pins the first row to the top and the tab strip to the bottom of the
      nav cell, leaving a large empty band (looks broken next to the hamburger column).
    */
    .header.header-single-row {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      justify-content: flex-start;
    }

    .header-primary-row {
      display: grid;
      align-items: center;
      gap: 1rem;
      width: 100%;
      min-height: 38px;
    }

    .header-nav-tabs-wrap {
      display: none;
    }

    .header-single-row--splash-menu .header-primary-row {
      grid-template-columns: auto 1fr auto auto;
      grid-template-areas: "logo spacer search menu";
    }

    .header-single-row:not(.header-single-row--splash-menu)
      .header-primary-row {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "logo spacer search";
    }

    /* Docs (sidebar): hamburger lives in the header row next to search */
    .header-single-row--has-sidebar:not(.header-single-row--splash-menu)
      .header-primary-row {
      grid-template-columns: auto 1fr auto auto;
      grid-template-areas: "logo spacer search menu";
    }

    .header-single-row--no-search.header-single-row--splash-menu
      .header-primary-row {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "logo spacer menu";
    }

    .header-single-row--no-search:not(.header-single-row--splash-menu)
      .header-primary-row {
      grid-template-columns: auto 1fr;
      grid-template-areas: "logo spacer";
    }

    .header-single-row--no-search.header-single-row--has-sidebar:not(
        .header-single-row--splash-menu
      )
      .header-primary-row {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "logo spacer menu";
    }

    .header-mobile-tab-strip {
      width: 100%;
      min-width: 0;
      padding-top: 0.25rem;
      margin-top: 0.125rem;
      border-top: 1px solid var(--stl-color-border-faint);
    }

    /* Narrow phones: tighter horizontal rhythm so logo + search + strip don’t feel disjointed */
    @media (max-width: 29.999rem) {
      .header-primary-row {
        gap: 0.5rem;
      }

      .header-mobile-tab-strip {
        padding-top: 0.1875rem;
        margin-top: 0.0625rem;
      }
    }

    .header-grid__logo {
      grid-area: logo;
    }
    .header-grid__spacer {
      grid-area: spacer;
      min-width: 0;
    }
    .header-grid__search {
      grid-area: search;
      margin-inline-end: 0.25rem;
      justify-self: end;
    }
    .header-grid__mobile-menu {
      grid-area: menu;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /*
     * Starlight’s MobileMenuToggle uses position:fixed on the button. In the header grid it must sit
     * inline next to search (same row, same band as the 38px search field).
     */
    .header-grid__mobile-menu--docs starlight-menu-button {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .header-grid__mobile-menu--docs starlight-menu-button button {
      position: relative !important;
      top: auto !important;
      inset-inline-end: auto !important;
      left: auto !important;
      right: auto !important;
    }
  }

  @media (min-width: 50rem) {
    :root {
      /* Single row: logo + nav tabs + search/utilities (Figma) */
      --sl-nav-height: 56px;
    }

    header.header {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding-bottom: 0;
    }

    /* Flatten so the outer header grid matches the previous single-level structure */
    .header-primary-row {
      display: contents;
    }

    .header-mobile-tab-strip {
      display: none;
    }

    .header.header-single-row {
      grid-template-columns: auto auto minmax(0, 1fr) auto auto;
      grid-template-areas: "logo tabs spacer search utilities";
      gap: var(--sl-nav-gap);
      min-height: 38px;
    }

    .header-single-row--no-search {
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      grid-template-areas: "logo tabs spacer utilities";
    }

    .header-grid__logo {
      grid-area: logo;
    }
    .header-grid__tabs {
      grid-area: tabs;
      flex-shrink: 0;
      margin-inline-start: 3rem;
      margin-inline-end: var(--sl-nav-gap);
      display: flex;
      align-items: center;
      min-height: 38px;
    }

    .header-grid__tabs :global(.stl-secondary-nav-tabs) {
      display: block;
    }

    .header-grid__spacer {
      grid-area: spacer;
      min-width: 0;
    }

    .header-grid__search {
      grid-area: search;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      justify-self: end;
      min-width: 0;
    }

    .header-grid__mobile-menu {
      display: none;
    }

    .header-grid__utilities {
      grid-area: utilities;
    }

    /* Slightly narrower search bar on smaller desktop to reduce crowding */
    @media (min-width: 50rem) and (max-width: 90rem) {
      .header-grid__search :global(.header-search-bar) {
        max-width: 220px;
      }
    }
  }
</style>

{
  TABS.length === 0 && (
    <style
      is:inline
      set:text={`
        @media (min-width: 50rem) {
          :root {
            --sl-nav-height: 56px;
          }
        }
      `}
    />
  )
}
