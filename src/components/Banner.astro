---
/**
 * Sitewide announcement banner, ported from Timescale-website's AnnouncementBanner
 * (src/components/rebrand/molecules/AnnouncementBanner) - same pixel-dither decoration
 * SVG, same blue "eyeOfTheTiger" theme, same dimensions (verified against their
 * Storybook: 40px tall, 8px vertical padding, 16px/600/24px text, 292x40 decorations).
 * Rendered from Header.astro (not registered as the Starlight `Banner` slot override -
 * that slot lives inside <main>, after the header, which doesn't match "top of the
 * page"). Cancels <header>'s own horizontal gutter padding via negative margin so its
 * background is full-bleed edge to edge; see the `.tiger-banner` margin rule below.
 */
import * as C from "@constants";
import { bannerDecorationPaths } from "./BannerDecoration";

const BG = "#4B7BFF"; // eyeOfTheTiger-500
const DECORATION_FILL = "#3C62CC"; // eyeOfTheTiger-600
const TEXT_COLOR = "#FFFFFF";

const LINK =
  "https://www.tigerdata.com/blog/timescaledb-enterprise-is-in-public-beta";
---

<div
  class="tiger-banner"
  style={`--banner-bg: ${BG}; --banner-fg: ${TEXT_COLOR}; --banner-decoration: ${DECORATION_FILL}`}
>
  <svg
    class="tiger-banner__decoration tiger-banner__decoration--left"
    xmlns="http://www.w3.org/2000/svg"
    width="292"
    height="40"
    viewBox="0 0 292 40"
    fill="none"
    aria-hidden="true"
    shape-rendering="crispEdges"
    preserveAspectRatio="xMinYMid slice"
    set:html={bannerDecorationPaths}
  />
  <svg
    class="tiger-banner__decoration tiger-banner__decoration--right"
    xmlns="http://www.w3.org/2000/svg"
    width="292"
    height="40"
    viewBox="0 0 292 40"
    fill="none"
    aria-hidden="true"
    shape-rendering="crispEdges"
    preserveAspectRatio="xMinYMid slice"
    set:html={bannerDecorationPaths}
  />

  <a
    class="tiger-banner__link"
    href={LINK}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="tiger-banner__text">
      {C.TIMESCALE_DB}
      {C.ENTERPRISE} public beta is here. Your infrastructure. Our database expertise.
      <span class="tiger-banner__cta">See what's new</span>
    </span>
    <svg
      class="tiger-banner__arrow"
      width="20"
      height="20"
      viewBox="0 0 256 256"
      aria-hidden="true"
    >
      <path
        d="M221.66 133.66l-72 72a8 8 0 0 1-11.32-11.32L196.69 136H40a8 8 0 0 1 0-16h156.69l-58.35-58.34a8 8 0 0 1 11.32-11.32l72 72a8 8 0 0 1 0 11.32Z"
        fill="currentColor"></path>
    </svg>
  </a>
</div>

<style>
  .tiger-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 40px;
    flex-shrink: 0;
    padding: 0.5rem 0;
    margin-bottom: 0.5rem;
    background-color: var(--banner-bg);
    color: var(--banner-fg);

    /* <header> (outside this component) applies this same gutter as padding to its own
       content box, which insets this banner along with it since it's a direct child.
       Cancel it so the banner's background is full-bleed edge to edge, matching
       <header>'s own `margin-left/right: calc(-1 * gutter)` trick on itself. */
    margin-left: calc(-1 * var(--stl-page-gutter-left, 0px));
    margin-right: calc(-1 * var(--stl-page-gutter-right, 0px));
  }

  /* On mobile, PageFrame's raw <header> wrapper (outside this component, not under
     src/components) becomes a CSS grid (subgrid columns) and gives its other direct
     child (`.header`) an explicit `grid-column: span 2` to span both. This banner is a
     sibling of that same child, so without the same rule it falls into grid
     auto-placement and collapses to a near-zero-width cell instead of spanning full
     width. */
  @media not (min-width: 50rem) {
    .tiger-banner {
      grid-column: 1 / -1;
    }
  }

  .tiger-banner__decoration {
    position: absolute;
    top: 0;
    height: 100%;
    width: auto;
    color: var(--banner-decoration);
  }

  .tiger-banner__decoration :global(path) {
    fill: currentColor;
  }

  .tiger-banner__decoration--left {
    left: 0;
  }

  .tiger-banner__decoration--right {
    right: 0;
    transform: rotate(180deg);
  }

  .tiger-banner__decoration--right {
    display: none;
  }
  @media (min-width: 64rem) {
    .tiger-banner__decoration--right {
      display: block;
    }
  }

  .tiger-banner__link {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.5rem;
    max-width: 90%;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .tiger-banner__text {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
    text-align: center;
    text-wrap: balance;
  }

  .tiger-banner__arrow {
    flex-shrink: 0;
  }

  .tiger-banner__cta {
    text-decoration: underline;
  }
</style>
