---
/**
 * Custom PageTitle that uses Figma-styled breadcrumbs (Breadcrumbs.astro) with
 * clickable links and "/" separators. Keeps Starlight title and description.
 * DocMarkdownActions: Copy Markdown + Open in Claude / ChatGPT / Cursor (when page has .md route).
 */
import { RENDER_PAGE_DESCRIPTIONS } from "virtual:stl-docs-virtual-module";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import Default from "@astrojs/starlight/components/PageTitle.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import PageLabels from "./PageLabels.astro";
import DocMarkdownActions from "./DocMarkdownActions.tsx";

function sidebarHasEntry(
  sidebarEntry: StarlightRouteData["sidebar"],
  currentPath?: string
) {
  if (!currentPath) return false;
  const normalizePath = (path: string) =>
    path.endsWith("/") ? path : path + "/";
  const normalizedCurrent = normalizePath(currentPath);
  for (const entry of sidebarEntry) {
    if (entry.type === "link") {
      if (normalizePath(entry.href) === normalizedCurrent) return true;
    } else if (entry.type === "group") {
      if (sidebarHasEntry(entry.entries, currentPath)) return true;
    }
  }
  return false;
}

const entryTemplate = Astro.locals.starlightRoute?.entry?.data?.template;
const isSplashPage = entryTemplate === "splash";
const skipRenderingStarlightTitle =
  isSplashPage ||
  (Astro.locals._stlStarlightPage?.skipRenderingStarlightTitle ?? false);
const hasMarkdownRoute =
  Astro.locals._stlStarlightPage?.hasMarkdownRoute ?? true;
const currentPath = Astro.url.pathname;

/** Split “Copy Markdown” + Open in Claude / ChatGPT / Cursor (same UX as Stainless docs). */
function shouldShowDocMarkdownActions() {
  if (!sidebarHasEntry(Astro.locals.starlightRoute.sidebar, currentPath))
    return false;
  if (!hasMarkdownRoute) return false;
  return true;
}

const showDocMarkdownActions = shouldShowDocMarkdownActions();

/** Stainless maps each page to …/index.md (see build log: path/index.html → path/index.md). */
const pathnameNorm = currentPath.replace(/\/$/, "") || "/";
const slug =
  pathnameNorm === "/" ? "" : pathnameNorm.replace(/^\//, "");
const markdownRelative = slug === "" ? "index.md" : `${slug}/index.md`;
const markdownUrl = new URL(
  markdownRelative,
  Astro.url.origin.endsWith("/") ? Astro.url.origin : `${Astro.url.origin}/`
).href;
const pageUrlForActions = Astro.url.href.split("#")[0];
const description = Astro.locals.starlightRoute.entry.data.description;
const shouldRenderDescription = RENDER_PAGE_DESCRIPTIONS;
---

{
  skipRenderingStarlightTitle ? null : (
    <>
      <div
        class="stl-ui-not-prose stl-page-nav-container stl-prose-page-nav-container stl-page-nav-container--with-actions"
        data-pagefind-ignore
      >
        <Breadcrumbs
          currentPath={currentPath}
          sidebarEntry={Astro.locals.starlightRoute.sidebar}
        />
        {showDocMarkdownActions && (
          <DocMarkdownActions
            client:load
            markdownUrl={markdownUrl}
            pageUrl={pageUrlForActions}
          />
        )}
      </div>
      <Default />
      <PageLabels />
      {!!description && shouldRenderDescription && (
        <p class="description">{description}</p>
      )}
    </>
  )
}

<style>
  p.description {
    font-size: var(--stl-typography-scale-xl);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.02em;
    margin-top: 0.4em;
  }
</style>

<style is:global>
  @layer starlight.core {
    /* Tighter vertical gap: breadcrumb row → page H1 */
    .stl-page-nav-container.stl-prose-page-nav-container {
      margin-block-end: 0.375rem;
      padding-block-end: 0;
    }
    .stl-page-nav-container--with-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem 1rem;
    }
    .stl-page-nav-container--with-actions .breadcrumbs {
      flex: 1 1 auto;
      min-width: 0;
    }
    .stl-page-nav-container + h1#_top,
    .stl-page-nav-container ~ h1#_top {
      margin-top: 1.125rem !important;
    }
    /* Prose column: title H1 after breadcrumb */
    main [class*="content-panel"] .stl-page-nav-container ~ .l-markdown-content > h1#_top:first-child,
    main [class*="content-panel"] .stl-page-nav-container ~ .sl-markdown-content > h1#_top:first-child {
      margin-top: 1.125rem !important;
    }
  }
</style>
