---
/**
 * AuthorByline – compact author card for tutorials (avatar, name, role, links).
 * Renders a horizontal bar: avatar | name, role, GitHub · Email · LinkedIn.
 *
 * Usage in MDX:
 *   import AuthorByline from "@components/AuthorByline.astro";
 *   <AuthorByline
 *     name="Jane Doe"
 *     role="Developer Experience Engineer"
 *     githubUsername="janedoe"
 *     email="jane@example.com"
 *     linkedinUrl="https://linkedin.com/in/janedoe"
 *   />
 *
 * Optional: pass avatarUrl to override the default GitHub avatar URL.
 */
export interface Props {
  /** Author display name */
  name: string;
  /** Role or job title */
  role: string;
  /** GitHub username (used for avatar and profile link) */
  githubUsername: string;
  /** Email address (mailto link) */
  email?: string;
  /** LinkedIn profile URL (e.g. https://linkedin.com/in/username) */
  linkedinUrl?: string;
  /** Optional: override avatar image URL (default: GitHub avatar from githubUsername) */
  avatarUrl?: string;
}

const { name, role, githubUsername, email, linkedinUrl, avatarUrl } = Astro.props;
const avatar = avatarUrl ?? `https://avatars.githubusercontent.com/${githubUsername}?s=64`;
const githubUrl = `https://github.com/${githubUsername}`;
---

<div class="author-byline">
  <img
    class="author-byline__avatar"
    src={avatar}
    alt=""
    width="40"
    height="40"
  />
  <div class="author-byline__content">
    <p class="author-byline__name">{name}</p>
    <p class="author-byline__role">{role}</p>
    <p class="author-byline__links">
      <a class="author-byline__link" href={githubUrl}>GitHub</a>
      {email && (
        <><span class="author-byline__sep" aria-hidden="true">·</span>
        <a class="author-byline__link" href={`mailto:${email}`}>Email</a></>
      )}
      {linkedinUrl && (
        <><span class="author-byline__sep" aria-hidden="true">·</span>
        <a class="author-byline__link" href={linkedinUrl}>LinkedIn</a></>
      )}
    </p>
  </div>
</div>

<style>
  .author-byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem 0;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid light-dark(#e2e8f0, #475569);
    background: light-dark(#f1f5f9, #334155);
    font-size: 0.875rem;
    color: light-dark(#1e293b, #e2e8f0);
  }

  .author-byline__avatar {
    border-radius: 50%;
    flex-shrink: 0;
    display: block;
  }

  .author-byline__content {
    min-width: 0;
    flex: 1;
  }

  .author-byline__name {
    margin: 0;
    font-weight: 600;
    font-size: 0.9375rem;
    color: inherit;
    line-height: 1.3;
  }

  .author-byline__role {
    margin: 0.0625rem 0 0 0;
    font-size: 0.8125rem;
    color: light-dark(#64748b, #94a3b8);
    line-height: 1.3;
  }

  .author-byline__links {
    margin: 0.25rem 0 0 0;
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    line-height: 1.4;
  }

  .author-byline__link {
    color: light-dark(#2563eb, #93c5fd);
  }

  .author-byline__link:hover {
    text-decoration: underline;
  }

  .author-byline__sep {
    color: light-dark(#64748b, #94a3b8);
  }
</style>
