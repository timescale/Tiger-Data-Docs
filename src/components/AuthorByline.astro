---
/**
 * AuthorByline – compact author card for tutorials (avatar, name, role, links).
 * Renders a horizontal bar: avatar | name, role, GitHub · Email · LinkedIn.
 *
 * Usage in MDX:
 *   import AuthorByline from "@components/AuthorByline.astro";
 *   <AuthorByline
 *     name="Jane Doe"
 *     role="Developer Experience Engineer"
 *     githubUsername="janedoe"
 *     email="jane@example.com"
 *     linkedinUrl="https://linkedin.com/in/janedoe"
 *   />
 *
 * Optional: pass avatarUrl to override the default GitHub avatar URL.
 */
export interface Props {
  /** Author display name */
  name: string;
  /** Role or job title */
  role: string;
  /** GitHub username (used for avatar and profile link) */
  githubUsername: string;
  /** Email address (mailto link) */
  email?: string;
  /** LinkedIn profile URL (e.g. https://linkedin.com/in/username) */
  linkedinUrl?: string;
  /** Optional: override avatar image URL (default: GitHub avatar from githubUsername) */
  avatarUrl?: string;
}

const { name, role, githubUsername, email, linkedinUrl, avatarUrl } = Astro.props;
const avatar = avatarUrl ?? `https://avatars.githubusercontent.com/${githubUsername}?s=128`;
const githubUrl = `https://github.com/${githubUsername}`;
---

<div class="author-byline">
  <img
    class="author-byline__avatar"
    src={avatar}
    alt=""
    width="56"
    height="56"
  />
  <div class="author-byline__content">
    <p class="author-byline__name">{name}</p>
    <p class="author-byline__role">{role}</p>
    <p class="author-byline__links">
      <a class="author-byline__link" href={githubUrl}>GitHub</a>
      {email && (
        <><span class="author-byline__sep" aria-hidden="true">·</span>
        <a class="author-byline__link" href={`mailto:${email}`}>Email</a></>
      )}
      {linkedinUrl && (
        <><span class="author-byline__sep" aria-hidden="true">·</span>
        <a class="author-byline__link" href={linkedinUrl}>LinkedIn</a></>
      )}
    </p>
  </div>
</div>

<style>
  /* Author card: full-width bar with larger avatar. Uses Tiger design tokens. */
  .author-byline {
    display: flex;
    align-items: center;
    gap: var(--tiger-space-md);
    width: 100%;
    margin: 0 0 var(--tiger-space-lg) 0;
    padding: var(--tiger-space-md) var(--tiger-space-lg);
    border-radius: var(--tiger-radius-md);
    border: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    background: light-dark(var(--tiger-grey-50), var(--tiger-grey-800));
    font-family: var(--stl-font-family);
    font-size: 0.875rem;
    line-height: 1.4;
    color: light-dark(var(--tiger-grey-900), var(--tiger-grey-100));
  }

  .author-byline__avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    flex-shrink: 0;
    display: block;
    object-fit: cover;
  }

  .author-byline__content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--tiger-space-xs);
  }

  .author-byline__name {
    margin: 0;
    font-weight: 600;
    font-size: 0.9375rem;
    color: inherit;
    line-height: 1.3;
  }

  .author-byline__role {
    margin: 0;
    font-size: 0.8125rem;
    color: light-dark(var(--tiger-grey-600), var(--tiger-grey-400));
    line-height: 1.3;
  }

  .author-byline__links {
    margin: 0;
    padding-top: var(--tiger-space-xs);
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--tiger-space-sm);
    line-height: 1.4;
  }

  .author-byline__link {
    color: var(--stl-color-accent);
  }

  .author-byline__link:hover {
    text-decoration: underline;
  }

  .author-byline__sep {
    color: light-dark(var(--tiger-grey-400), var(--tiger-grey-500));
    user-select: none;
  }
</style>
