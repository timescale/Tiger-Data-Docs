---
/**
 * Renders tab dropdown nodes. Nested `children` are only used if the tree includes them (header nav uses top-level sections only).
 */
import type { NavTreeNode } from "./nav-dropdown-tree-types";
import NavDropdownSubtree from "./NavDropdownTree.astro";

interface Props {
  nodes: NavTreeNode[];
  depth?: number;
}

const { nodes, depth = 0 } = Astro.props as Props;

function isExternal(href: string) {
  return href.startsWith("http");
}
---

{
  nodes.map((node) =>
    node.kind === "link" ? (
      <a
        href={node.href}
        class:list={["nav-dropdown-item", "nav-dropdown-item--leaf", depth > 0 && "nav-dropdown-item--nested"]}
        role="menuitem"
        style={`--nav-depth: ${depth}`}
        target={isExternal(node.href) ? "_blank" : undefined}
        rel={isExternal(node.href) ? "noopener noreferrer" : undefined}
      >
        <span class="nav-dropdown-item-title">
          {node.label}
          {isExternal(node.href) && (
            <svg
              class="nav-dropdown-item-external-icon"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          )}
        </span>
      </a>
    ) : (
      <div
        class:list={["nav-dropdown-section", depth > 0 && "nav-dropdown-section--nested"]}
        role="none"
        style={`--nav-depth: ${depth}`}
      >
        {node.href ? (
          <a href={node.href} class="nav-dropdown-section-heading nav-dropdown-section-heading--link" role="menuitem">
            {node.label}
          </a>
        ) : (
          <span class="nav-dropdown-section-heading">{node.label}</span>
        )}
        {node.children.length > 0 ? (
          <div class="nav-dropdown-section-children">
            <NavDropdownSubtree nodes={node.children} depth={depth + 1} />
          </div>
        ) : null}
      </div>
    )
  )
}

<style>
  .nav-dropdown-section {
    --nav-depth: 0;
    padding-top: 4px;
    padding-bottom: 2px;
  }

  .nav-dropdown-section--nested {
    padding-left: calc(10px + min(var(--nav-depth, 1), 6) * 10px);
    border-left: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    margin-left: 10px;
    margin-bottom: 2px;
  }

  .nav-dropdown-section-heading {
    display: block;
    padding: 8px 14px 6px;
    font-weight: 700;
    font-size: 0.875rem;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: light-dark(var(--tiger-grey-700), var(--tiger-grey-200));
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .nav-dropdown-section-heading--link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--tiger-radius-sm, 6px);
    transition: background 0.12s ease;
  }

  .nav-dropdown-section-heading--link:hover {
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-800));
    color: var(--stl-color-accent, var(--tiger-vivid-purple));
  }

  .nav-dropdown-section-children {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nav-dropdown-item--leaf {
    --nav-depth: 0;
    display: block;
    padding: 8px 14px;
    padding-left: calc(14px + min(var(--nav-depth, 1), 8) * 12px);
    color: inherit;
    text-decoration: none;
    transition: background 0.12s ease;
    overflow: visible;
  }

  .nav-dropdown-item--nested {
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .nav-dropdown-item--leaf .nav-dropdown-item-title {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .nav-dropdown-item--leaf:hover {
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-800));
  }

  .nav-dropdown-item-external-icon {
    display: inline-block;
    margin-left: 4px;
    vertical-align: -1px;
    opacity: 0.7;
  }
</style>
