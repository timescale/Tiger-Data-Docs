---
/**
 * Integrate overview: search bar + dropdown filters + flat card grid.
 * Filter dimensions: Type of Tool, Industry, Platform, First Party/Third Party, Technology.
 * Relies on frontmatter: integrationCategory, integrationIndustry[], integrationPlatforms[], connectorType, keywords[],
 * integrationHideFromOverviewCards (omit from card grid only; sidebar unchanged).
 */
import { getEntry } from "astro:content";

import {
  INTEGRATION_TECHNOLOGY_KEYS,
  resolveIntegrationTechnologies,
  type IntegrationTechnologyKey
} from "../lib/integration-technologies";

/** Static image import shape from Vite/Astro (`import logo from '...'`). */
type CardLogoImport = {
  src: string;
  width: number;
  height: number;
};

/** Optional raster logos (SVG default imports differ; use PNG/WebP for cards). */
const cardLogoModules = import.meta.glob<{ default: CardLogoImport }>(
  "../assets/images/integrate/card-logos/**/*.{png,jpg,jpeg,webp}",
  { eager: true }
);

function resolveCardLogo(
  filename: string | undefined
): CardLogoImport | undefined {
  if (!filename?.trim()) return undefined;
  const normalized = filename.trim().replace(/^\.?\//, "");
  for (const path of Object.keys(cardLogoModules)) {
    if (path.endsWith(normalized)) return cardLogoModules[path].default;
  }
  return undefined;
}

/** Deterministic badge colors for placeholder initials (no gradient strip on cards). */
const INTEGRATION_BADGE_PALETTE: { bg: string; fg: string }[] = [
  { bg: "#FF9900", fg: "#ffffff" },
  { bg: "#E67E22", fg: "#ffffff" },
  { bg: "#1E3A5F", fg: "#FF9900" },
  { bg: "#0073BB", fg: "#ffffff" },
  { bg: "#111111", fg: "#ffffff" },
  { bg: "#146EB4", fg: "#ffffff" },
  { bg: "#5B2C83", fg: "#ffffff" },
  { bg: "#0D9488", fg: "#ffffff" }
];

function badgeColorsForSlug(slug: string): { bg: string; fg: string } {
  let h = 0;
  for (let i = 0; i < slug.length; i++) {
    h = (h * 31 + slug.charCodeAt(i)) >>> 0;
  }
  return INTEGRATION_BADGE_PALETTE[h % INTEGRATION_BADGE_PALETTE.length];
}

const pathMap = import.meta.glob("../content/docs/integrate/**/*.mdx");
const indexSlug = "integrate/index";
const findConnectionSlug = "integrate/find-connection-details";

function pathToSlug(filePath: string): string {
  const normalized = filePath.replace(/\\/g, "/");
  const i = normalized.indexOf("integrate/");
  if (i === -1) return "";
  return normalized.slice(i).replace(/\.mdx$/, "");
}

const allSlugs = Object.keys(pathMap)
  .map(pathToSlug)
  .filter(Boolean)
  .filter(
    (slug) =>
      slug !== indexSlug &&
      slug !== findConnectionSlug &&
      !slug.endsWith("/index")
  );

const PLATFORM_LABELS: Record<string, string> = {
  aws: "Tiger Cloud on AWS",
  azure: "Tiger Cloud on Azure",
  "self-hosted": "Self-Hosted"
};
const PLATFORM_ORDER = ["aws", "azure", "self-hosted"] as const;
type PlatformSlug = (typeof PLATFORM_ORDER)[number];

type DocData = {
  title: string;
  description?: string;
  integrationCategory?: string;
  integrationIndustry?: string[];
  connectorType?: "tiger-data" | "external";
  sortOrder?: number;
  integrationCardTitle?: string;
  integrationPlatforms?: PlatformSlug[];
  keywords?: string[];
  integrationCardLogo?: string;
  integrationCardLogoDark?: string;
  integrationCardLogoAlt?: string;
  integrationCardInitials?: string;
  integrationHideFromOverviewCards?: boolean;
  integrationTechnologies?: IntegrationTechnologyKey[];
};

function cardInitials(data: DocData, displayTitle: string): string {
  if (data.integrationCardInitials?.trim()) {
    return data.integrationCardInitials.trim().slice(0, 4);
  }
  const stripped = displayTitle.replace(/\s+and Tiger Data\s*$/i, "").trim();
  const words = stripped.split(/[\s/&]+/).filter(Boolean);
  if (words.length >= 2) {
    return (words[0].charAt(0) + words[1].charAt(0)).toUpperCase();
  }
  if (words.length === 1 && words[0].length >= 2) {
    return words[0].slice(0, 2).toUpperCase();
  }
  return (stripped.slice(0, 2) || "?").toUpperCase();
}

function cardTitle(data: DocData): string {
  if (data.integrationCardTitle) {
    return `${data.integrationCardTitle} and Tiger Data`;
  }
  const t = data.title ?? "";
  const withMatch = t.match(
    /^Integrate (.+?) (?:with|and) Tiger (?:Cloud|Data)$/i
  );
  if (withMatch) return `${withMatch[1]} and Tiger Data`;
  const connectMatch = t.match(/^Connect (.+?) to Tiger (?:Cloud|Data)$/i);
  if (connectMatch) return `${connectMatch[1]} and Tiger Data`;
  const connectWithMatch = t.match(
    /^Connect to Tiger (?:Cloud|Data) with (.+)$/i
  );
  if (connectWithMatch) return `${connectWithMatch[1]} and Tiger Data`;
  if (t && !/Tiger (?:Cloud|Data)/i.test(t)) return `${t} and Tiger Data`;
  return (t || "Integration").replace(/Tiger Cloud/gi, "Tiger Data");
}

const entries: { slug: string; data: DocData }[] = [];
for (const slug of allSlugs) {
  try {
    const entry = await getEntry("docs", slug);
    if (entry && "data" in entry && entry.data) {
      const d = entry.data as DocData;
      entries.push({
        slug,
        data: {
          title: d.title ?? slug.split("/").pop() ?? "Integration",
          description: d.description,
          integrationCategory: d.integrationCategory,
          integrationIndustry: d.integrationIndustry,
          connectorType: d.connectorType,
          sortOrder: d.sortOrder,
          integrationCardTitle: d.integrationCardTitle,
          integrationPlatforms: d.integrationPlatforms ?? ["aws"],
          keywords: d.keywords ?? [],
          integrationTechnologies: d.integrationTechnologies,
          integrationCardLogo: d.integrationCardLogo,
          integrationCardLogoDark: d.integrationCardLogoDark,
          integrationCardLogoAlt: d.integrationCardLogoAlt,
          integrationCardInitials: d.integrationCardInitials,
          integrationHideFromOverviewCards: d.integrationHideFromOverviewCards === true
        }
      });
    }
  } catch {
    // Skip entries that don't exist or fail
  }
}

// Sort entries alphabetically by display title
entries.sort((a, b) => cardTitle(a.data).localeCompare(cardTitle(b.data)));

/** Pages shown as cards on /integrate (sidebar and direct URLs still list all integrate pages). */
const cardEntries = entries.filter((e) => !e.data.integrationHideFromOverviewCards);

// --- Filter: Type of Tool (integrationCategory) ---
const CATEGORY_LABELS: Record<string, string> = {
  "data-engineering-etl": "Data Engineering & ETL",
  "bi-vizualization": "BI & Visualization",
  "data-ingestion-streaming": "Data Ingestion & Streaming",
  connectors: "Connectors",
  code: "Code & Libraries",
  "query-administration": "Query & Administration",
  "secure-connectivity": "Secure Connectivity",
  "observability-alerting": "Observability & Alerting",
  "configuration-deployment": "Configuration & Deployment"
};
const CATEGORY_ORDER = [
  "data-engineering-etl",
  "bi-vizualization",
  "data-ingestion-streaming",
  "connectors",
  "code",
  "query-administration",
  "secure-connectivity",
  "observability-alerting",
  "configuration-deployment"
];
function getCategoryLabel(slug: string): string {
  return (
    CATEGORY_LABELS[slug] ??
    slug
      .split("-")
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" ")
  );
}
const uniqueCategories = CATEGORY_ORDER.filter((cat) =>
  cardEntries.some((e) => e.data.integrationCategory === cat)
);

// --- Filter: Industry ---
const INDUSTRY_LABELS: Record<string, string> = {
  "oil-and-gas": "Oil and Gas",
  iot: "IoT",
  energy: "Energy",
  crypto: "Crypto",
  healthcare: "Healthcare",
  manufacturing: "Manufacturing"
};
function normalizeIndustryKey(raw: string): string {
  const k = raw.trim().toLowerCase().replace(/\s+/g, "-");
  if (k === "oilandgas") return "oil-and-gas";
  return k;
}
const INDUSTRY_ORDER = [
  "oil-and-gas",
  "iot",
  "energy",
  "crypto",
  "healthcare",
  "manufacturing"
];
const uniqueIndustries = INDUSTRY_ORDER.filter((ind) =>
  cardEntries.some((e) =>
    (e.data.integrationIndustry ?? []).map(normalizeIndustryKey).includes(ind)
  )
);

// --- Filter: Platform ---
function getPlatforms(data: DocData): PlatformSlug[] {
  const p = data.integrationPlatforms ?? ["aws"];
  return PLATFORM_ORDER.filter((key) => p.includes(key));
}

// --- Filter: First Party / Third Party ---
function getPartyType(data: DocData): string {
  if (data.integrationCategory === "connectors") return "first-party";
  return "third-party";
}

// --- Filter: Technology (keywords + optional integrationTechnologies; see src/lib/integration-technologies.ts) ---
function getTechnologies(data: DocData): string[] {
  return resolveIntegrationTechnologies(
    data.integrationTechnologies,
    data.keywords
  );
}
const uniqueTechnologies = INTEGRATION_TECHNOLOGY_KEYS.filter((tech) =>
  cardEntries.some((e) => getTechnologies(e.data).includes(tech))
);

function slugToHref(slug: string): string {
  return "/" + slug;
}

/** Splash template hides the default Starlight title; show title + description in this panel. */
const routeEntry = Astro.locals.starlightRoute?.entry;
const headerTitle = routeEntry?.data?.title ?? "Integrate";
const headerDescription = routeEntry?.data?.description;
---

<div class="integrate-overview not-content" id="integrate-overview-root">
  <header class="integrate-header" aria-labelledby="integrate-overview-heading">
    <h1 class="integrate-header__title" id="integrate-overview-heading">
      {headerTitle}
    </h1>
    {
      headerDescription ? (
        <p class="integrate-header__description">{headerDescription}</p>
      ) : null
    }
  </header>

  <!-- Search bar -->
  <div class="integrate-search-wrapper">
    <svg
      class="integrate-search-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      width="18"
      height="18"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="text"
      class="integrate-search-input"
      id="integrate-search"
      placeholder="Search by tool or keyword..."
      autocomplete="off"
    />
  </div>

  <!-- Filter dropdowns -->
  <div class="integrate-filters" id="integrate-filters">
    <!-- Type of Tool -->
    <div class="integrate-filter-group" data-filter-key="category">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>Type of Tool</span>
        <svg
          class="integrate-filter-chevron"
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3 4.5L6 7.5L9 4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        {
          uniqueCategories.map((cat) => (
            <label class="integrate-filter-option">
              <input type="checkbox" value={cat} data-filter-check="category" />
              <span>{getCategoryLabel(cat)}</span>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Industry -->
    <div class="integrate-filter-group" data-filter-key="industry">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>Industry</span>
        <svg
          class="integrate-filter-chevron"
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3 4.5L6 7.5L9 4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        {
          uniqueIndustries.map((ind) => (
            <label class="integrate-filter-option">
              <input type="checkbox" value={ind} data-filter-check="industry" />
              <span>{INDUSTRY_LABELS[ind] ?? ind}</span>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Platform -->
    <div class="integrate-filter-group" data-filter-key="platform">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>Platform</span>
        <svg
          class="integrate-filter-chevron"
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3 4.5L6 7.5L9 4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        {
          PLATFORM_ORDER.map((key) => (
            <label class="integrate-filter-option">
              <input type="checkbox" value={key} data-filter-check="platform" />
              <span>{PLATFORM_LABELS[key]}</span>
            </label>
          ))
        }
      </div>
    </div>

    <!-- First Party / Third Party -->
    <div class="integrate-filter-group" data-filter-key="party">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>First Party/Third Party</span>
        <svg
          class="integrate-filter-chevron"
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3 4.5L6 7.5L9 4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        <label class="integrate-filter-option">
          <input
            type="checkbox"
            value="first-party"
            data-filter-check="party"
          />
          <span>First Party</span>
        </label>
        <label class="integrate-filter-option">
          <input
            type="checkbox"
            value="third-party"
            data-filter-check="party"
          />
          <span>Third Party</span>
        </label>
      </div>
    </div>

    <!-- Technology -->
    <div class="integrate-filter-group" data-filter-key="technology">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>Technology</span>
        <svg
          class="integrate-filter-chevron"
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3 4.5L6 7.5L9 4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        {
          uniqueTechnologies.map((tech) => (
            <label class="integrate-filter-option">
              <input
                type="checkbox"
                value={tech}
                data-filter-check="technology"
              />
              <span>{tech}</span>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Clear filters -->
    <button
      type="button"
      class="integrate-clear-filters"
      id="integrate-clear-filters"
      hidden
    >
      Clear filters
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <path
          d="M9 5L5 9M5 5L9 9"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- No results message -->
  <p class="integrate-no-results" id="integrate-no-results" hidden>
    No integrations match your current filters. Try broadening your search.
  </p>

  <!-- Cards grid -->
  <div class="integrate-cards-grid" id="integrate-cards-grid">
    {
      cardEntries.map(({ slug, data }) => {
        const platforms = getPlatforms(data);
        const party = getPartyType(data);
        const technologies = getTechnologies(data);
        const title = cardTitle(data);
        const logoLight = resolveCardLogo(data.integrationCardLogo);
        const logoDark = resolveCardLogo(data.integrationCardLogoDark);
        const hasLogo = !!logoLight;
        const hasDualLogo = !!logoLight && !!logoDark;
        const logoAlt =
          data.integrationCardLogoAlt?.trim() ||
          title.replace(/\s+and Tiger Data\s*$/i, "").trim() ||
          title;
        return (
          <a
            href={slugToHref(slug)}
            class="integrate-card"
            data-category={data.integrationCategory ?? ""}
            data-industries={(data.integrationIndustry ?? [])
              .map(normalizeIndustryKey)
              .join(",")}
            data-platforms={platforms.join(",")}
            data-party={party}
            data-technologies={technologies.join(",")}
            data-search-text={`${title} ${data.description ?? ""} ${(data.keywords ?? []).join(" ")}`.toLowerCase()}
          >
            <div class="integrate-card-body">
              {hasLogo && (
                <span class="integrate-card-logo-wrap" role="img" aria-label={logoAlt}>
                  <img
                    src={logoLight!.src}
                    alt=""
                    width={48}
                    height={48}
                    class:list={["integrate-card-logo-img", { "integrate-card-logo-light-only": hasDualLogo }]}
                    loading="lazy"
                    decoding="async"
                  />
                  {hasDualLogo && (
                    <img
                      src={logoDark!.src}
                      alt=""
                      width={48}
                      height={48}
                      class="integrate-card-logo-img integrate-card-logo-dark-only"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </span>
              )}
              <span class="integrate-card-tag">
                {getCategoryLabel(data.integrationCategory ?? "")}
              </span>
              <h3 class="integrate-card-title">{title}</h3>
              {data.description && (
                <p class="integrate-card-desc">{data.description}</p>
              )}
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<script>
  /**
   * Search + filters must bind on `astro:page-load`: the bundled module runs once on first load,
   * so client navigations to /integrate never ran the old top-level code (empty NodeLists).
   */
  const FILTER_KEYS = [
    "category",
    "industry",
    "platform",
    "party",
    "technology"
  ];

  let integrateOutsideClickBound = false;

  function closeAllIntegrateFilterPanels() {
    document
      .querySelectorAll("#integrate-overview-root .integrate-filter-group")
      .forEach((g) => {
        const b = g.querySelector(".integrate-filter-btn");
        const p = g.querySelector(".integrate-filter-panel");
        if (b) b.setAttribute("aria-expanded", "false");
        if (p) p.hidden = true;
      });
  }

  function initIntegrateOverview() {
    const root = document.getElementById("integrate-overview-root");
    if (!root || root.dataset.integrateBound === "1") return;
    root.dataset.integrateBound = "1";

    const searchInput = root.querySelector("#integrate-search");
    const clearBtn = root.querySelector("#integrate-clear-filters");
    const noResults = root.querySelector("#integrate-no-results");
    const cards = root.querySelectorAll(
      "#integrate-cards-grid .integrate-card"
    );
    const filterGroups = root.querySelectorAll(".integrate-filter-group");
    const allCheckboxes = root.querySelectorAll("[data-filter-check]");

    if (!searchInput || filterGroups.length === 0) {
      delete root.dataset.integrateBound;
      return;
    }

    function getActiveFilters() {
      /** @type {Record<string, string[]>} */
      const filters = {};
      allCheckboxes.forEach((cb) => {
        if (cb.checked) {
          const key = cb.getAttribute("data-filter-check") ?? "";
          if (!filters[key]) filters[key] = [];
          filters[key].push(cb.value);
        }
      });
      return filters;
    }

    function applyFilters() {
      const filters = getActiveFilters();
      const query = (searchInput.value ?? "").trim().toLowerCase();
      const hasFilters = Object.keys(filters).length > 0 || query.length > 0;
      if (clearBtn) clearBtn.hidden = !hasFilters;

      filterGroups.forEach((group) => {
        const key = group.getAttribute("data-filter-key") ?? "";
        const btn = group.querySelector(".integrate-filter-btn");
        const count = (filters[key] ?? []).length;
        if (btn)
          btn.classList.toggle("integrate-filter-btn--active", count > 0);
      });

      let visibleCount = 0;
      cards.forEach((card) => {
        let show = true;

        if (query) {
          const text = card.getAttribute("data-search-text") ?? "";
          if (!text.includes(query)) show = false;
        }

        if (show && filters["category"]?.length) {
          const cat = card.getAttribute("data-category") ?? "";
          if (!filters["category"].includes(cat)) show = false;
        }

        if (show && filters["industry"]?.length) {
          const industries = (card.getAttribute("data-industries") ?? "")
            .split(",")
            .filter(Boolean);
          if (!filters["industry"].some((f) => industries.includes(f)))
            show = false;
        }

        if (show && filters["platform"]?.length) {
          const platforms = (card.getAttribute("data-platforms") ?? "")
            .split(",")
            .filter(Boolean);
          if (!filters["platform"].some((f) => platforms.includes(f)))
            show = false;
        }

        if (show && filters["party"]?.length) {
          const party = card.getAttribute("data-party") ?? "";
          if (!filters["party"].includes(party)) show = false;
        }

        if (show && filters["technology"]?.length) {
          const techs = (card.getAttribute("data-technologies") ?? "")
            .split(",")
            .filter(Boolean);
          if (!filters["technology"].some((f) => techs.includes(f)))
            show = false;
        }

        /* Use a class, not [hidden], so scoped .integrate-card { display: flex } cannot override hiding */
        card.classList.toggle("integrate-card--filtered-out", !show);
        if (show) visibleCount++;
      });

      if (noResults) noResults.hidden = visibleCount > 0;
    }

    filterGroups.forEach((group) => {
      const btn = group.querySelector(".integrate-filter-btn");
      const panel = group.querySelector(".integrate-filter-panel");
      if (!btn || !panel) return;
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = btn.getAttribute("aria-expanded") === "true";
        filterGroups.forEach((g) => {
          const b = g.querySelector(".integrate-filter-btn");
          const p = g.querySelector(".integrate-filter-panel");
          if (b) b.setAttribute("aria-expanded", "false");
          if (p) p.hidden = true;
        });
        if (!isOpen) {
          btn.setAttribute("aria-expanded", "true");
          panel.hidden = false;
        }
      });
    });

    if (!integrateOutsideClickBound) {
      integrateOutsideClickBound = true;
      document.addEventListener("click", (e) => {
        const t = e.target;
        if (!(t instanceof HTMLElement)) return;
        if (t.closest(".integrate-filter-group")) return;
        closeAllIntegrateFilterPanels();
      });
    }

    searchInput.addEventListener("input", applyFilters);
    /* Delegated: checkbox change inside filter panels always runs applyFilters */
    root.addEventListener("change", (e) => {
      const t = e.target;
      if (t instanceof HTMLInputElement && t.hasAttribute("data-filter-check"))
        applyFilters();
    });

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        allCheckboxes.forEach((cb) => {
          cb.checked = false;
        });
        searchInput.value = "";
        window.history.replaceState({}, "", window.location.pathname);
        applyFilters();
      });
    }

    const params = new URLSearchParams(window.location.search);
    let anyApplied = false;
    for (const key of FILTER_KEYS) {
      const val = params.get(key);
      if (!val) continue;
      allCheckboxes.forEach((cb) => {
        if (cb.getAttribute("data-filter-check") === key && cb.value === val) {
          cb.checked = true;
          anyApplied = true;
        }
      });
    }
    if (anyApplied) applyFilters();
  }

  document.addEventListener("astro:page-load", initIntegrateOverview);
  initIntegrateOverview();
</script>

