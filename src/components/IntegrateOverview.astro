    font-weight: 500;
    line-height: 1;
    color: var(--sl-color-text);
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-800));
    border: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    border-radius: 9999px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
    vertical-align: middle;
  }
  .integrate-platform-chip:hover {
    background: light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
  }
  .integrate-platform-chip--active,
  .integrate-platform-chip[aria-pressed="true"] {
    background: var(--stl-color-accent);
    color: light-dark(#fff, var(--tiger-grey-900));
    border-color: var(--stl-color-accent);
  }

  /* Grid: stretch cards so every card in a row has the same height */
  #integrate-overview-root :global(.card-grid) {
    align-items: stretch;
  }
  .integrate-card-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }
  /* Custom card link: title → chips → description, styled like Starlight link cards */
  .integrate-card-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    align-items: start;
    flex: 1;
    min-height: 0;
    border: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-800));
    border-radius: var(--tiger-radius-lg, 0.5rem);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .integrate-card-link:hover {
    border-color: var(--stl-color-accent-high, var(--stl-color-accent));
    background-color: var(--stl-color-accent-low, transparent);
    box-shadow: var(--tiger-shadow-md, 0 4px 6px -1px rgb(0 0 0 / 0.1));
  }
  .integrate-card-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
