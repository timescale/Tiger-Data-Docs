    margin: 1.5rem 0;
  }
  .integrate-overview-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .integrate-overview-label {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    font-weight: 500;
    font-size: inherit;
    line-height: 1;
    color: var(--sl-color-text);
    margin: 0;
    padding: 0;
  }
  .integrate-overview-select {
    font: inherit;
    height: 2.25rem;
