---
/**
 * Integrate overview: integrations grouped by category (matches left sidebar).
 * Platform filter (All / Tiger Cloud on AWS / etc.) filters cards within the page.
 * Relies on frontmatter: integrationPlatforms[], integrationCategory, sortOrder.
 */
import { getEntry } from "astro:content";
/** Grid layout matches related content cards (Figma 3387-363) */

// Glob only to get list of integration doc paths; we use getEntry for frontmatter.
const pathMap = import.meta.glob("../content/docs/integrate/**/*.mdx");
const indexSlug = "integrate/index";
const findConnectionSlug = "integrate/find-connection-details";

function pathToSlug(filePath: string): string {
  // Paths from glob vary (e.g. ../content/docs/integrate/... or integrate/...); extract integrate/... and drop .mdx
  const normalized = filePath.replace(/\\/g, "/");
  const i = normalized.indexOf("integrate/");
  if (i === -1) return "";
  return normalized.slice(i).replace(/\.mdx$/, "");
}

const allSlugs = Object.keys(pathMap)
  .map(pathToSlug)
  .filter(Boolean)
  .filter(
    (slug) =>
      slug !== indexSlug &&
      slug !== findConnectionSlug &&
      !slug.endsWith("/index")
  );

const PLATFORM_LABELS: Record<string, string> = {
  aws: "Tiger Cloud on AWS",
  azure: "Tiger Cloud on Azure",
  "self-hosted": "Self-Hosted",
};
const PLATFORM_ORDER = ["aws", "azure", "self-hosted"] as const;
type PlatformSlug = (typeof PLATFORM_ORDER)[number];

type DocData = {
  title: string;
  description?: string;
  integrationCategory?: string;
  integrationIndustry?: string[];
  connectorType?: "tiger-data" | "external";
  sortOrder?: number;
  integrationCardTitle?: string;
  integrationPlatforms?: PlatformSlug[];
};

/** Card title for integrate index: "Tool and Tiger Data" (platform-agnostic); chips show specific platform (e.g. Tiger Cloud on AWS). */
function cardTitle(data: DocData): string {
  if (data.integrationCardTitle) {
    return `${data.integrationCardTitle} and Tiger Data`;
  }
  const t = data.title ?? "";
  const withMatch = t.match(/^Integrate (.+?) (?:with|and) Tiger (?:Cloud|Data)$/i);
  if (withMatch) return `${withMatch[1]} and Tiger Data`;
  const connectMatch = t.match(/^Connect (.+?) to Tiger (?:Cloud|Data)$/i);
  if (connectMatch) return `${connectMatch[1]} and Tiger Data`;
  const connectWithMatch = t.match(/^Connect to Tiger (?:Cloud|Data) with (.+)$/i);
  if (connectWithMatch) return `${connectWithMatch[1]} and Tiger Data`;
  if (t && !/Tiger (?:Cloud|Data)/i.test(t)) return `${t} and Tiger Data`;
  return (t || "Integration").replace(/Tiger Cloud/gi, "Tiger Data");
}

const entries: { slug: string; data: DocData }[] = [];
for (const slug of allSlugs) {
  try {
    const entry = await getEntry("docs", slug);
    if (entry && "data" in entry && entry.data) {
      const d = entry.data as DocData;
      entries.push({
        slug,
        data: {
          title: d.title ?? slug.split("/").pop() ?? "Integration",
          description: d.description,
          integrationCategory: d.integrationCategory,
          integrationIndustry: d.integrationIndustry,
          connectorType: d.connectorType,
          sortOrder: d.sortOrder,
          integrationCardTitle: d.integrationCardTitle,
          integrationPlatforms: d.integrationPlatforms ?? ["aws"],
        },
      });
    }
  } catch {
    // Skip entries that don't exist or fail
  }
}

/** Category sections for "By category" view, in display order (matches nav/sidebar). */
const byCategory = [
  { title: "Data Engineering & ETL", description: "ETL tools and data pipelines", href: "/integrate/data-engineering-etl" },
  { title: "BI & Visualization", description: "Dashboards and reporting tools", href: "/integrate/bi-vizualization" },
  { title: "Data Ingestion & Streaming", description: "Real-time data streaming", href: "/integrate/data-ingestion-streaming" },
  { title: "Connectors", description: "Source and destination connectors", href: "/integrate/connectors" },
  { title: "Code & Libraries", description: "Code and library integrations", href: "/integrate/code" },
  { title: "Query & Administration", description: "Database management tools", href: "/integrate/query-administration" },
  { title: "Secure Connectivity", description: "VPNs, tunnels, and secure access", href: "/integrate/secure-connectivity" },
  { title: "Observability & Alerting", description: "Monitoring and alerting tools", href: "/integrate/observability-alerting" },
  { title: "Configuration & Deployment", description: "IaC and deployment tools", href: "/integrate/configuration-deployment" },
];

/** Category slug from href e.g. /integrate/data-engineering-etl -> data-engineering-etl */
function hrefToCategorySlug(href: string): string {
  return href.replace(/^\/integrate\/?/, "").replace(/\/$/, "") || "";
}
const CATEGORY_ORDER = byCategory.map((c) => hrefToCategorySlug(c.href)).filter(Boolean);
/** Fixed display order for "By category" view (matches sidebar). */
const CATEGORY_DISPLAY_ORDER = [...CATEGORY_ORDER];
const CATEGORY_LABELS: Record<string, string> = Object.fromEntries(
  byCategory.map((c) => [hrefToCategorySlug(c.href), c.title])
);
// Fallback label for categories that appear in frontmatter but aren't in byCategory
function getCategoryLabel(slug: string): string {
  return CATEGORY_LABELS[slug] ?? slug.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
}

// Group entries by integrationCategory
const categoryGroups: Record<string, { slug: string; data: DocData }[]> = {};
for (const entry of entries) {
  const cat = entry.data.integrationCategory?.trim();
  if (!cat) continue;
  if (!categoryGroups[cat]) categoryGroups[cat] = [];
  categoryGroups[cat].push(entry);
}
// Sort within each category; include category order from byCategory, then any others that have entries
const categoryOrder = [
  ...CATEGORY_ORDER.filter((key) => categoryGroups[key]?.length),
  ...Object.keys(categoryGroups).filter((key) => !CATEGORY_ORDER.includes(key)),
];
for (const key of categoryOrder) {
  if (categoryGroups[key]) {
    categoryGroups[key].sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));
  }
}

function getPlatforms(data: DocData): PlatformSlug[] {
  const p = data.integrationPlatforms ?? ["aws"];
  return PLATFORM_ORDER.filter((key) => p.includes(key));
}

// Industry order (matches sidebar "Sort by Industry")
const INDUSTRY_ORDER = ["oil-and-gas", "iot", "energy", "crypto", "healthcare", "manufacturing"];
function normalizeIndustryKey(raw: string): string {
  const k = raw.trim().toLowerCase().replace(/\s+/g, "-");
  if (k === "oil-and-gas" || k === "oilandgas") return "oil-and-gas";
  return k;
}
const industryGroups: Record<string, { slug: string; data: DocData }[]> = {};
for (const entry of entries) {
  const industries = entry.data.integrationIndustry ?? [];
  for (const ind of industries) {
    const key = normalizeIndustryKey(ind);
    if (!key) continue;
    if (!industryGroups[key]) industryGroups[key] = [];
    industryGroups[key].push(entry);
  }
}
for (const key of INDUSTRY_ORDER) {
  if (industryGroups[key]) {
    industryGroups[key].sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));
  }
}
const INDUSTRY_LABELS: Record<string, string> = {
  "oil-and-gas": "Oil and Gas",
  iot: "IoT",
  energy: "Energy",
  crypto: "Crypto",
  healthcare: "Healthcare",
  manufacturing: "Manufacturing",
};

// Integration type: Tiger Connectors (category connectors), Partner, Third Party (connectorType external or unset)
const tigerConnectorsEntries = entries.filter((e) => e.data.integrationCategory === "connectors");
const thirdPartyEntries = entries.filter((e) => e.data.connectorType === "external");
const partnerEntries = entries.filter(
  (e) => e.data.integrationCategory !== "connectors" && e.data.connectorType !== "external"
);
[tigerConnectorsEntries, partnerEntries, thirdPartyEntries].forEach((arr) =>
  arr.sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99))
);

function slugToHref(slug: string): string {
  return "/" + slug + "/";
}
---

<div class="integrate-overview" data-category-order={JSON.stringify(CATEGORY_DISPLAY_ORDER)} id="integrate-overview-root" data-view="">
  <div class="integrate-platform-filter">
    <span class="integrate-platform-filter-label">Platform</span>
    <div class="integrate-platform-chips" role="group" aria-label="Filter by platform">
      <button type="button" class="integrate-platform-chip integrate-platform-chip--all integrate-platform-chip--active" data-platform-filter="all" aria-pressed="true">All</button>
      {
        PLATFORM_ORDER.map((key) => (
          <button type="button" class="integrate-platform-chip" data-platform-filter={key} aria-pressed="false">{PLATFORM_LABELS[key]}</button>
        ))
      }
    </div>
  </div>

  <div id="integrate-view-category" class="integrate-view" data-integrate-section="category">
    <h2 class="integrate-section-heading" id="integrate-categories-heading">Sort by Category</h2>
    {
      CATEGORY_DISPLAY_ORDER.map((categorySlug) => (
        <section class="integrate-category-section" id={`integrate-category-${categorySlug.replace(/\s+/g, "-").toLowerCase()}`}>
          <details class="integrate-category-details" open>
            <summary class="integrate-category-summary">
              <span class="integrate-category-heading">{getCategoryLabel(categorySlug)}</span>
              <span class="integrate-category-chevron" aria-hidden="true"></span>
            </summary>
            <div class="integrate-category-content">
              <div class="related-content-cards__grid">
                {
                  (categoryGroups[categorySlug] ?? []).map(({ slug, data }) => {
                      const platforms = getPlatforms(data);
                      return (
                        <div class="integrate-card-wrapper" data-platforms={platforms.join(",")}>
                          <a href={slugToHref(slug)} class="integrate-card-link">
                            <span class="integrate-card-inner">
                              <span class="integrate-card-title">{cardTitle(data)}</span>
                              <div class="integrate-card-chips">
                                {platforms.map((p) => (
                                  <span class="integrate-chip">{PLATFORM_LABELS[p]}</span>
                                ))}
                              </div>
                              {data.description && <p class="integrate-card-description">{data.description}</p>}
                            </span>
                            <span class="integrate-card-arrow" aria-hidden="true">→</span>
                          </a>
                        </div>
                      );
                    })
                  }
                </div>
            </div>
          </details>
        </section>
      ))
    }
  </div>

  <div id="integrate-industries" class="integrate-view" data-integrate-section="industry">
    <h2 class="integrate-section-heading" id="integrate-industries-heading">Sort by Industry</h2>
    {
      INDUSTRY_ORDER.map((industry) => {
        const items = industryGroups[industry] ?? [];
        return (
          <section class="integrate-category-section" id={`integrate-industry-${industry}`}>
            <details class="integrate-category-details" open>
              <summary class="integrate-category-summary">
                <span class="integrate-category-heading">{INDUSTRY_LABELS[industry] ?? industry}</span>
                <span class="integrate-category-chevron" aria-hidden="true"></span>
              </summary>
              <div class="integrate-category-content">
                {items.length > 0 ? (
                  <div class="related-content-cards__grid">
                    {
                      items.map(({ slug, data }) => {
                        const platforms = getPlatforms(data);
                        return (
                          <div class="integrate-card-wrapper" data-platforms={platforms.join(",")}>
                            <a href={slugToHref(slug)} class="integrate-card-link">
                              <span class="integrate-card-inner">
                                <span class="integrate-card-title">{cardTitle(data)}</span>
                                <div class="integrate-card-chips">
                                  {platforms.map((p) => (
                                    <span class="integrate-chip">{PLATFORM_LABELS[p]}</span>
                                  ))}
                                </div>
                                {data.description && <p class="integrate-card-description">{data.description}</p>}
                              </span>
                              <span class="integrate-card-arrow" aria-hidden="true">→</span>
                            </a>
                          </div>
                        );
                      })
                    }
                  </div>
                ) : (
                  <p class="integrate-empty">No integrations tagged for this industry yet.</p>
                )}
              </div>
            </details>
          </section>
        );
      })
    }
  </div>

  <div id="integrate-types" class="integrate-view" data-integrate-section="type">
    <h2 class="integrate-section-heading" id="integrate-types-heading">Sort by Integration Type</h2>
    <section class="integrate-category-section" id="integrate-type-tiger-connectors">
      <details class="integrate-category-details" open>
        <summary class="integrate-category-summary">
          <span class="integrate-category-heading">Tiger Connectors</span>
          <span class="integrate-category-chevron" aria-hidden="true"></span>
        </summary>
        <div class="integrate-category-content">
          <p class="integrate-type-intro">Source and destination connectors built and maintained by Tiger Data. See also <a href="/integrate/connectors/">Connectors</a> in the sidebar.</p>
          <div class="related-content-cards__grid">
            {
              tigerConnectorsEntries.map(({ slug, data }) => {
                const platforms = getPlatforms(data);
                return (
                  <div class="integrate-card-wrapper" data-platforms={platforms.join(",")}>
                    <a href={slugToHref(slug)} class="integrate-card-link">
                      <span class="integrate-card-inner">
                        <span class="integrate-card-title">{cardTitle(data)}</span>
                        <div class="integrate-card-chips">
                          {platforms.map((p) => (
                            <span class="integrate-chip">{PLATFORM_LABELS[p]}</span>
                          ))}
                        </div>
                        {data.description && <p class="integrate-card-description">{data.description}</p>}
                      </span>
                      <span class="integrate-card-arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                );
              })
            }
          </div>
        </div>
      </details>
    </section>
    <section class="integrate-category-section" id="integrate-type-partner">
      <details class="integrate-category-details" open>
        <summary class="integrate-category-summary">
          <span class="integrate-category-heading">Partner Integrations</span>
          <span class="integrate-category-chevron" aria-hidden="true"></span>
        </summary>
        <div class="integrate-category-content">
          {partnerEntries.length > 0 ? (
            <div class="related-content-cards__grid">
              {
                partnerEntries.map(({ slug, data }) => {
                  const platforms = getPlatforms(data);
                  return (
                    <div class="integrate-card-wrapper" data-platforms={platforms.join(",")}>
                      <a href={slugToHref(slug)} class="integrate-card-link">
                        <span class="integrate-card-inner">
                          <span class="integrate-card-title">{cardTitle(data)}</span>
                          <div class="integrate-card-chips">
                            {platforms.map((p) => (
                              <span class="integrate-chip">{PLATFORM_LABELS[p]}</span>
                            ))}
                          </div>
                          {data.description && <p class="integrate-card-description">{data.description}</p>}
                        </span>
                        <span class="integrate-card-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  );
                })
              }
            </div>
          ) : (
            <p class="integrate-empty">Partner integrations will be listed here once at least one integration is configured as a partner in its frontmatter.</p>
          )}
        </div>
      </details>
    </section>
    <section class="integrate-category-section" id="integrate-type-third-party">
      <details class="integrate-category-details" open>
        <summary class="integrate-category-summary">
          <span class="integrate-category-heading">Third Party Integrations</span>
          <span class="integrate-category-chevron" aria-hidden="true"></span>
        </summary>
        <div class="integrate-category-content">
          {thirdPartyEntries.length > 0 ? (
            <div class="related-content-cards__grid">
              {
                thirdPartyEntries.map(({ slug, data }) => {
                  const platforms = getPlatforms(data);
                  return (
                    <div class="integrate-card-wrapper" data-platforms={platforms.join(",")}>
                      <a href={slugToHref(slug)} class="integrate-card-link">
                        <span class="integrate-card-inner">
                          <span class="integrate-card-title">{cardTitle(data)}</span>
                          <div class="integrate-card-chips">
                            {platforms.map((p) => (
                              <span class="integrate-chip">{PLATFORM_LABELS[p]}</span>
                            ))}
                          </div>
                          {data.description && <p class="integrate-card-description">{data.description}</p>}
                        </span>
                        <span class="integrate-card-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  );
                })
              }
            </div>
          ) : (
            <p class="integrate-empty">Third party integrations (e.g. <code>connectorType: "external"</code> in frontmatter) will be listed here.</p>
          )}
        </div>
      </details>
    </section>
  </div>
</div>

<script>
  const root = document.getElementById("integrate-overview-root");
  const sectionCategory = document.querySelector<HTMLElement>("[data-integrate-section=\"category\"]");
  const sectionIndustry = document.querySelector<HTMLElement>("[data-integrate-section=\"industry\"]");
  const sectionType = document.querySelector<HTMLElement>("[data-integrate-section=\"type\"]");

  function applyIntegrateView() {
    const hash = window.location.hash.slice(1).toLowerCase();
    const industryOnly = hash === "by-industry";
    if (root) root.setAttribute("data-view", industryOnly ? "industry-only" : "");
    if (sectionCategory) sectionCategory.hidden = industryOnly;
    if (sectionIndustry) sectionIndustry.hidden = false;
    if (sectionType) sectionType.hidden = industryOnly;
    if (industryOnly && sectionIndustry) {
      sectionIndustry.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  }
  applyIntegrateView();
  window.addEventListener("hashchange", applyIntegrateView);

  const platformChips = document.querySelectorAll<HTMLButtonElement>("[data-platform-filter]");
  const cardWrappers = document.querySelectorAll<HTMLElement>(".integrate-card-wrapper");
  function applyPlatformFilter(platform: string) {
    platformChips.forEach((btn) => {
      const value = btn.getAttribute("data-platform-filter");
      btn.setAttribute("aria-pressed", value === platform ? "true" : "false");
      btn.classList.toggle("integrate-platform-chip--active", value === platform);
    });
    cardWrappers.forEach((el) => {
      const platforms = (el.getAttribute("data-platforms") ?? "").split(",").map((p) => p.trim());
      const show = platform === "all" || platforms.includes(platform);
      el.hidden = !show;
    });
  }
  platformChips.forEach((btn) => {
    btn.addEventListener("click", () => {
      const platform = btn.getAttribute("data-platform-filter") ?? "all";
      applyPlatformFilter(platform);
    });
  });
</script>

<style>
  .integrate-overview {
    margin: 1.5rem 0;
  }
  .integrate-section-heading {
    font-size: var(--sl-text-h3);
    font-weight: 600;
    color: var(--sl-color-text);
    margin: 0 0 1rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
  }
  .integrate-type-intro {
    margin: 0 0 0.75rem 0;
    font-size: 0.9375rem;
    color: var(--sl-color-text);
  }
  .integrate-industry-section {
    margin-bottom: 1.5rem;
  }
  .integrate-industry-heading {
    font-size: var(--sl-text-h4);
    margin-bottom: 0.75rem;
    color: var(--sl-color-text);
  }

  /* By category: collapsible sections (borderless, clean) */
  .integrate-category-section {
    margin-bottom: 1.25rem;
  }
  .integrate-category-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0 0.75rem;
    margin-bottom: 0.5rem;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
    border-bottom: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    overflow: visible;
  }
  .integrate-category-summary::-webkit-details-marker {
    display: none;
  }
  .integrate-category-summary:hover {
    color: var(--stl-color-accent);
  }
  .integrate-category-summary:hover .integrate-category-chevron {
    opacity: 1;
  }
  .integrate-category-heading {
    flex: 1;
  }
  .integrate-category-chevron {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.15rem 0.5rem 0 0;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.15s ease;
  }
  .integrate-category-details[open] .integrate-category-chevron {
    transform: rotate(-135deg);
    margin: -0.2rem 0.5rem 0 0;
  }
  .integrate-category-content {
    padding: 0.5rem 0 0;
  }
  .integrate-empty {
    color: var(--sl-color-text);
    font-style: italic;
  }

  .integrate-platform-filter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .integrate-platform-filter-label {
    font-weight: 500;
    font-size: inherit;
    color: var(--sl-color-text);
  }
  .integrate-platform-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    line-height: 0;
  }
  .integrate-platform-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    height: 2rem;
    min-width: 2rem;
    margin: 0;
    padding: 0 0.75rem;
    box-sizing: border-box;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    color: var(--sl-color-text);
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-800));
    border: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    border-radius: 9999px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
    vertical-align: middle;
  }
  .integrate-platform-chip:hover {
    background: light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
  }
  .integrate-platform-chip--active,
  .integrate-platform-chip[aria-pressed="true"] {
    background: var(--stl-color-accent);
    color: light-dark(#fff, var(--tiger-grey-900));
    border-color: var(--stl-color-accent);
  }

  /* Grid: stretch cards so every card in a row has the same height */
  #integrate-overview-root :global(.related-content-cards__grid) {
    align-items: stretch;
  }
  .integrate-card-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }
  /* Custom card link: title → chips → description, styled like Starlight link cards */
  .integrate-card-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--tiger-space-md, 16px);
    align-items: start;
    flex: 1;
    min-height: 0;
    border: 1px solid light-dark(#dddde3, var(--tiger-grey-700));
    border-radius: var(--tiger-radius-md, 8px);
    padding: var(--tiger-space-lg, 24px);
    background: light-dark(#ffffff, var(--tiger-grey-900));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .integrate-card-link:hover {
    background: light-dark(#f5f5ff, color-mix(in srgb, var(--tiger-vivid-purple) 18%, var(--tiger-black)));
    border-color: light-dark(#8f93f9, var(--tiger-vivid-purple));
  }
  .integrate-card-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    flex: 1;
    min-height: 0;
  }
