---
/**
 * Integrate overview: search bar + dropdown filters + flat card grid.
 * Filter dimensions: Type of Tool, Industry, Platform, First Party/Third Party, Technology.
 * Relies on frontmatter: integrationCategory, integrationIndustry[], integrationPlatforms[], connectorType, keywords[].
 */
import { getEntry } from "astro:content";

const pathMap = import.meta.glob("../content/docs/integrate/**/*.mdx");
const indexSlug = "integrate/index";
const findConnectionSlug = "integrate/find-connection-details";

function pathToSlug(filePath: string): string {
  const normalized = filePath.replace(/\\/g, "/");
  const i = normalized.indexOf("integrate/");
  if (i === -1) return "";
  return normalized.slice(i).replace(/\.mdx$/, "");
}

const allSlugs = Object.keys(pathMap)
  .map(pathToSlug)
  .filter(Boolean)
  .filter(
    (slug) =>
      slug !== indexSlug &&
      slug !== findConnectionSlug &&
      !slug.endsWith("/index")
  );

const PLATFORM_LABELS: Record<string, string> = {
  aws: "Tiger Cloud on AWS",
  azure: "Tiger Cloud on Azure",
  "self-hosted": "Self-Hosted",
};
const PLATFORM_ORDER = ["aws", "azure", "self-hosted"] as const;
type PlatformSlug = (typeof PLATFORM_ORDER)[number];

type DocData = {
  title: string;
  description?: string;
  integrationCategory?: string;
  integrationIndustry?: string[];
  connectorType?: "tiger-data" | "external";
  sortOrder?: number;
  integrationCardTitle?: string;
  integrationPlatforms?: PlatformSlug[];
  keywords?: string[];
};

function cardTitle(data: DocData): string {
  if (data.integrationCardTitle) {
    return `${data.integrationCardTitle} and Tiger Data`;
  }
  const t = data.title ?? "";
  const withMatch = t.match(/^Integrate (.+?) (?:with|and) Tiger (?:Cloud|Data)$/i);
  if (withMatch) return `${withMatch[1]} and Tiger Data`;
  const connectMatch = t.match(/^Connect (.+?) to Tiger (?:Cloud|Data)$/i);
  if (connectMatch) return `${connectMatch[1]} and Tiger Data`;
  const connectWithMatch = t.match(/^Connect to Tiger (?:Cloud|Data) with (.+)$/i);
  if (connectWithMatch) return `${connectWithMatch[1]} and Tiger Data`;
  if (t && !/Tiger (?:Cloud|Data)/i.test(t)) return `${t} and Tiger Data`;
  return (t || "Integration").replace(/Tiger Cloud/gi, "Tiger Data");
}

const entries: { slug: string; data: DocData }[] = [];
for (const slug of allSlugs) {
  try {
    const entry = await getEntry("docs", slug);
    if (entry && "data" in entry && entry.data) {
      const d = entry.data as DocData;
      entries.push({
        slug,
        data: {
          title: d.title ?? slug.split("/").pop() ?? "Integration",
          description: d.description,
          integrationCategory: d.integrationCategory,
          integrationIndustry: d.integrationIndustry,
          connectorType: d.connectorType,
          sortOrder: d.sortOrder,
          integrationCardTitle: d.integrationCardTitle,
          integrationPlatforms: d.integrationPlatforms ?? ["aws"],
          keywords: (d as any).keywords ?? [],
        },
      });
    }
  } catch {
    // Skip entries that don't exist or fail
  }
}

// Sort entries alphabetically by display title
entries.sort((a, b) => cardTitle(a.data).localeCompare(cardTitle(b.data)));

// --- Filter: Type of Tool (integrationCategory) ---
const CATEGORY_LABELS: Record<string, string> = {
  "data-engineering-etl": "Data Engineering & ETL",
  "bi-vizualization": "BI & Visualization",
  "data-ingestion-streaming": "Data Ingestion & Streaming",
  connectors: "Connectors",
  code: "Code & Libraries",
  "query-administration": "Query & Administration",
  "secure-connectivity": "Secure Connectivity",
  "observability-alerting": "Observability & Alerting",
  "configuration-deployment": "Configuration & Deployment",
};
const CATEGORY_ORDER = [
  "data-engineering-etl", "bi-vizualization", "data-ingestion-streaming",
  "connectors", "code", "query-administration", "secure-connectivity",
  "observability-alerting", "configuration-deployment",
];
function getCategoryLabel(slug: string): string {
  return CATEGORY_LABELS[slug] ?? slug.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
}
const uniqueCategories = CATEGORY_ORDER.filter((cat) =>
  entries.some((e) => e.data.integrationCategory === cat)
);

// --- Filter: Industry ---
const INDUSTRY_LABELS: Record<string, string> = {
  "oil-and-gas": "Oil and Gas",
  iot: "IoT",
  energy: "Energy",
  crypto: "Crypto",
  healthcare: "Healthcare",
  manufacturing: "Manufacturing",
};
function normalizeIndustryKey(raw: string): string {
  const k = raw.trim().toLowerCase().replace(/\s+/g, "-");
  if (k === "oilandgas") return "oil-and-gas";
  return k;
}
const INDUSTRY_ORDER = ["oil-and-gas", "iot", "energy", "crypto", "healthcare", "manufacturing"];
const uniqueIndustries = INDUSTRY_ORDER.filter((ind) =>
  entries.some((e) => (e.data.integrationIndustry ?? []).map(normalizeIndustryKey).includes(ind))
);

// --- Filter: Platform ---
function getPlatforms(data: DocData): PlatformSlug[] {
  const p = data.integrationPlatforms ?? ["aws"];
  return PLATFORM_ORDER.filter((key) => p.includes(key));
}

// --- Filter: First Party / Third Party ---
function getPartyType(data: DocData): string {
  if (data.integrationCategory === "connectors") return "first-party";
  return "third-party";
}

// --- Filter: Technology ---
const TECHNOLOGY_MAP: Record<string, string[]> = {
  "PostgreSQL": ["postgres", "psql", "pgadmin", "fdw", "foreign data wrappers", "postgresql"],
  "Python": ["python", "psycopg2", "sdk"],
  "SQL": ["sql editor", "sql shell", "query tool", "interactive queries"],
  "Kafka": ["kafka", "confluent", "event streaming"],
  "AWS": ["aws", "lambda", "sagemaker", "cloudwatch", "s3"],
  "Azure": ["azure"],
  "GCP": ["google cloud", "gcp"],
  "Terraform": ["terraform", "iac", "infrastructure as code"],
  "Kubernetes": ["kubernetes", "k8s", "container orchestration"],
  "Grafana": ["grafana"],
  "Prometheus": ["prometheus"],
  "REST API": ["api integration", "rest"],
};
function getTechnologies(data: DocData): string[] {
  const kw = (data.keywords ?? []).map((k: string) => k.toLowerCase());
  const techs: string[] = [];
  for (const [tech, patterns] of Object.entries(TECHNOLOGY_MAP)) {
    if (patterns.some((p) => kw.some((k) => k.includes(p)))) {
      techs.push(tech);
    }
  }
  return techs;
}
const TECHNOLOGY_ORDER = Object.keys(TECHNOLOGY_MAP);
const uniqueTechnologies = TECHNOLOGY_ORDER.filter((tech) =>
  entries.some((e) => getTechnologies(e.data).includes(tech))
);

function slugToHref(slug: string): string {
  return "/" + slug + "/";
}

/** Splash template hides the default Starlight title; show title + description in this panel. */
const routeEntry = Astro.locals.starlightRoute?.entry;
const headerTitle = routeEntry?.data?.title ?? "Integrate";
const headerDescription = routeEntry?.data?.description;
---

<div class="integrate-overview" id="integrate-overview-root">
  <header class="integrate-header" aria-labelledby="integrate-overview-heading">
    <h1 class="integrate-header__title" id="integrate-overview-heading">
      {headerTitle}
    </h1>
    {
      headerDescription ? (
        <p class="integrate-header__description">{headerDescription}</p>
      ) : null
    }
  </header>

  <!-- Search bar -->
  <div class="integrate-search-wrapper">
    <svg class="integrate-search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input type="text" class="integrate-search-input" id="integrate-search" placeholder="Search by tool or keyword..." autocomplete="off" />
  </div>

  <!-- Filter dropdowns -->
  <div class="integrate-filters" id="integrate-filters">
    <!-- Type of Tool -->
    <div class="integrate-filter-group" data-filter-key="category">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>Type of Tool</span>
        <svg class="integrate-filter-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        {uniqueCategories.map((cat) => (
          <label class="integrate-filter-option">
            <input type="checkbox" value={cat} data-filter-check="category" />
            <span>{getCategoryLabel(cat)}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Industry -->
    <div class="integrate-filter-group" data-filter-key="industry">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>Industry</span>
        <svg class="integrate-filter-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        {uniqueIndustries.map((ind) => (
          <label class="integrate-filter-option">
            <input type="checkbox" value={ind} data-filter-check="industry" />
            <span>{INDUSTRY_LABELS[ind] ?? ind}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Platform -->
    <div class="integrate-filter-group" data-filter-key="platform">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>Platform</span>
        <svg class="integrate-filter-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        {PLATFORM_ORDER.map((key) => (
          <label class="integrate-filter-option">
            <input type="checkbox" value={key} data-filter-check="platform" />
            <span>{PLATFORM_LABELS[key]}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- First Party / Third Party -->
    <div class="integrate-filter-group" data-filter-key="party">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>First Party/Third Party</span>
        <svg class="integrate-filter-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        <label class="integrate-filter-option">
          <input type="checkbox" value="first-party" data-filter-check="party" />
          <span>First Party</span>
        </label>
        <label class="integrate-filter-option">
          <input type="checkbox" value="third-party" data-filter-check="party" />
          <span>Third Party</span>
        </label>
      </div>
    </div>

    <!-- Technology -->
    <div class="integrate-filter-group" data-filter-key="technology">
      <button type="button" class="integrate-filter-btn" aria-expanded="false">
        <span>Technology</span>
        <svg class="integrate-filter-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="integrate-filter-panel" hidden>
        {uniqueTechnologies.map((tech) => (
          <label class="integrate-filter-option">
            <input type="checkbox" value={tech} data-filter-check="technology" />
            <span>{tech}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Clear filters -->
    <button type="button" class="integrate-clear-filters" id="integrate-clear-filters" hidden>
      Clear filters
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/>
        <path d="M9 5L5 9M5 5L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- No results message -->
  <p class="integrate-no-results" id="integrate-no-results" hidden>
    No integrations match your current filters. Try broadening your search.
  </p>

  <!-- Cards grid -->
  <div class="integrate-cards-grid" id="integrate-cards-grid">
    {entries.map(({ slug, data }) => {
      const platforms = getPlatforms(data);
      const party = getPartyType(data);
      const technologies = getTechnologies(data);
      const title = cardTitle(data);
      return (
        <a
          href={slugToHref(slug)}
          class="integrate-card"
          data-category={data.integrationCategory ?? ""}
          data-industries={(data.integrationIndustry ?? []).map(normalizeIndustryKey).join(",")}
          data-platforms={platforms.join(",")}
          data-party={party}
          data-technologies={technologies.join(",")}
          data-search-text={`${title} ${data.description ?? ""} ${(data.keywords ?? []).join(" ")}`.toLowerCase()}
        >
          <div class="integrate-card-accent"></div>
          <div class="integrate-card-body">
            <span class="integrate-card-tag">{getCategoryLabel(data.integrationCategory ?? "")}</span>
            <h3 class="integrate-card-title">{title}</h3>
            {data.description && <p class="integrate-card-desc">{data.description}</p>}
          </div>
        </a>
      );
    })}
  </div>
</div>

<script>
  // --- Integrate overview: search + dropdown filter logic ---
  const searchInput = document.getElementById("integrate-search") as HTMLInputElement | null;
  const clearBtn = document.getElementById("integrate-clear-filters") as HTMLButtonElement | null;
  const noResults = document.getElementById("integrate-no-results") as HTMLElement | null;
  const cards = document.querySelectorAll<HTMLElement>("#integrate-cards-grid .integrate-card");
  const filterGroups = document.querySelectorAll<HTMLElement>(".integrate-filter-group");
  const allCheckboxes = document.querySelectorAll<HTMLInputElement>("[data-filter-check]");

  // Toggle dropdown panels
  filterGroups.forEach((group) => {
    const btn = group.querySelector<HTMLButtonElement>(".integrate-filter-btn");
    const panel = group.querySelector<HTMLElement>(".integrate-filter-panel");
    if (!btn || !panel) return;
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      // Close all other panels
      filterGroups.forEach((g) => {
        const b = g.querySelector<HTMLButtonElement>(".integrate-filter-btn");
        const p = g.querySelector<HTMLElement>(".integrate-filter-panel");
        if (b) b.setAttribute("aria-expanded", "false");
        if (p) p.hidden = true;
      });
      if (!isOpen) {
        btn.setAttribute("aria-expanded", "true");
        panel.hidden = false;
      }
    });
  });

  // Close panels on outside click
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".integrate-filter-group")) {
      filterGroups.forEach((g) => {
        const b = g.querySelector<HTMLButtonElement>(".integrate-filter-btn");
        const p = g.querySelector<HTMLElement>(".integrate-filter-panel");
        if (b) b.setAttribute("aria-expanded", "false");
        if (p) p.hidden = true;
      });
    }
  });

  // Get active filter values per dimension
  function getActiveFilters(): Record<string, string[]> {
    const filters: Record<string, string[]> = {};
    allCheckboxes.forEach((cb) => {
      if (cb.checked) {
        const key = cb.getAttribute("data-filter-check") ?? "";
        if (!filters[key]) filters[key] = [];
        filters[key].push(cb.value);
      }
    });
    return filters;
  }

  function applyFilters() {
    const filters = getActiveFilters();
    const query = (searchInput?.value ?? "").trim().toLowerCase();
    const hasFilters = Object.keys(filters).length > 0 || query.length > 0;
    if (clearBtn) clearBtn.hidden = !hasFilters;

    // Update button labels with count
    filterGroups.forEach((group) => {
      const key = group.getAttribute("data-filter-key") ?? "";
      const btn = group.querySelector<HTMLButtonElement>(".integrate-filter-btn");
      const count = (filters[key] ?? []).length;
      if (btn) {
        btn.classList.toggle("integrate-filter-btn--active", count > 0);
      }
    });

    let visibleCount = 0;
    cards.forEach((card) => {
      let show = true;

      // Search filter
      if (query) {
        const text = card.getAttribute("data-search-text") ?? "";
        if (!text.includes(query)) show = false;
      }

      // Category filter
      if (show && filters["category"]?.length) {
        const cat = card.getAttribute("data-category") ?? "";
        if (!filters["category"].includes(cat)) show = false;
      }

      // Industry filter (card matches if it has ANY of the selected industries)
      if (show && filters["industry"]?.length) {
        const industries = (card.getAttribute("data-industries") ?? "").split(",").filter(Boolean);
        if (!filters["industry"].some((f) => industries.includes(f))) show = false;
      }

      // Platform filter
      if (show && filters["platform"]?.length) {
        const platforms = (card.getAttribute("data-platforms") ?? "").split(",").filter(Boolean);
        if (!filters["platform"].some((f) => platforms.includes(f))) show = false;
      }

      // Party filter
      if (show && filters["party"]?.length) {
        const party = card.getAttribute("data-party") ?? "";
        if (!filters["party"].includes(party)) show = false;
      }

      // Technology filter
      if (show && filters["technology"]?.length) {
        const techs = (card.getAttribute("data-technologies") ?? "").split(",").filter(Boolean);
        if (!filters["technology"].some((f) => techs.includes(f))) show = false;
      }

      card.hidden = !show;
      if (show) visibleCount++;
    });

    if (noResults) noResults.hidden = visibleCount > 0;
  }

  // Wire up search
  searchInput?.addEventListener("input", applyFilters);

  // Wire up checkboxes
  allCheckboxes.forEach((cb) => cb.addEventListener("change", applyFilters));

  // Wire up clear
  clearBtn?.addEventListener("click", () => {
    allCheckboxes.forEach((cb) => { cb.checked = false; });
    if (searchInput) searchInput.value = "";
    // Remove query params from URL
    window.history.replaceState({}, "", window.location.pathname);
    applyFilters();
  });

  // Apply filters from URL query params (e.g. ?industry=energy&platform=aws)
  // This allows sidebar links like /integrate/?industry=energy to pre-activate filters.
  const FILTER_KEYS = ["category", "industry", "platform", "party", "technology"];
  function applyFromURL() {
    const params = new URLSearchParams(window.location.search);
    let anyApplied = false;
    for (const key of FILTER_KEYS) {
      const val = params.get(key);
      if (!val) continue;
      // Find matching checkbox and check it
      allCheckboxes.forEach((cb) => {
        if (cb.getAttribute("data-filter-check") === key && cb.value === val) {
          cb.checked = true;
          anyApplied = true;
        }
      });
    }
    if (anyApplied) applyFilters();
  }
  applyFromURL();
</script>

<style>
  .integrate-overview {
    margin: 1.5rem 0;
  }

  /* ---- Page intro (splash template skips default PageTitle; no box, flows with the page) ---- */
  /* Reset global `header { border-bottom; display: flex; ... }` from layout CSS so this in-page header is not styled like the site chrome */
  .integrate-header {
    display: block;
    margin: 0 auto 1.75rem;
    padding: 0;
    max-width: 42rem;
    text-align: center;
    border-bottom: none;
  }
  .integrate-header__title {
    margin: 0 0 0.5rem;
    font-family: var(--stl-font-family, inherit);
    font-size: clamp(1.625rem, 2.8vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.2;
    color: light-dark(var(--tiger-bg-default, #15151e), var(--tiger-grey-50));
  }
  .integrate-header__description {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: light-dark(var(--tiger-fg-emphasized, #555570), rgba(220, 220, 230, 0.88));
  }

  /* ---- Search bar ---- */
  .integrate-search-wrapper {
    position: relative;
    max-width: 640px;
    margin: 0 auto 1.5rem;
  }
  .integrate-search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: light-dark(var(--tiger-grey-400), var(--tiger-grey-500));
    pointer-events: none;
  }
  .integrate-search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--sl-color-text);
    background: light-dark(var(--tiger-grey-50), var(--tiger-grey-800));
    border: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    border-radius: 9999px;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .integrate-search-input::placeholder {
    color: light-dark(var(--tiger-grey-400), var(--tiger-grey-500));
  }
  .integrate-search-input:focus {
    border-color: var(--stl-color-accent);
    box-shadow: 0 0 0 3px var(--search-focus-ring, rgba(117, 91, 255, 0.2));
  }

  /* ---- Filter bar ---- */
  .integrate-filters {
    display: flex;
    flex-wrap: wrap;
    /* Top-align items on each row so every pill shares the same baseline when the bar wraps.
       (Default align-content: stretch can make rows different heights and visually “float” controls.) */
    align-items: flex-start;
    align-content: flex-start;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2rem;
  }
  /*
    Markdown/prose styles often add vertical margin between siblings (* + *, etc.). Flex items
    still honor margin-top, so the 2nd+ pills sit lower than the first, reset here; spacing is gap.
  */
  .integrate-filters > * {
    margin: 0;
  }
  .integrate-filter-group {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: stretch;
    height: 2.25rem;
  }
  .integrate-filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    height: 2.25rem;
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    font-family: inherit;
    line-height: 1;
    color: var(--sl-color-text);
    background: light-dark(var(--tiger-grey-50), var(--tiger-grey-800));
    border: 1px solid light-dark(var(--tiger-grey-200), var(--tiger-grey-700));
    border-radius: 9999px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
    box-sizing: border-box;
  }
  .integrate-filter-btn:hover {
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-700));
  }
  .integrate-filter-btn--active {
    background: var(--stl-color-accent);
    color: light-dark(#fff, var(--tiger-grey-900));
    border-color: var(--stl-color-accent);
  }
  .integrate-filter-btn--active:hover {
    opacity: 0.9;
  }
  .integrate-filter-btn[aria-expanded="true"] .integrate-filter-chevron {
    transform: rotate(180deg);
  }
  .integrate-filter-chevron {
    flex-shrink: 0;
    display: block;
