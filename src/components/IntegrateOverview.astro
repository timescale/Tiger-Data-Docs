    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.15rem 0.5rem 0 0;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.15s ease;
  }
  .integrate-category-details[open] .integrate-category-chevron {
    transform: rotate(-135deg);
    margin: -0.2rem 0.5rem 0 0;
  }
  .integrate-category-content {
    padding: 0.5rem 0 0;
  }
  .integrate-empty {
    color: var(--sl-color-text);
    font-style: italic;
  }

  .integrate-platform-filter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .integrate-platform-filter-label {
    font-weight: 500;
    font-size: inherit;
    color: var(--sl-color-text);
  }
  .integrate-platform-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    line-height: 0;
  }
  .integrate-platform-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    height: 2rem;
    min-width: 2rem;
    margin: 0;
    padding: 0 0.75rem;
    box-sizing: border-box;
