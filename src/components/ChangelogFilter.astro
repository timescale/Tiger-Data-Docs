---
/**
 * ChangelogFilter Component
 * 
 * Provides client-side filtering for changelog entries.
 * 
 * Features:
 * - Filter by tag type (multi-select)
 * - Search by keyword
 * - URL state persistence
 * 
 * Usage:
 * Place this component at the top of your changelog page, before the entries.
 * <ChangelogFilter />
 */

const tagOptions = [
  { value: 'new-feature', label: 'New Feature', icon: '✨' },
  { value: 'improvement', label: 'Improvement', icon: '💡' },
  { value: 'performance', label: 'Performance', icon: '🏎️' },
  { value: 'security', label: 'Security', icon: '🔐' },
  { value: 'integration', label: 'Integration', icon: '🔌' },
  { value: 'region', label: 'Availability', icon: '🌍' },
  { value: 'deprecation', label: 'Deprecation', icon: '⚠️' },
  { value: 'bug-fix', label: 'Bug Fix', icon: '🐛' },
  { value: 'breaking-change', label: 'Breaking', icon: '🚨' },
  { value: 'beta', label: 'Beta', icon: '🧪' },
  { value: 'ga', label: 'GA', icon: '🎉' },
];
---

<div class="changelog-filter" id="changelog-filter">
  <div class="changelog-filter__controls">
    <!-- Search -->
    <div class="changelog-filter__search">
      <svg class="changelog-filter__search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input 
        type="search" 
        id="changelog-search" 
        class="changelog-filter__search-input"
        placeholder="Search updates..."
        aria-label="Search changelog entries"
      />
    </div>
  </div>

  <!-- Tag filters: label + track with scroll arrows when pills overflow -->
  <div class="changelog-filter__tags">
    <span class="changelog-filter__tags-label" id="changelog-filter-tags-label">Filter by:</span>
    <div class="changelog-filter__tags-track">
      <button
        type="button"
        class="changelog-filter__tags-nav changelog-filter__tags-nav--prev"
        aria-label="Scroll tag filters left"
        aria-controls="changelog-filter-tags-scroll"
        disabled
      >
        <span class="changelog-filter__tags-nav-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
        </span>
      </button>
      <!-- Direct child of tags-track: prev | #changelog-filter-tags-scroll | next (no clip wrapper). -->
      <div
        class="changelog-filter__tags-scroll"
        id="changelog-filter-tags-scroll"
        role="group"
        aria-labelledby="changelog-filter-tags-label"
      >
        <button
          class="changelog-filter__tag-btn changelog-filter__tag-btn--all active"
          data-tag="all"
          aria-pressed="true"
        >All</button>{tagOptions.map((tag) => (
          <button
            class={`changelog-filter__tag-btn changelog-filter__tag-btn--${tag.value}`}
            data-tag={tag.value}
            aria-pressed="false"
          >
            <span class="changelog-filter__tag-icon" aria-hidden="true">{tag.icon}</span>
            {tag.label}
          </button>
        ))}
      </div>
      <button
        type="button"
        class="changelog-filter__tags-nav changelog-filter__tags-nav--next"
        aria-label="Scroll tag filters right"
        aria-controls="changelog-filter-tags-scroll"
        disabled
      >
        <span class="changelog-filter__tags-nav-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
        </span>
      </button>
    </div>
  </div>

  <!-- Results count -->
  <div class="changelog-filter__results" id="changelog-results">
    <span class="changelog-filter__results-count"></span>
  </div>
</div>

<style>
  .changelog-filter {
    --filter-border: light-dark(#e5e7eb, #374151);
    --filter-bg: light-dark(#f9fafb, #1f2937);
    --filter-input-bg: light-dark(#ffffff, #111827);
    --filter-text: light-dark(#374151, #d1d5db);
    --filter-text-muted: light-dark(#6b7280, #9ca3af);
    --filter-accent: light-dark(#6446fb, #f5ff80);
    --filter-accent-text: light-dark(#ffffff, #000000);
    /* Single pill + nav row height in expanded and compact (keep shape consistent). */
    --changelog-tag-row-height: 1.75rem;
    
    /* Park below the fixed site header (not under it). --stl-nav-height is 3.5rem base; taller with tabbed nav on ≥50rem. */
    position: sticky;
    top: calc(var(--stl-nav-height, 3.5rem) + env(safe-area-inset-top, 0px));
    z-index: 50;
    isolation: isolate;
    padding: 1rem;
    margin-bottom: 1.25rem;
    /* Opaque enough that entries scroll behind the bar; blur is extra polish */
    background-color: var(--filter-bg);
    background-image: linear-gradient(
      var(--filter-bg),
      var(--filter-bg)
    );
    border: 1px solid var(--filter-border);
    border-radius: 12px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 light-dark(rgba(15, 23, 42, 0.06), rgba(255, 255, 255, 0.06));
    transition: padding 0.2s ease, margin 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  @media (prefers-reduced-motion: reduce) {
    .changelog-filter {
      transition: none;
    }
  }

  /* Narrow bar once the first entry scrolls into the sticky overlap zone (see script).
     Same width as expanded (no horizontal bleed) so the card does not jump when condensing. */
  .changelog-filter.changelog-filter--compact {
    /* Tight top: search is hidden; extra top padding looked like empty space above the row */
    padding: 0 1rem 0.5rem;
    box-sizing: border-box;
    gap: 0.375rem;
  }

  /* Remove search row from layout entirely (margin-bottom on controls was leaving a gap). */
  .changelog-filter.changelog-filter--compact .changelog-filter__controls {
    display: none !important;
    margin: 0 !important;
    margin-bottom: 0 !important;
    padding: 0 !important;
    height: 0 !important;
    min-height: 0 !important;
    overflow: hidden !important;
    border: none !important;
  }

  .changelog-filter.changelog-filter--compact .changelog-filter__results {
    margin-top: 0.5rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--filter-border);
    font-size: 0.75rem;
  }

  .changelog-filter__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* Search */
  .changelog-filter__search {
    flex: 1;
    min-width: 200px;
    position: relative;
  }

  .changelog-filter__search-icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--filter-text-muted);
    pointer-events: none;
    z-index: 1;
  }

  .changelog-filter__search-input {
    width: 100%;
    height: 2.5rem;
    padding: 0 0.875rem 0 2.5rem;
    font-size: 0.875rem;
    line-height: 2.5rem;
    color: var(--filter-text);
    background: var(--filter-input-bg);
    border: 1px solid var(--filter-border);
    border-radius: 8px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .changelog-filter__search-input:focus {
    border-color: var(--filter-accent);
    box-shadow: 0 0 0 3px light-dark(rgba(100, 70, 251, 0.1), rgba(245, 255, 128, 0.1));
  }

  .changelog-filter__search-input::placeholder {
    color: var(--filter-text-muted);
  }

  /*
   * Tags: expanded = label + wrapped pill rows (no horizontal scroll).
   * Compact (condensed sticky) = single row + horizontal scroll, arrows, edge fades.
   */
  .changelog-filter__tags {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    min-width: 0;
  }

  /* Grid: label + track; gap matches track internal spacing so rhythm is even. */
  .changelog-filter--compact .changelog-filter__tags {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0;
    min-height: 0;
  }

  .changelog-filter__tags-track {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    width: 100%;
  }

  /* Compact: prev | clip | next — fixed row height so it cannot grow when a scrollbar appears. */
  .changelog-filter--compact .changelog-filter__tags-track {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    width: 100%;
    height: var(--changelog-tag-row-height);
    max-height: var(--changelog-tag-row-height);
    box-sizing: border-box;
  }

  .changelog-filter:not(.changelog-filter--compact) .changelog-filter__tags-nav {
    display: none !important;
  }

  .changelog-filter.changelog-filter--compact .changelog-filter__tags-track:not(.is-overflowing) .changelog-filter__tags-nav {
    display: none;
  }

  .changelog-filter--compact .changelog-filter__tags-nav {
    position: relative;
    z-index: 2;
  }

  .changelog-filter__tags-nav {
    box-sizing: border-box;
    flex: 0 0 auto;
    width: var(--changelog-tag-row-height);
    height: var(--changelog-tag-row-height);
    margin: 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--filter-border);
    border-radius: 8px;
    background: var(--filter-input-bg);
    color: var(--filter-text-muted);
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }

  /* Same fixed row height as the track so grid align-items:center does not vertically offset the label vs pills */
  .changelog-filter--compact .changelog-filter__tags-label {
    display: inline-flex;
    align-items: center;
    align-self: center;
    height: var(--changelog-tag-row-height);
    min-height: var(--changelog-tag-row-height);
    max-height: var(--changelog-tag-row-height);
    line-height: var(--changelog-tag-row-height);
    font-size: 0.875rem;
  }

  .changelog-filter__tags-nav:hover:not(:disabled) {
    border-color: var(--filter-accent);
    color: var(--filter-text);
  }

  .changelog-filter__tags-nav:focus-visible {
    outline: 2px solid var(--filter-accent);
    outline-offset: 2px;
  }

  .changelog-filter__tags-nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .changelog-filter__tags-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  /*
   * Scroll region: flexes between nav arrows; edge fades live on this element (no clip wrapper).
   * Collapse JSX whitespace between tag buttons; real font sizes live on .changelog-filter__tag-btn.
   */
  .changelog-filter__tags-scroll {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0;
    line-height: 0;
  }

  /* Edge fades when there is more content to scroll (same bg as the filter card). */
  .changelog-filter__tags-scroll::before,
  .changelog-filter__tags-scroll::after {
    content: "";
    position: absolute;
    top: 0;
    width: 1.25rem;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .changelog-filter:not(.changelog-filter--compact) .changelog-filter__tags-scroll::before,
  .changelog-filter:not(.changelog-filter--compact) .changelog-filter__tags-scroll::after {
    bottom: 0.25rem;
  }

  .changelog-filter--compact .changelog-filter__tags-scroll::before,
  .changelog-filter--compact .changelog-filter__tags-scroll::after {
    bottom: 0;
    width: 1rem;
  }

  .changelog-filter__tags-scroll::before {
    left: 0;
    background: linear-gradient(to right, var(--filter-bg), transparent);
  }

  .changelog-filter__tags-scroll::after {
    right: 0;
    background: linear-gradient(to left, var(--filter-bg), transparent);
  }

  .changelog-filter.changelog-filter--compact .changelog-filter__tags-track.is-overflowing:not(.is-at-start) .changelog-filter__tags-scroll::before {
    opacity: 1;
  }

  .changelog-filter.changelog-filter--compact .changelog-filter__tags-track.is-overflowing:not(.is-at-end) .changelog-filter__tags-scroll::after {
    opacity: 1;
  }

  .changelog-filter:not(.changelog-filter--compact) .changelog-filter__tags-scroll::before,
  .changelog-filter:not(.changelog-filter--compact) .changelog-filter__tags-scroll::after {
    opacity: 0 !important;
  }

  /* Expanded: pills are direct children — flex-wrap rows. */
  .changelog-filter:not(.changelog-filter--compact) .changelog-filter__tags-scroll {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    overflow: visible;
    padding-bottom: 0.25rem;
  }

  /*
   * Compact: same scroll element — block + horizontal scroll; pills are inline-flex on one line
   * (not a nested flex row, so no extra wrapper and no stray flex line-height).
   */
  .changelog-filter--compact .changelog-filter__tags-scroll {
    box-sizing: border-box;
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 0;
    height: var(--changelog-tag-row-height);
    max-height: var(--changelog-tag-row-height);
    margin: 0;
    padding: 0 0 0 0;
    /* End padding keeps the last pill out from under the gradient + next button */
    padding-inline-end: 0.75rem;
    border: 0;
    background: transparent;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-padding-inline: 0;
    scroll-padding-inline-end: 0.75rem;
    white-space: nowrap;
  }

  .changelog-filter--compact .changelog-filter__tags-scroll > .changelog-filter__tag-btn {
    display: inline-flex;
    vertical-align: top;
    margin-inline-end: 0.375rem;
  }

  .changelog-filter--compact .changelog-filter__tags-scroll > .changelog-filter__tag-btn:last-child {
    margin-inline-end: 0;
  }

  .changelog-filter--compact .changelog-filter__tags-scroll::-webkit-scrollbar {
    display: none;
    height: 0;
  }

  .changelog-filter__tags-scroll:focus-visible {
    outline: 2px solid var(--filter-accent);
    outline-offset: 2px;
  }

  .changelog-filter__tags-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--filter-text-muted);
    height: var(--changelog-tag-row-height);
    line-height: var(--changelog-tag-row-height);
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
    margin: 0;
  }

  /* "All" is short text; min-width keeps it pill-shaped like the others (not a tiny dot). */
  .changelog-filter__tag-btn--all {
    min-width: 2.75rem;
  }

  .changelog-filter__tag-btn {
    box-sizing: border-box;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    height: var(--changelog-tag-row-height);
    min-height: var(--changelog-tag-row-height);
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    color: var(--filter-text);
    background: var(--filter-input-bg);
    border: 1px solid var(--filter-border);
    border-radius: 9999px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
    white-space: nowrap;
    flex-shrink: 0;
    appearance: none;
    -webkit-appearance: none;
    padding-block: 0;
  }

  .changelog-filter__tag-btn:hover {
    border-color: var(--filter-accent);
  }

  .changelog-filter__tag-btn.active {
    background: var(--filter-accent);
    color: var(--filter-accent-text);
    border-color: var(--filter-accent);
  }

  .changelog-filter__tag-btn[aria-pressed="true"] {
    background: var(--filter-accent);
    color: var(--filter-accent-text);
    border-color: var(--filter-accent);
  }

  .changelog-filter__tag-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    line-height: 1;
  }

  /* Results */
  .changelog-filter__results {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--filter-border);
    font-size: 0.8125rem;
    color: var(--filter-text-muted);
  }

  .changelog-filter__results-count:empty {
    display: none;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .changelog-filter {
      --changelog-tag-row-height: 1.625rem;
      padding: 0.75rem;
      border-radius: 8px;
      margin-bottom: 1rem;
    }

    .changelog-filter__controls {
      margin-bottom: 0.75rem;
    }

    .changelog-filter__search {
      min-width: 100%;
    }

    .changelog-filter__search-input {
      height: 2.25rem;
      font-size: 1rem; /* Prevents iOS zoom on focus */
    }

    .changelog-filter__tags {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }

    .changelog-filter--compact .changelog-filter__tags {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: 0.5rem;
      row-gap: 0;
    }

    .changelog-filter__tags-track {
      width: 100%;
    }

    .changelog-filter__tags-nav {
      width: var(--changelog-tag-row-height);
      height: var(--changelog-tag-row-height);
    }

    .changelog-filter:not(.changelog-filter--compact) .changelog-filter__tags-scroll {
      padding-bottom: 0.125rem;
      gap: 0.25rem;
    }

    .changelog-filter__tags-label {
      font-size: 0.75rem;
      line-height: 1;
      height: auto;
    }

    .changelog-filter--compact .changelog-filter__tags-label {
      height: var(--changelog-tag-row-height);
      line-height: var(--changelog-tag-row-height);
      font-size: 0.75rem;
    }

    .changelog-filter__tag-btn {
      padding: 0 0.375rem;
      font-size: 0.6875rem;
    }

    .changelog-filter__tag-icon {
      font-size: 0.625rem;
    }

    .changelog-filter__results {
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      font-size: 0.75rem;
    }

    .changelog-filter.changelog-filter--compact .changelog-filter__results {
      margin-top: 0;
    }

    .changelog-filter.changelog-filter--compact {
      padding: 0.375rem 0.75rem;
      gap: 0.375rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('changelog-search') as HTMLInputElement;
    const tagButtons = document.querySelectorAll('.changelog-filter__tag-btn');
    const resultsContainer = document.querySelector('.changelog-filter__results-count');
    
    let activeFilters: Set<string> = new Set(['all']);
    let searchQuery = '';

    /** Bottom edge of the filter while expanded; expand/compact thresholds use this so height changes do not oscillate. */
    let baselineFilterBottomPx = 0;
    let stickyRaf = 0;

    const getEntries = () => document.querySelectorAll('.changelog-entry') as NodeListOf<HTMLElement>;

    const getFirstVisibleEntry = (): HTMLElement | null => {
      for (const el of getEntries()) {
        if (el.getAttribute('data-hidden') === 'true') continue;
        return el;
      }
      return null;
    };

    const tagsScrollEl = document.getElementById('changelog-filter-tags-scroll');
    const tagsTrackEl = document.querySelector('.changelog-filter__tags-track');
    const tagsPrevBtn = document.querySelector(
      '.changelog-filter__tags-nav--prev'
    ) as HTMLButtonElement | null;
    const tagsNextBtn = document.querySelector(
      '.changelog-filter__tags-nav--next'
    ) as HTMLButtonElement | null;

    const updateTagScrollAffordance = () => {
      const filter = document.getElementById('changelog-filter');
      const el = tagsScrollEl;
      const track = tagsTrackEl;
      if (!el || !track || !filter) return;

      if (!filter.classList.contains('changelog-filter--compact')) {
        track.classList.remove('is-overflowing', 'is-at-start', 'is-at-end');
        if (tagsPrevBtn) tagsPrevBtn.disabled = true;
        if (tagsNextBtn) tagsNextBtn.disabled = true;
        el.scrollLeft = 0;
        return;
      }

      const { scrollLeft, scrollWidth, clientWidth } = el;
      const overflow = scrollWidth > clientWidth + 2;

      track.classList.toggle('is-overflowing', overflow);
      track.classList.toggle('is-at-start', !overflow || scrollLeft <= 2);
      track.classList.toggle('is-at-end', !overflow || scrollLeft >= scrollWidth - clientWidth - 2);

      if (tagsPrevBtn) {
        tagsPrevBtn.disabled = !overflow || scrollLeft <= 2;
      }
      if (tagsNextBtn) {
        tagsNextBtn.disabled = !overflow || scrollLeft >= scrollWidth - clientWidth - 2;
      }
    };

    const prefersReducedMotion = () =>
      typeof window !== 'undefined' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scrollTagsByPage = (direction: 1 | -1) => {
      if (!tagsScrollEl) return;
      const step = Math.max(160, Math.floor(tagsScrollEl.clientWidth * 0.65));
      tagsScrollEl.scrollBy({
        left: direction * step,
        behavior: prefersReducedMotion() ? 'auto' : 'smooth',
      });
    };

    tagsPrevBtn?.addEventListener('click', () => scrollTagsByPage(-1));
    tagsNextBtn?.addEventListener('click', () => scrollTagsByPage(1));
    tagsScrollEl?.addEventListener('scroll', updateTagScrollAffordance, { passive: true });

    if (tagsScrollEl && typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(updateTagScrollAffordance).observe(tagsScrollEl);
    }

    const updateChangelogStickyChrome = () => {
      const filter = document.getElementById('changelog-filter');
      if (!filter) return;

      const first = getFirstVisibleEntry();
      let isCompact = filter.classList.contains('changelog-filter--compact');

      if (first) {
        if (!isCompact) {
          baselineFilterBottomPx = filter.getBoundingClientRect().bottom;
        }
        const ft = first.getBoundingClientRect().top;

        if (!isCompact && ft < baselineFilterBottomPx - 8) {
          filter.classList.add('changelog-filter--compact');
        } else if (isCompact && ft > baselineFilterBottomPx + 24) {
          filter.classList.remove('changelog-filter--compact');
        }
      }

      const fb = filter.getBoundingClientRect().bottom;
      document.documentElement.style.setProperty(
        '--changelog-scroll-margin-top',
        `${Math.round(fb + 12)}px`
      );

      updateTagScrollAffordance();
    };

    const scheduleChangelogStickyUpdate = () => {
      if (stickyRaf) return;
      stickyRaf = requestAnimationFrame(() => {
        stickyRaf = 0;
        updateChangelogStickyChrome();
      });
    };

    // Update URL with current filter state
    const updateURL = () => {
      const params = new URLSearchParams();
      if (searchQuery) params.set('q', searchQuery);
      if (!activeFilters.has('all')) {
        params.set('tags', Array.from(activeFilters).join(','));
      }
      
      const newURL = params.toString() 
        ? `${window.location.pathname}?${params.toString()}`
        : window.location.pathname;
      
      window.history.replaceState({}, '', newURL);
    };

    // Read initial state from URL
    const readURL = () => {
      const params = new URLSearchParams(window.location.search);
      
      if (params.has('q')) {
        searchQuery = params.get('q') || '';
        searchInput.value = searchQuery;
      }
      
      if (params.has('tags')) {
        const tags = params.get('tags')?.split(',') || [];
        activeFilters = new Set(tags);
        tagButtons.forEach(btn => {
          const tag = (btn as HTMLElement).dataset.tag;
          const isActive = activeFilters.has(tag || '');
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-pressed', String(isActive));
        });
      }
    };

    // Filter entries
    const applyFilters = () => {
      const entries = getEntries();
      let visibleCount = 0;

      // Filter entries
      entries.forEach(entry => {
        const entryTags = (entry.dataset.tags || '').split(',');
        const entryText = entry.textContent?.toLowerCase() || '';
        
        // Check tag filter
        const matchesTags = activeFilters.has('all') || 
          entryTags.some(tag => activeFilters.has(tag));
        
        // Check search filter
        const matchesSearch = !searchQuery || 
          entryText.includes(searchQuery.toLowerCase());

        const isVisible = matchesTags && matchesSearch;
        entry.setAttribute('data-hidden', String(!isVisible));
        
        if (isVisible) visibleCount++;
      });

      // Update results count
      if (resultsContainer) {
        const totalCount = entries.length;
        if (visibleCount === totalCount) {
          resultsContainer.textContent = `Showing all ${totalCount} updates`;
        } else {
          resultsContainer.textContent = `Showing ${visibleCount} of ${totalCount} updates`;
        }
      }

      updateURL();
      scheduleChangelogStickyUpdate();
      requestAnimationFrame(updateTagScrollAffordance);
    };

    // Event handlers
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    tagButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = (btn as HTMLElement).dataset.tag;
        
        if (tag === 'all') {
          // Reset to all
          activeFilters = new Set(['all']);
          tagButtons.forEach(b => {
            const isAll = (b as HTMLElement).dataset.tag === 'all';
            b.classList.toggle('active', isAll);
            b.setAttribute('aria-pressed', String(isAll));
          });
        } else {
          // Toggle specific tag
          activeFilters.delete('all');
          
          if (activeFilters.has(tag || '')) {
            activeFilters.delete(tag || '');
          } else {
            activeFilters.add(tag || '');
          }

          // If no tags selected, reset to all
          if (activeFilters.size === 0) {
            activeFilters.add('all');
          }

          // Update button states
          tagButtons.forEach(b => {
            const btnTag = (b as HTMLElement).dataset.tag;
            const isActive = activeFilters.has(btnTag || '');
            b.classList.toggle('active', isActive);
            b.setAttribute('aria-pressed', String(isActive));
          });
        }

        applyFilters();
      });
    });

    window.addEventListener('scroll', scheduleChangelogStickyUpdate, { passive: true });
    window.addEventListener('resize', () => {
      scheduleChangelogStickyUpdate();
      updateTagScrollAffordance();
    });

    // Initialize
    readURL();
    applyFilters();
    scheduleChangelogStickyUpdate();
    requestAnimationFrame(() => {
      scheduleChangelogStickyUpdate();
      updateTagScrollAffordance();
    });
  });
</script>
