---
/**
 * HeroGetStartedCard – Figma 3513:11069 (Cloud) and 3513:11798 (Install locally).
 * Two-column hero cards: border black, 16px radius, 50px padding, 4px 4px 0 black shadow.
 * Variant backgrounds: cloud #f2f0ff, local #feffef. CTA: black icon box + label, 16px SemiBold.
 */
export interface Props {
  /** "cloud" = lavender card (Get started with Cloud), "local" = cream card (Install locally). */
  variant: "cloud" | "local";
  /** Card heading (e.g. "Get started with Cloud"). */
  title: string;
  /** Short description under the title. */
  description: string;
  /** CTA label (e.g. "Start with Cloud"). */
  ctaText: string;
  /** Link URL for the CTA. */
  href: string;
  /** Optional: URL for cloud card illustration (if omitted, uses Figma export; use /assets/... for a permanent image). */
  cloudImageSrc?: string;
}

const { variant, title, description, ctaText, href, cloudImageSrc } = Astro.props;
const cloudImgSrc = cloudImageSrc ?? "https://www.figma.com/api/mcp/asset/95de3deb-a482-4dfb-8c07-584db9280c18";
const variantClass = variant === "cloud" ? "splash-hero-card--cloud" : "splash-hero-card--local";
---

<a
  class={`splash-hero-card ${variantClass}`}
  href={href}
>
  <div class="splash-hero-card__bg" aria-hidden="true" />
  {variant === "cloud" && (
    <div class="splash-hero-card__illustration splash-hero-card__illustration--cloud" aria-hidden="true">
      {/* Figma 3513:11793–11797: cloud with rounded bumps, flat bottom, black outline, blue-lavender fill; bottom-right anchored so it peeks from corner */}
      <div class="splash-hero-card__cloud-frame">
        <svg class="splash-hero-card__cloud-svg" viewBox="0 0 294 196" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
          {/* Shadow layer (darker, behind) – Figma secondary layer */}
          <path class="splash-hero-card__cloud-shadow" d="M220 120c0-22-18-40-40-40-12 0-23 5-30 14-8-8-20-14-33-14-25 0-45 20-45 45v77h158V120z" fill="#8b8dc9" opacity="0.6" />
          {/* Main cloud: rounded bumps on top, flat bottom, black outline */}
          <path class="splash-hero-card__cloud-main" d="M45 96c0-18 14-32 32-32 8 0 15 3 21 8 5-12 17-20 30-20 20 0 36 16 36 36 0 4-1 8-2 11 12 5 20 17 20 31v44H25V96c0-6 2-12 5-16 4-10 11-18 20-24 2 0 0-4 0-4z" fill="#b0b3f1" stroke="#15151e" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
  )}
  {variant === "local" && (
    <div class="splash-hero-card__illustration splash-hero-card__illustration--database" aria-hidden="true">
      {/* Figma 3513:12537 – database icon (stacked cylinders), 3513:12525/12526 as parts */}
      <svg class="splash-hero-card__illustration-svg" viewBox="0 0 226 258" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <ellipse cx="113" cy="33" rx="111" ry="33" stroke="#15151e" stroke-width="1.5" fill="#feffef" />
        <ellipse cx="113" cy="99" rx="111" ry="33" stroke="#15151e" stroke-width="1.5" fill="#feffef" />
        <ellipse cx="113" cy="165" rx="111" ry="33" stroke="#15151e" stroke-width="1.5" fill="#feffef" />
        <path d="M2 33v66M224 33v66M2 99v66M224 99v66M2 165v66M224 165v66" stroke="#15151e" stroke-width="1.5" fill="none" />
      </svg>
    </div>
  )}
  <div class="splash-hero-card__inner">
    <div class="splash-hero-card__content">
      <h2 class="splash-hero-card__title">{title}</h2>
      <p class="splash-hero-card__description">{description}</p>
    </div>
    <span class="splash-hero-card__cta">
      <span class="splash-hero-card__cta-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="splash-hero-card__cta-label">{ctaText}</span>
    </span>
  </div>
</a>
