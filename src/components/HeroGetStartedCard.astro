---
/**
 * HeroGetStartedCard – Figma 3513:11069 (Cloud) and 3513:11798 (Install locally).
 * Three-column hero cards: border black, 16px radius, 50px padding, 4px 4px 0 black shadow.
 * Variant backgrounds: cloud #f2f0ff, enterprise #ffefea, local #feffef. CTA: black icon
 * box + label, 16px SemiBold.
 *
 * Each variant pairs a light and a dark illustration. Both are rendered; page-splash.css
 * shows one and hides the other based on the active theme. The illustration is a single
 * object on transparent ground, anchored bottom right over the card's tint and noise.
 */
import { Image } from 'astro:assets';
import cloudLight from '../assets/images/hero-cloud/cloud.png';
import cloudDark from '../assets/images/hero-cloud/cloud-dark.png';
import enterpriseLight from '../assets/images/hero-enterprise/enterprise.png';
import enterpriseDark from '../assets/images/hero-enterprise/enterprise-dark.png';
import timescaledbLight from '../assets/images/hero-local/timescaledb.png';
import timescaledbDark from '../assets/images/hero-local/timescaledb-dark.png';

export interface Props {
  /** "cloud" = lavender card, "enterprise" = peach card, "local" = cream card. */
  variant: "cloud" | "local" | "enterprise";
  /** Card heading (e.g. "Get started with Cloud"). */
  title: string;
  /** Short description under the title. */
  description: string;
  /** CTA label (e.g. "Start with Cloud"). */
  ctaText: string;
  /** Link URL for the CTA. */
  href: string;
}

const { variant, title, description, ctaText, href } = Astro.props;

const variants = {
  cloud: {
    className: "splash-hero-card--cloud",
    light: cloudLight,
    dark: cloudDark,
  },
  enterprise: {
    className: "splash-hero-card--enterprise",
    light: enterpriseLight,
    dark: enterpriseDark,
  },
  local: {
    className: "splash-hero-card--local",
    light: timescaledbLight,
    dark: timescaledbDark,
  },
} as const;

const { className: variantClass, light: bgImage, dark: bgImageDark } = variants[variant];
const isExternal = href.startsWith("http");
---

<a
  class={`splash-hero-card ${variantClass}`}
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  <div class="splash-hero-card__bg" aria-hidden="true" />
  <Image
    class="splash-hero-card__bg-img splash-hero-card__bg-img--light"
    src={bgImage}
    alt=""
    aria-hidden="true"
  />
  <Image
    class="splash-hero-card__bg-img splash-hero-card__bg-img--dark"
    src={bgImageDark}
    alt=""
    aria-hidden="true"
  />
  <div class="splash-hero-card__inner">
    <div class="splash-hero-card__content">
      <h2 class="splash-hero-card__title">{title}</h2>
      <p class="splash-hero-card__description">{description}</p>
    </div>
    <span class="splash-hero-card__cta">
      <span class="splash-hero-card__cta-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="splash-hero-card__cta-label">{ctaText}</span>
    </span>
  </div>
</a>
