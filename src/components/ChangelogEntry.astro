---
/**
 * ChangelogEntry Component
 *
 * A wrapper component for changelog entries that provides:
 * - Visual card styling with clear separation
 * - Structured date display
 * - Anchor ID generation for deep linking (via the heading slot)
 * - Data attributes for filtering/sorting
 *
 * The heading slot lets the MDX pass an <h2> so it appears in the page TOC
 * while still being rendered inside the card for the best look.
 *
 * Usage:
 * <ChangelogEntry title="Feature Name" date="2026-02-11" tags={["new-feature"]}>
 *   <h2 id="feature-name" slot="heading" class="changelog-entry__title">Feature Name</h2>
 *   Content here...
 * </ChangelogEntry>
 */

import ChangelogTag from './ChangelogTag.astro';

interface Props {
  title: string;
  date: string; // ISO format: YYYY-MM-DD
  tags: Array<
    | 'new-feature'
    | 'improvement' 
    | 'performance'
    | 'security'
    | 'integration'
    | 'region'
    | 'deprecation'
    | 'bug-fix'
    | 'breaking-change'
    | 'beta'
    | 'ga'
  >;
}

const { title, date, tags } = Astro.props;

// Generate URL-friendly ID from title
const id = title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '');

// Parse the YYYY-MM-DD date string as a UTC date to avoid timezone shifts
const [year, month, day] = date.split('-').map(Number);
const utcDate = new Date(Date.UTC(year, month - 1, day));

// Format date for display in a timezone-stable way (UTC)
const displayDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(utcDate);

// Use the original ISO date string for sorting / attributes
const isoDate = date;
---

<article
  id={id}
  class="changelog-entry"
  data-date={isoDate}
  data-tags={tags.join(',')}
>
  <header class="changelog-entry__header">
    <div class="changelog-entry__meta">
      <time class="changelog-entry__date" datetime={isoDate}>
        {displayDate}
      </time>
      <div class="changelog-entry__tags">
        {tags.map((tag) => <ChangelogTag type={tag} />)}
      </div>
    </div>
    <div class="changelog-entry__heading">
      <slot name="heading" />
      <a href={`#${id}`} class="changelog-entry__anchor" aria-label={`Link to ${title}`}>
        <span class="changelog-entry__anchor-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24"><path fill="currentcolor" d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z"></path></svg>
        </span>
      </a>
    </div>
  </header>
  
  <div class="changelog-entry__content">
    <slot />
  </div>
</article>

<style>
  .changelog-entry {
    --entry-border-color: light-dark(#e5e7eb, #374151);
    --entry-bg: light-dark(#ffffff, #111827);
    --entry-hover-bg: light-dark(#f9fafb, #1f2937);
    
    position: relative;
    padding: 0.25rem 1.5rem 1.5rem 1.5rem;
    margin-bottom: 2rem;
    background: var(--entry-bg);
    border: 1px solid var(--entry-border-color);
    border-radius: 12px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .changelog-entry:hover {
    border-color: light-dark(#d1d5db, #4b5563);
    box-shadow: 0 4px 12px light-dark(rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.3));
  }

  .changelog-entry:target {
    border-color: light-dark(#6446fb, #f5ff80);
    box-shadow: 0 0 0 3px light-dark(rgba(100, 70, 251, 0.1), rgba(245, 255, 128, 0.1));
  }

  .changelog-entry__header {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--entry-border-color);
  }

  /*
   * Changelog page only: pin the card header under the sticky filter while this article is on screen.
   * --changelog-scroll-margin-top is set by ChangelogFilter (filter bottom + gap); same basis as h2 scroll-margin.
   * Controlled by --changelog-sticky-position (set in theme.css); change to `sticky` to re-enable.
   */
  :global(.page:has(#changelog-filter)) .changelog-entry__header {
    position: var(--changelog-sticky-position, sticky);
    top: var(
      --changelog-sticky-top,
      var(
        --changelog-scroll-margin-top,
        calc(var(--stl-nav-height, 3.5rem) + env(safe-area-inset-top, 0px) + 11rem)
      )
    );
    z-index: 2;
    background: var(--entry-bg);
    /* Match the card radius where the header meets the top edge of the article box */
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    /* Full-width strip inside the card while content scrolls beneath */
    margin-left: -1.5rem;
    margin-right: -1.5rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-top: 0.125rem;
    margin-top: -0.25rem;
  }

  /* Meta row: all items same height, aligned to top so date and tag sit on one line */
  .changelog-entry__meta {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 1.75rem;
  }

  .changelog-entry__date {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: light-dark(#6b7280, #9ca3af);
  }

  /* Tags wrapper: exact same height as date, top-aligned */
  .changelog-entry__tags {
    box-sizing: border-box;
    height: 1.75rem;
    min-height: 1.75rem;
    max-height: 1.75rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
  }

  /* Force tag pill to match row height; overrides ChangelogTag so date and tag align */
  .changelog-entry__meta :global(.changelog-tag) {
    margin: 0 !important;
    height: 1.75rem !important;
    min-height: 1.75rem !important;
    box-sizing: border-box !important;
  }

  /* Title row: heading text followed by the hover-reveal chain-link anchor,
     matching the heading anchor affordance on every other docs page. */
  /* Flex row (nowrap) keeps the anchor beside the title instead of wrapping to
     its own line; align-items: baseline pins the icon to the title's
     first-line baseline, so it stays put whether the title is one line or
     wraps to two. */
  .changelog-entry__heading {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-bottom: 0.375rem;
  }

  .changelog-entry__anchor {
    /* Hidden until the title row is hovered/focused, then the icon pops up. */
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    opacity: 0;
    color: light-dark(#9ca3af, #6b7280);
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .changelog-entry__anchor-icon {
    display: inline-flex;
    line-height: 0;
  }

  .changelog-entry__anchor-icon > svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Reveal AND turn accent purple whenever the whole title row is hovered
     (not just the icon) or the link is focused, matching other pages. */
  .changelog-entry__heading:hover .changelog-entry__anchor,
  .changelog-entry__anchor:focus-visible {
    opacity: 1;
    color: light-dark(#6446fb, #f5ff80);
  }

  .changelog-entry__anchor:focus-visible {
    outline: 2px solid light-dark(#6446fb, #f5ff80);
    outline-offset: 2px;
  }

  .changelog-entry__title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    color: light-dark(#111827, #f9fafb);
    scroll-margin-top: var(
      --changelog-scroll-margin-top,
      calc(var(--stl-nav-height, 3.5rem) + env(safe-area-inset-top, 0px) + 11rem)
    );
  }

  .changelog-entry__content {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: light-dark(#374151, #d1d5db);
  }

  /* Keep scrolling body text under the sticky header (header has z-index: 2 on changelog pages). */
  :global(.page:has(#changelog-filter)) .changelog-entry__content {
    position: relative;
    z-index: 0;
  }

  .changelog-entry__content :global(p) {
    margin: 0 0 0.0625rem 0 !important;
  }

  .changelog-entry__content :global(p:first-child) {
    margin-top: 0 !important;
  }

  .changelog-entry__content :global(p:last-child) {
    margin-bottom: 0 !important;
  }

  /* Tighten spacing on Starlight heading wrappers (they add extra margin by default) */
  .changelog-entry__content :global(.sl-heading-wrapper) {
    margin-top: 0.125rem !important;
    margin-bottom: 0 !important;
  }

  .changelog-entry__content :global(.sl-heading-wrapper:first-child) {
    margin-top: 0 !important;
  }

  /* Match content H2s to header title (changelog-entry__title) */
  .changelog-entry__content :global(h2),
  .changelog-entry__content :global(h2:first-child) {
    font-size: 1.375rem !important;
    font-weight: 600 !important;
    line-height: 1.25 !important;
    margin: 0 0 0.25rem 0 !important;
    color: light-dark(#111827, #f9fafb) !important;
  }

  .changelog-entry__content :global(h3),
  .changelog-entry__content :global(h3:first-child) {
    font-size: 1rem !important;
    font-weight: 600 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    color: light-dark(#1f2937, #e5e7eb) !important;
    line-height: 1.4 !important;
  }

  .changelog-entry__content :global(h2 a.anchor),
  .changelog-entry__content :global(h3 a.anchor) {
    display: inline-block !important;
    margin-left: 0.375rem !important;
    vertical-align: middle !important;
    line-height: 1 !important;
  }

  .changelog-entry__content :global(h2:first-child),
  .changelog-entry__content :global(h3:first-child) {
    margin-top: 0 !important;
  }

  .changelog-entry__content :global(ul),
  .changelog-entry__content :global(ol) {
    margin: 0.375rem 0;
    padding-left: 1.5rem;
  }

  .changelog-entry__content :global(li) {
    margin-bottom: 0.125rem;
  }

  .changelog-entry__content :global(a) {
    color: light-dark(#6446fb, #f5ff80);
    text-decoration: none;
  }

  .changelog-entry__content :global(a:hover) {
    text-decoration: underline;
  }

  .changelog-entry__content :global(strong) {
    font-weight: 600;
    color: light-dark(#1f2937, #f3f4f6);
  }

  .changelog-entry__content :global(code) {
    font-size: 0.875em;
    padding: 0.125em 0.375em;
    background: light-dark(#f3f4f6, #1f2937);
    border-radius: 4px;
  }

  /* Hide entry when filtered out */
  .changelog-entry[data-hidden="true"] {
    display: none;
  }
</style>
