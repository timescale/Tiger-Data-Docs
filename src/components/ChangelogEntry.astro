---
/**
 * ChangelogEntry Component
 *
 * A wrapper component for changelog entries that provides:
 * - Visual card styling with clear separation
 * - Structured date display
 * - Anchor ID generation for deep linking (via the heading slot)
 * - Data attributes for filtering/sorting
 *
 * The heading slot lets the MDX pass an <h2> so it appears in the page TOC
 * while still being rendered inside the card for the best look.
 *
 * Usage:
 * <ChangelogEntry title="Feature Name" date="2026-02-11" tags={["new-feature"]}>
 *   <h2 id="feature-name" slot="heading" class="changelog-entry__title">Feature Name</h2>
 *   Content here...
 * </ChangelogEntry>
 */

import ChangelogTag from './ChangelogTag.astro';

interface Props {
  title: string;
  date: string; // ISO format: YYYY-MM-DD
  tags: Array<
    | 'new-feature'
    | 'improvement' 
    | 'performance'
    | 'security'
    | 'integration'
    | 'region'
    | 'deprecation'
    | 'bug-fix'
    | 'breaking-change'
    | 'beta'
    | 'ga'
  >;
}

const { title, date, tags } = Astro.props;

// Generate URL-friendly ID from title
const id = title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '');

// Parse the YYYY-MM-DD date string as a UTC date to avoid timezone shifts
const [year, month, day] = date.split('-').map(Number);
const utcDate = new Date(Date.UTC(year, month - 1, day));

// Format date for display in a timezone-stable way (UTC)
const displayDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(utcDate);

// Use the original ISO date string for sorting / attributes
const isoDate = date;
---

<article
  class="changelog-entry"
  data-date={isoDate}
  data-tags={tags.join(',')}
>
  <header class="changelog-entry__header">
    <div class="changelog-entry__meta">
      <time class="changelog-entry__date" datetime={isoDate}>
        {displayDate}
      </time>
      <div class="changelog-entry__tags">
        {tags.map((tag) => <ChangelogTag type={tag} />)}
      </div>
      <a href={`#${id}`} class="changelog-entry__anchor" aria-label={`Link to ${title}`}>
        #
      </a>
    </div>
    <slot name="heading" />
  </header>
  
  <div class="changelog-entry__content">
    <slot />
  </div>
</article>

<style>
  .changelog-entry {
    --entry-border-color: light-dark(#e5e7eb, #374151);
    --entry-bg: light-dark(#ffffff, #111827);
    --entry-hover-bg: light-dark(#f9fafb, #1f2937);
    
    position: relative;
    padding: 0.375rem 1.5rem 1.5rem 1.5rem;
    margin-bottom: 2rem;
    background: var(--entry-bg);
    border: 1px solid var(--entry-border-color);
    border-radius: 12px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .changelog-entry:hover {
    border-color: light-dark(#d1d5db, #4b5563);
    box-shadow: 0 4px 12px light-dark(rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.3));
  }

  .changelog-entry:target {
    border-color: light-dark(#6446fb, #f5ff80);
    box-shadow: 0 0 0 3px light-dark(rgba(100, 70, 251, 0.1), rgba(245, 255, 128, 0.1));
  }

  .changelog-entry__header {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--entry-border-color);
  }

  /* Meta row: all items same height, aligned to top so date and tag sit on one line */
  .changelog-entry__meta {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 1.75rem;
  }

  .changelog-entry__date {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: light-dark(#6b7280, #9ca3af);
  }

  /* Tags wrapper: exact same height as date, top-aligned */
  .changelog-entry__tags {
    box-sizing: border-box;
    height: 1.75rem;
    min-height: 1.75rem;
    max-height: 1.75rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
  }

  /* Force tag pill to match row height; overrides ChangelogTag so date and tag align */
  .changelog-entry__meta :global(.changelog-tag) {
    margin: 0 !important;
    height: 1.75rem !important;
    min-height: 1.75rem !important;
    box-sizing: border-box !important;
  }

  .changelog-entry__anchor {
    opacity: 0;
    font-size: 1rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: light-dark(#9ca3af, #6b7280);
    text-decoration: none;
    transition: opacity 0.15s ease, color 0.15s ease, outline-color 0.15s ease;
  }

  .changelog-entry:hover .changelog-entry__anchor {
    opacity: 1;
  }

  .changelog-entry__anchor:hover,
  .changelog-entry__anchor:focus,
  .changelog-entry__anchor:focus-visible {
    opacity: 1;
    color: light-dark(#6446fb, #f5ff80);
    outline: 2px solid light-dark(#6446fb, #f5ff80);
    outline-offset: 2px;
  }

  .changelog-entry__title {
    margin: 0 0 0.5rem 0;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    color: light-dark(#111827, #f9fafb);
    scroll-margin-top: var(
      --changelog-scroll-margin-top,
      calc(var(--stl-nav-height, 3.5rem) + env(safe-area-inset-top, 0px) + 11rem)
    );
  }

  .changelog-entry__content {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: light-dark(#374151, #d1d5db);
  }

  .changelog-entry__content :global(p) {
    margin: 0 0 0.0625rem 0 !important;
  }

  .changelog-entry__content :global(p:first-child) {
    margin-top: 0 !important;
  }

  .changelog-entry__content :global(p:last-child) {
    margin-bottom: 0 !important;
  }

  /* Tighten spacing on Starlight heading wrappers (they add extra margin by default) */
  .changelog-entry__content :global(.sl-heading-wrapper) {
    margin-top: 0.125rem !important;
    margin-bottom: 0 !important;
  }

  .changelog-entry__content :global(.sl-heading-wrapper:first-child) {
    margin-top: 0 !important;
  }

  /* Match content H2s to header title (changelog-entry__title) */
  .changelog-entry__content :global(h2),
  .changelog-entry__content :global(h2:first-child) {
    font-size: 1.375rem !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    margin: 0 0 0.25rem 0 !important;
    color: light-dark(#111827, #f9fafb) !important;
  }

  .changelog-entry__content :global(h3),
  .changelog-entry__content :global(h3:first-child) {
    font-size: 1rem !important;
    font-weight: 600 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    color: light-dark(#1f2937, #e5e7eb) !important;
    line-height: 1.4 !important;
  }

  .changelog-entry__content :global(h2 a.anchor),
  .changelog-entry__content :global(h3 a.anchor) {
    display: inline-block !important;
    margin-left: 0.375rem !important;
    vertical-align: middle !important;
    line-height: 1 !important;
  }

  .changelog-entry__content :global(h2:first-child),
  .changelog-entry__content :global(h3:first-child) {
    margin-top: 0 !important;
  }

  .changelog-entry__content :global(ul),
  .changelog-entry__content :global(ol) {
    margin: 0.375rem 0;
    padding-left: 1.5rem;
  }

  .changelog-entry__content :global(li) {
    margin-bottom: 0.125rem;
  }

  .changelog-entry__content :global(a) {
    color: light-dark(#6446fb, #f5ff80);
    text-decoration: none;
  }

  .changelog-entry__content :global(a:hover) {
    text-decoration: underline;
  }

  .changelog-entry__content :global(strong) {
    font-weight: 600;
    color: light-dark(#1f2937, #f3f4f6);
  }

  .changelog-entry__content :global(code) {
    font-size: 0.875em;
    padding: 0.125em 0.375em;
    background: light-dark(#f3f4f6, #1f2937);
    border-radius: 4px;
  }

  /* Hide entry when filtered out */
  .changelog-entry[data-hidden="true"] {
    display: none;
  }
</style>
