---
import { Badge } from '@stainless-api/docs/components';
import { TagIcon } from 'lucide-react';

export type Props = {
  version: string;
  product: 'tsdb' | 'toolkit';
}

const releasePages = {
  tsdb: 'https://github.com/timescale/timescaledb/releases/tag/',
  toolkit: 'https://github.com/timescale/timescaledb-toolkit/releases/tag/',
} satisfies Record<Props['product'], `http${string}/releases/tag/`>;

const url = new URL(Astro.props.version, releasePages[Astro.props.product]).href;
---

<Badge intent="accent" size="md">
  <TagIcon slot="icon" />
  Since <a href={url} target="_blank" rel="noopener noreferrer">{Astro.props.version}</a>
</Badge>
