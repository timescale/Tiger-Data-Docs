---
/**
 * Wraps Stainless/Starlight Head and injects `<meta name="description">` / `og:description`
 * from `seoDescription` when set. Use `seoDescription` for copy that should appear in search
 * and social previews but not in the sidebar (the sidebar uses `description` from frontmatter).
 *
 * If both `description` and `seoDescription` are set, Starlight keeps using `description` for
 * default meta/sidebar; we do not inject from `seoDescription` (description wins).
 */
import DefaultHead from "@stainless-api/docs/components/Head";
import ImageZoom from "./ImageZoom.astro";

type DocsEntryData = {
  description?: string;
  seoDescription?: string;
};

const data = Astro.locals.starlightRoute?.entry?.data as DocsEntryData | undefined;
const seo = data?.seoDescription?.trim();
const hasDescription = Boolean(data?.description?.trim());
/** SEO-only meta when there is no `description`; otherwise Starlight + sidebar use `description`. */
const showSeoMeta = Boolean(seo) && !hasDescription;
---

<DefaultHead />
{
  showSeoMeta ? (
    <>
      <meta name="description" content={seo} />
      <meta property="og:description" content={seo} />
    </>
  ) : null
}

<ImageZoom />

<script is:inline>
  /**
   * Open off-site http(s) links in a new tab (no rehype plugin; same-origin stays same tab).
   * Runs after DOM is available. Covers prose links and React-rendered anchors (for example Card).
   * Opt out: data-same-tab on the anchor, or target="_self".
   */
  (function () {
    function hostnameKey(host) {
      return host.replace(/^www\./, "").toLowerCase();
    }
    function externalizeAnchors() {
      var origin = window.location.origin;
      var siteHost = hostnameKey(window.location.hostname);
      document.querySelectorAll("a[href]").forEach(function (a) {
        if (a.hasAttribute("data-same-tab")) return;
        if (a.getAttribute("target") === "_self") return;
        var href = a.getAttribute("href");
        if (!href || href.startsWith("#")) return;
        if (/^(mailto:|tel:|javascript:)/i.test(href)) return;
        if (href.startsWith("/") && !href.startsWith("//")) return;
        try {
          var u = new URL(href, origin);
          if (u.protocol !== "http:" && u.protocol !== "https:") return;
          if (hostnameKey(u.hostname) === siteHost) return;
          if (a.getAttribute("target") !== "_blank") {
            a.setAttribute("target", "_blank");
            a.setAttribute("rel", "noopener noreferrer");
          }
        } catch (_) {}
      });
    }
    function run() {
      externalizeAnchors();
      setTimeout(externalizeAnchors, 0);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
    document.addEventListener("astro:page-load", run);
    window.addEventListener("load", function once() {
      externalizeAnchors();
      window.removeEventListener("load", once);
    });
  })();
</script>

<script is:inline>
  /**
   * Deep-link to Starlight `<Tabs>` panels via `#tab=<label-slug>`. Starlight's TabItem
   * IDs are autogenerated (tab-panel-0, tab-panel-1...) and not addressable, so the URL
   * uses the slugified tab label instead. On load (and on hashchange / astro:page-load)
   * we synthesize a click on every matching tab — Starlight's own click handler then
   * switches its panel. On user tab clicks we replace the URL hash so the current
   * selection is shareable.
   */
  (function () {
    function slugify(s) {
      return (s || "")
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }
    function activateTab(target, scroll) {
      // Build the ancestor chain: target tab, then every enclosing tabpanel's tab.
      // Activate outermost first so each inner tablist is visible (and has a real
      // bounding rect for Starlight's scroll-preservation) before we click into it.
      var chain = [];
      var cur = target;
      while (cur) {
        chain.push(cur);
        var panel = cur.closest('[role="tabpanel"]');
        if (!panel) break;
        var owner = panel.getAttribute("aria-labelledby");
        if (!owner) break;
        cur = document.getElementById(owner);
      }
      for (var i = chain.length - 1; i >= 0; i--) {
        if (chain[i].getAttribute("aria-selected") !== "true") chain[i].click();
      }
      // Starlight's switchTab calls .focus() on every clicked tab. For URL-driven
      // activation the user didn't keyboard-focus anything, and :focus-visible treats
      // programmatic focus as keyboard-like, leaving a visible ring. Blur to undo.
      requestAnimationFrame(function () {
        var el = document.activeElement;
        if (el && el.getAttribute && el.getAttribute("role") === "tab") el.blur();
      });
      // The browser doesn't fragment-scroll for `#tab=…` (no element has that id),
      // and Starlight's switchTab deliberately preserves scroll. So for URL-driven
      // activation we scroll the outermost tablist into view ourselves, offset by
      // the sticky header height.
      if (scroll) {
        var outer = chain[chain.length - 1];
        var tabs = outer.closest("starlight-tabs") || outer;
        requestAnimationFrame(function () {
          // Measure the actual rendered header rather than parsing --sl-nav-height:
          // that variable is `5.75rem` desktop / `56px` mobile, and parseFloat
          // silently drops the unit, so we'd compute wildly wrong offsets if we
          // tried to convert rem->px uniformly.
          var header = document.querySelector("header");
          var offset = header ? header.getBoundingClientRect().height : 0;
          var top = tabs.getBoundingClientRect().top + window.scrollY - offset - 16;
          window.scrollTo({ top: top, behavior: "auto" });
        });
      }
    }
    function activateFromHash() {
      var hash = decodeURIComponent(location.hash.slice(1));
      if (hash.indexOf("tab=") !== 0) return;
      var slug = hash.slice(4);
      if (!slug) return;
      var tabs = document.querySelectorAll('starlight-tabs [role="tab"]');
      tabs.forEach(function (t) {
        if (slugify(t.textContent) === slug) activateTab(t, true);
      });
    }
    function onTabClick(e) {
      var t = e.target && e.target.closest ? e.target.closest('starlight-tabs [role="tab"]') : null;
      if (!t) return;
      var slug = slugify(t.textContent);
      if (!slug) return;
      history.replaceState(null, "", "#tab=" + slug);
    }
    function run() {
      activateFromHash();
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
    document.addEventListener("astro:page-load", run);
    window.addEventListener("hashchange", activateFromHash);
    document.addEventListener("click", onTabClick);
  })();
</script>

<script is:inline>
  /**
   * Wrap any heading rendered from an imported `_partial.mdx` file with the `.sl-heading-wrapper`
   * + `.sl-anchor-link` markup that Starlight's `rehype-autolink-headings` plugin produces. That
   * plugin only runs on files inside the docs collection path, so headings inside partials
   * (which are compiled as separate MDX modules outside that path) come out bare — no hover
   * link icon, no shareable anchor. We mirror the plugin's HTML at runtime so partial headings
   * are indistinguishable from authored-in-page ones.
   *
   * Like the TOC augmentation below, this works for conditionally-rendered headings too — React
   * resolves the conditional before this runs, so we only wrap what's actually on the page.
   */
  (function () {
    var ANCHOR_PATH =
      "m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z";
    function wrapHeading(h) {
      if (!h.id) return;
      if (h.id === "_top" || h.id.indexOf("starlight__") === 0) return;
      // Already wrapped (own-page heading processed by Starlight's rehype plugin)?
      if (h.parentElement && h.parentElement.classList.contains("sl-heading-wrapper")) return;

      var level = h.tagName.toLowerCase();
      var wrapper = document.createElement("div");
      wrapper.className = "sl-heading-wrapper level-" + level;

      var anchor = document.createElement("a");
      anchor.className = "sl-anchor-link";
      anchor.href = "#" + h.id;

      var iconSpan = document.createElement("span");
      iconSpan.setAttribute("aria-hidden", "true");
      iconSpan.className = "sl-anchor-icon";
      iconSpan.innerHTML =
        '<svg width="16" height="16" viewBox="0 0 24 24"><path fill="currentcolor" d="' +
        ANCHOR_PATH +
        '"></path></svg>';

      var srSpan = document.createElement("span");
      srSpan.className = "sr-only";
      srSpan.setAttribute("data-pagefind-ignore", "true");
      // Match Starlight's `heading.anchorLabel` translation so screen-reader output is
      // identical to own-page headings (curly quotes, same phrasing).
      srSpan.textContent = "Section titled “" + (h.textContent || "").trim() + "”";

      anchor.appendChild(iconSpan);
      anchor.appendChild(srSpan);

      // Insert wrapper before the heading, then move heading + anchor inside it.
      h.parentNode.insertBefore(wrapper, h);
      wrapper.appendChild(h);
      wrapper.appendChild(anchor);
    }
    function run() {
      var headings = document.querySelectorAll("main h2[id], main h3[id]");
      for (var i = 0; i < headings.length; i++) wrapHeading(headings[i]);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
    document.addEventListener("astro:page-load", run);
  })();
</script>

<script is:inline>
  /**
   * Augment the right-rail "On this page" TOC with headings supplied by imported `_partial.mdx`
   * files. Starlight builds its TOC from the parent MDX's mdast, which only contains the
   * `<Partial />` JSX call — not the partial's `## ...` headings. Those headings DO render to
   * the DOM with valid IDs (each partial is compiled as its own MDX file with rehype-slug
   * applied), so we rebuild the TOC list from `main h2[id], main h3[id]` at runtime.
   *
   * This also picks up headings inside conditional JSX (`{cond && <Foo />}`) — by the time we
   * run, React has already evaluated the condition, so the DOM reflects what's actually on
   * the page.
   *
   * We must mutate the `<ul>` before `<starlight-toc>`'s `init()` (scheduled via
   * `requestIdleCallback`) captures its link list. Running on DOMContentLoaded / astro:page-load
   * lands us well before the idle callback fires.
   */
  (function () {
    function getScopedClass(list) {
      var sample = list.querySelector("li, a, ul");
      return sample ? sample.className : "";
    }
    function makeEl(tag, scopedClass, depth) {
      var el = document.createElement(tag);
      if (scopedClass) el.className = scopedClass;
      el.style.setProperty("--depth", depth);
      return el;
    }
    function makeEntry(scopedClass, href, text, depth) {
      var li = makeEl("li", scopedClass, depth);
      var a = makeEl("a", scopedClass, depth);
      var span = makeEl("span", scopedClass, depth);
      a.href = href;
      span.textContent = text;
      a.appendChild(span);
      li.appendChild(a);
      return li;
    }
    function makeSublist(scopedClass, isMobile, depth) {
      var ul = document.createElement("ul");
      var cls = scopedClass || "";
      if (isMobile) cls = (cls + " isMobile").trim();
      if (cls) ul.className = cls;
      ul.style.setProperty("--depth", depth);
      return ul;
    }
    function rebuildList(list, isMobile) {
      if (!list) return;
      // Inactive Starlight tab panels carry `role="tabpanel" hidden`; their headings
      // exist in the DOM but aren't visible, so exclude them from the TOC.
      var headings = Array.from(document.querySelectorAll("main h2[id], main h3[id]")).filter(
        function (h) {
          if (!h.id || h.id === "_top" || h.id.indexOf("starlight__") === 0) return false;
          if (h.closest('[role="tabpanel"][hidden]')) return false;
          return true;
        },
      );
      if (headings.length === 0) return;

      // Group H3s under their preceding H2 so they nest correctly.
      var groups = [];
      var current = null;
      headings.forEach(function (h) {
        if (h.tagName === "H2" || !current) {
          current = { h: h, children: [] };
          groups.push(current);
        } else {
          current.children.push(h);
        }
      });

      var scopedClass = getScopedClass(list);
      // Preserve the "Overview" (#_top) entry if Starlight rendered one.
      var overview = list.querySelector('a[href="#_top"]');
      var overviewLi = overview ? overview.closest("li") : null;
      list.innerHTML = "";
      if (overviewLi) list.appendChild(overviewLi);

      groups.forEach(function (g) {
        var text = g.h.textContent ? g.h.textContent.trim() : "";
        var li = makeEntry(scopedClass, "#" + g.h.id, text, 0);
        if (g.children.length > 0) {
          var sub = makeSublist(scopedClass, isMobile, 1);
          g.children.forEach(function (h3) {
            var childText = h3.textContent ? h3.textContent.trim() : "";
            sub.appendChild(makeEntry(scopedClass, "#" + h3.id, childText, 1));
          });
          li.appendChild(sub);
        }
        list.appendChild(li);
      });
    }
    function run() {
      rebuildList(document.querySelector("starlight-toc nav > ul"), false);
      rebuildList(document.querySelector("mobile-starlight-toc ul"), true);
    }
    function onTabClick(e) {
      // Rebuild on tab change so the TOC tracks the active tab's headings only.
      // Defer one frame so Starlight has finished toggling `hidden` on the panels.
      // Hash-driven activation also flows through here (the tab script dispatches a
      // real click), so we don't need a separate `hashchange` listener.
      var t = e.target && e.target.closest ? e.target.closest('starlight-tabs [role="tab"]') : null;
      if (!t) return;
      requestAnimationFrame(run);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
    document.addEventListener("astro:page-load", run);
    document.addEventListener("click", onTabClick);
  })();
</script>

<script is:inline>
  /**
   * Back/forward cache (bfcache): the document can be restored without re-running scripts or
   * reconnecting custom elements, leaving body[data-mobile-menu-expanded] out of sync with the UI.
   */
  (function () {
    function resetMobileDrawerState() {
      if (window.matchMedia("(min-width: 50rem)").matches) return;
      document.body.removeAttribute("data-mobile-menu-expanded");
      document.querySelectorAll("starlight-menu-button").forEach(function (el) {
        el.setAttribute("aria-expanded", "false");
      });
    }
    window.addEventListener("pageshow", function (e) {
      if (e.persisted) resetMobileDrawerState();
    });
    document.addEventListener("astro:page-load", resetMobileDrawerState);
  })();
</script>

