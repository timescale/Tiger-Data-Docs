---
/**
 * A topic page of the Tiger Cloud REST reference: every endpoint of one
 * resource, drawn with Stainless's endpoint renderer. Topics come from
 * `src/lib/rest-topics.ts`; the sidebar entries in `astro.config.ts` link to
 * the endpoint anchors on this page.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getSDKJSONInSSR } from "@stainless-api/docs/specs/fetchSpecSSR";
import { CONTENT_PANEL_LAYOUT, MIDDLEWARE } from "virtual:stl-starlight-virtual-module";
import { RenderSpec } from "@stainless-plugin/react/Routing";
import { getRestTopics, type RestTopic } from "../../../lib/rest-topics";

export function getStaticPaths() {
  return getRestTopics().map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props as { topic: RestTopic };
const spec = await getSDKJSONInSSR("http");

const resourceAt = (keys: string[]) =>
  keys.reduce((parent: any, key) => parent.subresources[key], { subresources: spec.resources });

const endpoints = topic.endpoints.map((endpoint) => {
  const method = resourceAt(endpoint.resource)?.methods?.[endpoint.method];
  if (!method) {
    throw new Error(`REST topic ${topic.slug}: ${endpoint.method} is in stainless.yml but not in the generated spec`);
  }
  return { ...endpoint, stainlessPath: method.stainlessPath as string };
});

// A resource without its own tag in the spec inherits its parent's description
// (metrics shows the services text): show a description only when it is the topic's own.
const description: string | undefined = resourceAt(topic.resource).description;
const inherited = topic.resource
  .slice(0, -1)
  .some((_, i) => resourceAt(topic.resource.slice(0, i + 1)).description === description);

Astro.locals.language = "http";
// These pages have no Markdown version, so the Copy Markdown control is not offered.
Astro.locals._stlStarlightPage = { skipRenderingStarlightTitle: false, hasMarkdownRoute: false };
---

<StarlightPage
  frontmatter={{
    title: topic.label,
    description: inherited ? undefined : description,
    widePage: true,
    pagefind: false,
    prev: false,
    next: false,
  }}
>
  <div class="not-content rest-topic">
    {
      endpoints.map((endpoint) => (
        <section id={endpoint.id} class="rest-topic-endpoint">
          <RenderSpec
            spec={spec}
            kind="http_method"
            path={endpoint.stainlessPath}
            language="http"
            currentPath={Astro.url.pathname}
            contentPanelLayout={CONTENT_PANEL_LAYOUT}
            transformRequestSnippet={MIDDLEWARE.transformRequestSnippet}
          />
        </section>
      ))
    }
  </div>
</StarlightPage>

<style is:global>
  /* The renderer draws each endpoint as a page of its own: drop its breadcrumbs
     and size its title as a section heading. */
  .rest-topic-endpoint .stl-page-nav-container {
    display: none;
  }

  .rest-topic-endpoint {
    --stl-typography-text-h1: var(--stl-typography-text-h2);
  }

  .rest-topic-endpoint + .rest-topic-endpoint {
    margin-top: var(--tiger-space-2xl);
    padding-top: var(--tiger-space-xl);
    border-top: 1px solid var(--table-border);
  }
</style>

<script>
  // Mark the sidebar entry of the endpoint in view, and close the mobile menu after a jump.
  const samePath = (a: string, b: string) => a.replace(/\/$/, "") === b.replace(/\/$/, "");

  const entries = new Map<string, HTMLAnchorElement>();
  for (const link of document.querySelectorAll<HTMLAnchorElement>("nav.sidebar a[href*='#']")) {
    const url = new URL(link.href);
    if (samePath(url.pathname, location.pathname)) entries.set(url.hash.slice(1), link);
  }
  const sections = [...document.querySelectorAll<HTMLElement>(".rest-topic-endpoint")];

  let marked = "";
  const mark = () => {
    // A jump lands a section at the page's scroll padding; the section in view is the last one at or above that line.
    const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) + 4;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    const passed = sections.filter((section) => section.getBoundingClientRect().top <= line);
    const current = (atBottom ? sections.at(-1) : passed.at(-1))?.id ?? "";
    if (current === marked) return;
    marked = current;
    for (const [id, link] of entries) {
      if (id === current) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    }
  };

  let queued = false;
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      mark();
    });
  };
  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll);
  mark();

  type MenuButton = HTMLElement & { setExpanded(expanded: boolean): void };
  for (const link of entries.values()) {
    link.addEventListener("click", () => {
      for (const button of document.querySelectorAll<MenuButton>("starlight-menu-button")) {
        button.setExpanded(false);
      }
    });
  }
</script>

<script>
  import "@stainless-plugin/globalJs/copy.ts";
  import "@stainless-plugin/globalJs/tooltip.ts";
  import "@stainless-plugin/globalJs/code-snippets.ts";
  import "@stainless-plugin/globalJs/method-descriptions.ts";
  import "@stainless-plugin/globalJs/summary-selection-tweak.ts";
</script>
